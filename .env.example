# Copy to .env and fill only the credentials used by this checkout.
# Values stay on the Host; Task Sandboxes receive an episode Gateway token and the
# variables a Task's env tables name (see docs/specs/task-authoring.md#variables).
# Every name Orbit reads for itself starts with ORBIT_, so none collides with a variable
# your own tools read, such as ANTHROPIC_BASE_URL for your Claude Code.

# One key per model provider. ORBIT_<PROVIDER>_BASE_URL is optional and defaults to the
# provider's own API; a provider's key is only ever sent to its own URL.
ORBIT_ANTHROPIC_API_KEY=
# ORBIT_ANTHROPIC_BASE_URL=https://api.anthropic.com
ORBIT_GEMINI_API_KEY=
# ORBIT_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
ORBIT_META_API_KEY=
# ORBIT_META_BASE_URL=https://api.meta.ai
ORBIT_MOONSHOT_API_KEY=
# ORBIT_MOONSHOT_BASE_URL=https://api.moonshot.ai
ORBIT_OPENAI_API_KEY=
# ORBIT_OPENAI_BASE_URL=https://api.openai.com
ORBIT_QWEN_API_KEY=
# ORBIT_QWEN_BASE_URL=https://maas.qwencloudapi.com/compatible-mode
ORBIT_XAI_API_KEY=
# ORBIT_XAI_BASE_URL=https://api.x.ai
ORBIT_ZAI_API_KEY=
# ORBIT_ZAI_BASE_URL=https://api.z.ai/api/anthropic

# Claude Code subscription setup token. See docs/guides/subscription-auth.md.
# Codex and Grok subscription logins live below gitignored .orbit/auth instead.
ORBIT_CLAUDE_CODE_OAUTH_TOKEN=

# Needed only when sandbox.providers names daytona. See docs/guides/daytona.md.
ORBIT_DAYTONA_API_KEY=

# Needed only when sandbox.providers names fleet, and by every Fleet machine.
# See docs/guides/fleet.md.
# ORBIT_FLEET_TOKEN=

# Needed only to push Task assets or pull them from a private dataset.
ORBIT_HF_TOKEN=

# Variables the selected Tasks refer to as ${NAME}, under the Tasks' own names.
# CATALOG_TOKEN=
