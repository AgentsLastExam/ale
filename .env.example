# Copy to .env and fill only the credentials used by this checkout.
# Values stay on the Host; Task Sandboxes receive an episode Gateway token.
# Every name starts with ALE_, so none collides with a variable your own tools read,
# such as ANTHROPIC_BASE_URL for your Claude Code.

# One key per model provider. ALE_<PROVIDER>_BASE_URL is optional and defaults to the
# provider's own API; a provider's key is only ever sent to its own URL.
ALE_ANTHROPIC_API_KEY=
# ALE_ANTHROPIC_BASE_URL=https://api.anthropic.com
ALE_GEMINI_API_KEY=
# ALE_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
ALE_OPENAI_API_KEY=
# ALE_OPENAI_BASE_URL=https://api.openai.com
ALE_XAI_API_KEY=
# ALE_XAI_BASE_URL=https://api.x.ai

# Claude Code subscription setup token. See docs/guides/subscription-auth.md.
# Codex and Grok subscription logins live below gitignored .ale/auth instead.
ALE_CLAUDE_CODE_OAUTH_TOKEN=

# Needed only with container.provider = "daytona". See docs/guides/daytona.md.
ALE_DAYTONA_API_KEY=

# Needed only to synchronize private Task asset datasets.
ALE_HF_TOKEN=
