{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agents-last-exam.org/schemas/validation-observation-v1.json",
  "title": "ALE Validation Observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "engine", "tasks"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "commit"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "minLength": 1}
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/task"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "rewards": {
      "type": ["object", "null"],
      "additionalProperties": {"type": "number"}
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "episode_id",
        "status",
        "rewards",
        "lock_path",
        "lock_digest",
        "result_path"
      ],
      "properties": {
        "episode_id": {"type": "string", "minLength": 1},
        "status": {
          "enum": [
            "completed",
            "agent_error",
            "env_error",
            "task_error",
            "timeout",
            "budget_exceeded",
            "cancelled",
            "refused"
          ]
        },
        "rewards": {"$ref": "#/$defs/rewards"},
        "lock_path": {"type": ["string", "null"], "minLength": 1},
        "lock_digest": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "result_path": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "lock_path": {"type": "string", "minLength": 1},
                "lock_digest": {"$ref": "#/$defs/sha256"}
              }
            },
            {
              "properties": {
                "lock_path": {"type": "null"},
                "lock_digest": {"type": "null"}
              }
            }
          ]
        },
        {
          "if": {
            "properties": {"status": {"const": "completed"}},
            "required": ["status"]
          },
          "then": {
            "properties": {
              "rewards": {"type": "object", "minProperties": 1},
              "lock_path": {"type": "string", "minLength": 1},
              "lock_digest": {"$ref": "#/$defs/sha256"}
            }
          },
          "else": {"properties": {"rewards": {"type": "null"}}}
        }
      ]
    },
    "notice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1}
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "variant",
        "spec_hash",
        "untouched",
        "oracle",
        "reward_names",
        "warnings",
        "failures",
        "passed"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "variant": {"type": "string", "minLength": 1},
        "spec_hash": {"$ref": "#/$defs/sha256"},
        "untouched": {"$ref": "#/$defs/attempt"},
        "oracle": {"$ref": "#/$defs/attempt"},
        "reward_names": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "warnings": {"type": "array", "items": {"$ref": "#/$defs/notice"}},
        "failures": {"type": "array", "items": {"$ref": "#/$defs/notice"}},
        "passed": {"type": "boolean"}
      }
    }
  }
}
