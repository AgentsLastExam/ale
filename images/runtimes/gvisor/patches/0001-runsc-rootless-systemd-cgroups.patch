+
+// systemdConn connects to the systemd manager that owns the container's
+// cgroups. That is the system manager, unless runsc runs as root of a user
+// namespace whose root is an unprivileged user on the host, as under rootless
+// Docker: the system manager then refuses to create the scope
+// ("Interactive authentication required"), so runsc uses that user's own
+// manager over the session bus, as runc does. The bus authenticates the peer
+// by its host uid, so the connection names that uid rather than the
+// namespace's 0.
+func systemdConn(ctx context.Context) (*systemdDbus.Conn, error) {
+	uid, rootless := hostUIDOfRoot()
+	if !rootless {
+		return systemdDbus.NewWithContext(ctx)
+	}
+	address, err := userBusAddress(uid)
+	if err != nil {
+		return nil, err
+	}
+	return systemdDbus.NewConnection(func() (*dbus.Conn, error) {
+		conn, err := dbus.Dial(address, dbus.WithContext(ctx))
+		if err != nil {
+			return nil, fmt.Errorf("dialing the user's session bus %q: %w", address, err)
+		}
+		if err := conn.Auth([]dbus.Auth{dbus.AuthExternal(strconv.Itoa(uid))}); err != nil {
+			conn.Close()
+			return nil, fmt.Errorf("authenticating to the user's session bus as uid %d: %w", uid, err)
+		}
+		if err := conn.Hello(); err != nil {
+			conn.Close()
+			return nil, err
+		}
+		return conn, nil
+	})
+}
+
+// hostUIDOfRoot returns the uid that the calling process's effective uid maps
+// to in the parent user namespace, and whether that is an unprivileged user,
+// i.e. whether runsc runs rootless under a user namespace.
+func hostUIDOfRoot() (int, bool) {
+	data, err := os.ReadFile("/proc/self/uid_map")
+	if err != nil {
+		return 0, false
+	}
+	euid := uint64(os.Geteuid())
+	for _, line := range strings.Split(strings.TrimSpace(string(data)), "\n") {
+		fields := strings.Fields(line)
+		if len(fields) != 3 {
+			continue
+		}
+		inside, err1 := strconv.ParseUint(fields[0], 10, 32)
+		outside, err2 := strconv.ParseUint(fields[1], 10, 32)
+		length, err3 := strconv.ParseUint(fields[2], 10, 32)
+		if err1 != nil || err2 != nil || err3 != nil {
+			continue
+		}
+		if euid >= inside && euid < inside+length {
+			host := outside + (euid - inside)
+			return int(host), host != 0
+		}
+	}
+	return 0, false
+}
+
+// userBusAddress returns the address of the session bus of the user with
+// the given host uid.
+func userBusAddress(uid int) (string, error) {
+	if address := os.Getenv("DBUS_SESSION_BUS_ADDRESS"); address != "" {
+		return address, nil
+	}
+	candidates := []string{fmt.Sprintf("/run/user/%d/bus", uid)}
+	if dir := os.Getenv("XDG_RUNTIME_DIR"); dir != "" {
+		candidates = append([]string{filepath.Join(dir, "bus")}, candidates...)
+	}
+	for _, path := range candidates {
+		if fi, err := os.Stat(path); err == nil && fi.Mode()&os.ModeSocket != 0 {
+			return "unix:path=" + path, nil
+		}
+	}
+	return "", fmt.Errorf("rootless systemd cgroups need the session bus of uid %d: none of %v is a socket; set DBUS_SESSION_BUS_ADDRESS", uid, candidates)
+}
+
+// managerControlGroup returns the cgroup of the manager conn talks to,
+// relative to the unified mountpoint.
+func managerControlGroup(conn *systemdDbus.Conn) (string, error) {
+	value, err := conn.GetManagerProperty("ControlGroup")
+	if err != nil {
+		return "", fmt.Errorf("reading the systemd manager's ControlGroup: %w", err)
+	}
+	if unquoted, err := strconv.Unquote(value); err == nil {
+		value = unquoted
+	}
+	if !strings.HasPrefix(value, "/") {
+		return "", fmt.Errorf("unexpected systemd manager ControlGroup %q", value)
+	}
+	return value, nil
+}
+
+// createCgroupPaths is cgroupV2's, started at the manager's own cgroup when
+// the scope belongs to a user's manager: the cgroups above it belong to the
+// system manager and are not the user's to write, and systemd has already
+// enabled the delegated controllers down to it.
+func (c *cgroupSystemd) createCgroupPaths() (bool, error) {
+	if c.ManagerRoot == "" {
+		return c.cgroupV2.createCgroupPaths()
+	}
+	rel, err := filepath.Rel(c.ManagerRoot, c.Path)
+	if err != nil || rel == ".." || strings.HasPrefix(rel, "../") {
+		return false, fmt.Errorf("cgroup %q is not under its manager's cgroup %q", c.Path, c.ManagerRoot)
+	}
+	sub := c.cgroupV2
+	sub.Mountpoint = filepath.Join(c.Mountpoint, c.ManagerRoot)
+	sub.Path = "/" + rel
+	sub.Own = nil
+	// A user's manager has only the controllers the system delegated to it,
+	// and enabling any other in its subtree fails with ENOENT.
+	delegated, err := os.ReadFile(filepath.Join(sub.Mountpoint, controllersFile))
+	if err != nil {
+		return false, err
+	}
+	available := make(map[string]bool)
+	for _, name := range strings.Fields(string(delegated)) {
+		available[name] = true
+	}
+	sub.Controllers = nil
+	for _, name := range c.Controllers {
+		if available[name] {
+			sub.Controllers = append(sub.Controllers, name)
+		}
+	}
+	created, err := sub.createCgroupPaths()
+	c.Own = append(c.Own, sub.Own...)
+	return created, err
+}
