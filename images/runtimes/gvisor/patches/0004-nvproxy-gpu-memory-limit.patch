+// openHostFD returns a host file descriptor for a memmap file to close.
+func openHostFD(t *testing.T) int {
+	t.Helper()
+	fd, err := unix.Open("/dev/null", unix.O_RDONLY|unix.O_CLOEXEC, 0)
+	if err != nil {
+		t.Fatalf("open /dev/null: %v", err)
+	}
+	return fd
+}
+
+// newUVMFile returns the memmap file of an open UVM file.
+func newUVMFile(t *testing.T, nvp *nvproxy) *uvmFDMemmapFile {
+	t.Helper()
+	mf := &uvmFDMemmapFile{nvp: nvp}
+	mf.SetFD(openHostFD(t))
+	mf.RequireAddrEqualsFileOffset()
+	return mf
+}
+
+// newFrontendFile returns the memmap file of an open frontend file.
+func newFrontendFile(t *testing.T) *frontendFDMemmapFile {
+	t.Helper()
+	mf := &frontendFDMemmapFile{}
+	mf.SetFD(openHostFD(t))
+	return mf
+}
+
+// releaseFrontendFile does what frontendFD.Release does to the memmap file of
+// a frontend file through which clients were allocated.
+func releaseFrontendFile(nvp *nvproxy, mf *frontendFDMemmapFile, clients ...*rootClient) {
+	mf.MmapFileRefs.Closer = mf
+	mf.nvp = nvp
+	mf.clients = make(map[*rootClient]struct{})
+	for _, c := range clients {
+		mf.clients[c] = struct{}{}
+	}
+	mf.MappableRelease()
+}
+
+// mapUVM records a mapping of the memory with handle hMem in client at
+// [start, start+size) on gpus in the VA space of mf, as
+// UVM_MAP_EXTERNAL_ALLOCATION does when the driver succeeds.
+func mapUVM(nvp *nvproxy, mf *uvmFDMemmapFile, client *rootClient, hMem nvgpu.Handle, start, size uint64, gpus ...nvgpu.NvUUID) {
+	attrs := make([]nvgpu.UvmGpuMappingAttributes, len(gpus))
+	for i, gpu := range gpus {
+		attrs[i].GPUUUID = gpu
+	}
+	nvp.vidmemUVMMapExternal(context.Background(), mf, client.handle, hMem, start, size, attrs, func() bool { return true })
+}
