+func TestVidmemHandleReused(t *testing.T) {
+	nvp := newVidmemNVP(4 * mib)
+	client := addClient(nvp, 0x1000, 0, 0)
+	ctx := context.Background()
+	if !alloc(t, nvp, client, h(0x1001), h(0x2000), mib, mib) {
+		t.Fatal("1 MiB refused")
+	}
+	// The driver reuses the handle of memory that nvproxy did not see freed.
+	if !alloc(t, nvp, client, h(0x1001), h(0x2000), 2*mib, 2*mib) {
+		t.Fatal("2 MiB refused")
+	}
+	checkUsed(t, nvp, map[uint32]uint64{0: 2 * mib})
+	client.objsMu.Lock()
+	nvp.objAdd(ctx, client, h(0x2000), nvgpu.NV01_MEMORY_SYSTEM, &miscObject{}, h(0x1001))
+	client.objsMu.Unlock()
+	checkUsed(t, nvp, nil)
+	// Reused again, under another device.
+	if !alloc(t, nvp, client, h(0x1002), h(0x2000), mib, mib) {
+		t.Fatal("1 MiB refused")
+	}
+	// Freeing the former parent leaves the new object alone.
+	free(nvp, client, h(0x1001))
+	if o := tracked(client, h(0x2000)); o == nil || o.parent != h(0x1002) {
+		t.Fatalf("object under the other device untracked by freeing the former parent: %+v", o)
+	}
+	checkUsed(t, nvp, map[uint32]uint64{0: mib})
+	free(nvp, client, h(0x1002))
+	checkUsed(t, nvp, nil)
+	client.objsMu.Lock()
+	n := len(client.resources)
+	client.objsMu.Unlock()
+	if n != 1 {
+		t.Errorf("%d objects tracked after freeing the devices, want 1 (the client)", n)
+	}
+}
