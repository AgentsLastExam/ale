+func TestOverrideNVProxyGPUMemoryLimit(t *testing.T) {
+	testFlags := flag.NewFlagSet("test", flag.ContinueOnError)
+	RegisterFlags(testFlags)
+	c, err := NewFromFlags(testFlags)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if c.NVProxyGPUMemoryLimit != 0 {
+		t.Fatalf("default NVProxyGPUMemoryLimit = %d, want 0", c.NVProxyGPUMemoryLimit)
+	}
+	// Order matters: a successful override sets the ceiling for later steps.
+	for _, tc := range []struct {
+		name  string
+		value string
+		force bool
+		error string
+		want  uint64
+	}{
+		{name: "invalid", value: "abc", error: "invalid"},
+		{name: "overflow", value: "18446744073709551616", error: "invalid"},
+		{name: "zero without a limit", value: "0", want: 0},
+		{name: "set without a limit", value: "8589934592", want: 8 << 30},
+		{name: "match", value: "8589934592", want: 8 << 30},
+		{name: "lower", value: "4294967296", want: 4 << 30},
+		{name: "raise", value: "4294967297", error: "would raise or remove", want: 4 << 30},
+		{name: "remove", value: "0", error: "would raise or remove", want: 4 << 30},
+		{name: "hex lower", value: "0x40000000", want: 1 << 30},
+		{name: "forced raise", value: "17179869184", force: true, want: 16 << 30},
+		{name: "forced remove", value: "0", force: true, want: 0},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			err := c.Override(testFlags, "nvproxy-gpu-memory-limit", tc.value, tc.force)
+			if tc.error == "" {
+				if err != nil {
+					t.Errorf("Override(%q) failed: %v", tc.value, err)
+				}
+			} else if err == nil || !strings.Contains(err.Error(), tc.error) {
+				t.Errorf("Override(%q) wrong error: %v", tc.value, err)
+			}
+			if got := c.NVProxyGPUMemoryLimit; got != tc.want {
+				t.Errorf("NVProxyGPUMemoryLimit = %d, want %d", got, tc.want)
+			}
+		})
+	}
+
+	// With allow-flag-override, an annotation may also raise the limit.
+	c.NVProxyGPUMemoryLimit = 1 << 30
+	c.AllowFlagOverride = true
+	if err := c.Override(testFlags, "nvproxy-gpu-memory-limit", "2147483648", false); err != nil {
+		t.Errorf("Override with allow-flag-override failed: %v", err)
+	}
+	if got, want := c.NVProxyGPUMemoryLimit, uint64(2<<30); got != want {
+		t.Errorf("NVProxyGPUMemoryLimit = %d, want %d", got, want)
+	}
+	if flags := c.ToFlags(); !slices.Contains(flags, "--nvproxy-gpu-memory-limit=2147483648") {
+		t.Errorf("ToFlags() = %v, want --nvproxy-gpu-memory-limit=2147483648", flags)
+	}
+}
