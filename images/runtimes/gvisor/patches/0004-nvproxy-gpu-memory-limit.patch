+	checkUsed(t, nvp, map[uint32]uint64{0: mib + 64*kib})
+	free(nvp, other, h(0x4000))
+	checkUsed(t, nvp, map[uint32]uint64{0: 64 * kib})
+	free(nvp, client, h(0x1000))
+	checkUsed(t, nvp, nil)
+}
