+func TestVidmemHeapAlloc(t *testing.T) {
+	nvp := newVidmemNVP(2 * mib)
+	client := addClient(nvp, 0x1000, 0)
+	ctx := context.Background()
+	const (
+		sysmem = nvgpu.NVOS32_ATTR_LOCATION_MASK << nvgpu.NVOS32_ATTR_LOCATION_SHIFT // not vidmem
+		egm    = nvgpu.NVOS32_ATTR2_USE_EGM_TRUE << nvgpu.NVOS32_ATTR2_USE_EGM_SHIFT
+	)
+	// heapAlloc allocates as rmVidHeapControlAllocSize does, as size bytes
+	// that the driver allocates as allocated bytes.
+	heapAlloc := func(p nvgpu.NVOS32AllocSize, allocated uint64) uint32 {
+		fi := newVidmemFI(nvp)
+		a := vidmemAlloc{nvp: nvp}
+		client.objsMu.Lock()
+		defer func() {
+			client.objsMu.Unlock()
+			a.done(ctx)
+		}()
+		if status := a.checkHeapLocked(ctx, client, h(0x1001), &p); status != nvgpu.NV_OK {
+			return status
+		}
+		p.Size = allocated
+		if a.charge == nil {
+			nvp.objAdd(ctx, client, p.HMemory, nvgpu.NV01_MEMORY_SYSTEM, &miscObject{}, h(0x1001))
+			return nvgpu.NV_OK
+		}
+		return a.addHeapLocked(fi, client, h(0x1001), nvgpu.NV01_MEMORY_LOCAL_USER, &p)
+	}
+	// Virtual, system and EGM memory are not charged.
+	for _, p := range []nvgpu.NVOS32AllocSize{
+		{HMemory: h(0x2000), Flags: nvgpu.NVOS32_ALLOC_FLAGS_VIRTUAL, Size: 4 * mib},
+		{HMemory: h(0x2001), Attr: sysmem, Size: 4 * mib},
+		{HMemory: h(0x2002), Attr2: egm, Size: 4 * mib},
+	} {
+		if status := heapAlloc(p, p.Size); status != nvgpu.NV_OK {
+			t.Errorf("%+v: status %#x", p, status)
+		}
+	}
+	checkUsed(t, nvp, nil)
+	// Device memory is, as the driver sizes it.
+	if status := heapAlloc(nvgpu.NVOS32AllocSize{HMemory: h(0x2003), Size: 100 * kib}, 128*kib); status != nvgpu.NV_OK {
+		t.Fatalf("100 KiB: status %#x", status)
+	}
+	checkUsed(t, nvp, map[uint32]uint64{0: 128 * kib})
+	if status := heapAlloc(nvgpu.NVOS32AllocSize{HMemory: h(0x2004), Size: 2 * mib}, 2*mib); status != nvgpu.NV_ERR_NO_MEMORY {
+		t.Errorf("2 MiB beyond the limit: status %#x, want NV_ERR_NO_MEMORY", status)
+	}
+	freed := fakeRMFree(t, nvgpu.NV_OK)
+	if status := heapAlloc(nvgpu.NVOS32AllocSize{HMemory: h(0x2004), Size: 64 * kib}, 2*mib); status != nvgpu.NV_ERR_NO_MEMORY {
+		t.Errorf("allocation the driver rounded beyond the limit: status %#x, want NV_ERR_NO_MEMORY", status)
+	}
+	if len(*freed) != 1 || (*freed)[0] != h(0x2004) {
+		t.Errorf("freed %v, want [%v]", *freed, h(0x2004))
+	}
+	checkUsed(t, nvp, map[uint32]uint64{0: 128 * kib})
+	free(nvp, client, h(0x2003))
+	checkUsed(t, nvp, nil)
+}
