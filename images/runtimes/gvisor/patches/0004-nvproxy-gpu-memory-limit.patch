+func TestVidmemUVMMappings(t *testing.T) {
+	nvp := newVidmemNVP(8 * mib)
+	client := addClient(nvp, 0x1000, 0)
+	ctx := context.Background()
+	gpu0, gpu1 := nvgpu.NvUUID{0: 1}, nvgpu.NvUUID{0: 2}
+	if !alloc(t, nvp, client, h(0x1001), h(0x2000), 2*mib, 2*mib) ||
+		!alloc(t, nvp, client, h(0x1001), h(0x2001), mib, mib) {
+		t.Fatal("allocation refused")
+	}
+	mf := newUVMFile(t, nvp)
+	v := &mf.vidmem
+	do := func(f func()) {
+		nvp.vidmemMu.Lock()
+		defer nvp.vidmemMu.Unlock()
+		f()
+	}
+	const base = 0x7f0000000000
+	do(func() { v.createRangeLocked(base, base+16*mib-1) })
+	// Map the 2 MiB memory on both GPUs and the 1 MiB memory on gpu0, then
+	// free their handles.
+	mapUVM(nvp, mf, client, h(0x2000), base, 2*mib, gpu0, gpu1)
+	mapUVM(nvp, mf, client, h(0x2001), base+4*mib, mib, gpu0)
+	free(nvp, client, h(0x2000))
+	free(nvp, client, h(0x2001))
+	checkUsed(t, nvp, map[uint32]uint64{0: 3 * mib})
+	// Unmapping the middle of a mapping splits it; the memory stays.
+	do(func() { nvp.vidmemUVMUnmapLocked(ctx, v, gpu0, base+mib-64*kib, base+mib+64*kib-1) })
+	if got := len(v.mappings[gpu0]); got != 3 {
+		t.Errorf("%d mappings on gpu0 after a split, want 3", got)
+	}
+	// Unmapping on gpu0 leaves the mapping on gpu1.
+	do(func() { nvp.vidmemUVMUnmapLocked(ctx, v, gpu0, base, base+2*mib-1) })
+	checkUsed(t, nvp, map[uint32]uint64{0: 3 * mib})
+	// UVM_UNREGISTER_GPU_VASPACE removes the mappings on its GPU.
+	do(func() { nvp.vidmemUVMRemoveGPULocked(ctx, v, gpu1) })
+	checkUsed(t, nvp, map[uint32]uint64{0: mib})
+	// A mapping over it, of uncharged memory, replaces it.
+	do(func() { nvp.vidmemUVMMapLocked(ctx, v, gpu0, base+4*mib-64*kib, base+4*mib+64*kib-1, nil) })
+	checkUsed(t, nvp, map[uint32]uint64{0: mib})
+	do(func() { nvp.vidmemUVMMapLocked(ctx, v, gpu0, base+4*mib, base+5*mib-1, nil) })
+	checkUsed(t, nvp, nil)
+
+	// UVM_FREE of an external range removes the mappings in it, and the
+	// release of the VA space the rest.
+	if !alloc(t, nvp, client, h(0x1001), h(0x2002), mib, mib) ||
+		!alloc(t, nvp, client, h(0x1001), h(0x2003), 2*mib, 2*mib) {
+		t.Fatal("allocation refused")
+	}
+	do(func() { v.createRangeLocked(base+32*mib, base+48*mib-1) })
+	mapUVM(nvp, mf, client, h(0x2002), base, mib, gpu0)
+	mapUVM(nvp, mf, client, h(0x2003), base+32*mib, 2*mib, gpu0)
+	free(nvp, client, h(0x2002))
+	free(nvp, client, h(0x2003))
+	checkUsed(t, nvp, map[uint32]uint64{0: 3 * mib})
+	do(func() { nvp.vidmemUVMFreeLocked(ctx, v, base) })
+	checkUsed(t, nvp, map[uint32]uint64{0: 2 * mib})
+	// The host file closes when the file is released and its last page
+	// reference is dropped.
+	fr := memmap.FileRange{Start: base + 32*mib, End: base + 32*mib + uint64(hostarch.PageSize)}
+	mf.IncRef(fr, 0)
+	mf.MappableRelease()
+	checkUsed(t, nvp, map[uint32]uint64{0: 2 * mib})
+	mf.DecRef(fr)
+	if mf.FD() >= 0 {
+		t.Error("host file still open")
+	}
+	checkUsed(t, nvp, nil)
+}
+
+func TestVidmemUVMMapExternalLocksClient(t *testing.T) {
+	nvp := newVidmemNVP(4 * mib)
+	client := addClient(nvp, 0x1000, 0)
+	mf := newUVMFile(t, nvp)
+	if !alloc(t, nvp, client, h(0x1001), h(0x2000), mib, mib) {
+		t.Fatal("1 MiB refused")
+	}
+	gpus := []nvgpu.UvmGpuMappingAttributes{{GPUUUID: nvgpu.NvUUID{0: 1}}}
+	invoked := false
+	nvp.vidmemUVMMapExternal(context.Background(), mf, h(0x1000), h(0x2000), 0x7f0000000000, mib, gpus, func() bool {
+		// UVM duplicates the memory with the client locked, so that its
+		// handle cannot be freed and reused meanwhile.
+		if client.objsMu.mu.TryLock() {
+			client.objsMu.mu.Unlock()
+			t.Error("UVM_MAP_EXTERNAL_ALLOCATION invoked with the client unlocked")
+		}
+		invoked = true
+		return true
+	})
+	if !invoked {
+		t.Fatal("UVM_MAP_EXTERNAL_ALLOCATION not invoked")
+	}
+	free(nvp, client, h(0x2000))
+	checkUsed(t, nvp, map[uint32]uint64{0: mib})
+	// A failed mapping records nothing.
+	if !alloc(t, nvp, client, h(0x1001), h(0x2001), mib, mib) {
+		t.Fatal("1 MiB refused")
+	}
+	nvp.vidmemUVMMapExternal(context.Background(), mf, h(0x1000), h(0x2001), 0x7f0010000000, mib, gpus, func() bool { return false })
+	free(nvp, client, h(0x2001))
+	checkUsed(t, nvp, map[uint32]uint64{0: mib})
+	mf.MappableRelease()
+	checkUsed(t, nvp, nil)
+}
