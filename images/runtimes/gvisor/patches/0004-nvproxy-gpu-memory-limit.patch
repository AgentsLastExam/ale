+// checkNVProxyGPUMemoryLimit ensures an annotation can only set a GPU memory
+// limit or lower (or match) the runtime-configured one; raising or removing
+// (0) it would weaken operator policy. A runtime-configured limit of 0 means
+// the operator hasn't set one, so any pod-supplied limit is accepted.
+func checkNVProxyGPUMemoryLimit(c *Config, name string, value string) error {
+	v, err := strconv.ParseUint(value, 0, 64)
+	if err != nil {
+		return fmt.Errorf("invalid %s annotation %q: %w", name, value, err)
+	}
+	if c.NVProxyGPUMemoryLimit != 0 && (v == 0 || v > c.NVProxyGPUMemoryLimit) {
+		return fmt.Errorf("%s=%d would raise or remove runtime-configured limit %d; that requires flag %q to be enabled",
