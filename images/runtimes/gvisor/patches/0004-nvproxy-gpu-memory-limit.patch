+	}
+	checkUsed(t, nvp, map[uint32]uint64{0: 3 * mib})
+	// Closing dev releases them.
+	releaseFrontendFile(nvp, dev)
+	if dev.hostFD >= 0 || ctl.hostFD >= 0 {
+		t.Errorf("host files %d and %d still open", dev.hostFD, ctl.hostFD)
+	}
+	checkUsed(t, nvp, nil)
+}
