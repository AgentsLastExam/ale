+	}
+	// Export to slots 3 and 4, and 0, as the controls record it.
+	p := nvgpu.NV0000_CTRL_OS_UNIX_EXPORT_OBJECTS_TO_FD_PARAMS{NumObjects: 2, Index: 3}
+	p.Objects[0], p.Objects[1] = h(0x2000), h(0x2001)
+	exporter.objsMu.Lock()
+	vidmemExportObjectsToFD(fi, exporter, mf, &p)
+	exporter.objsMu.Unlock()
+	if len(mf.vidmemExports) != 2 || mf.vidmemExports[3].charge == nil || mf.vidmemExports[4].charge == nil {
+		t.Fatalf("exports %v, want slots 3 and 4", mf.vidmemExports)
+	}
+	exporter.objsMu.Lock()
+	nvp.vidmemExportLocked(fi.ctx, exporter, mf, 0, h(0x1001)) // not memory
+	exporter.objsMu.Unlock()
+	// The exporter frees its handles: the export keeps the memory.
+	free(nvp, exporter, h(0x2000))
+	free(nvp, exporter, h(0x2001))
+	checkUsed(t, nvp, map[uint32]uint64{0: 3 * mib})
+	// Import slots 3 and 0.
+	ip := nvgpu.NV0000_CTRL_OS_UNIX_IMPORT_OBJECTS_FROM_FD_PARAMS{NumObjects: 2, Index: 3, HParent: h(0x3001)}
+	ip.Objects[0] = h(0x4003)
+	importer.objsMu.Lock()
+	vidmemImportObjectsFromFD(fi, importer, mf, &ip)
+	nvp.vidmemImportLocked(fi.ctx, importer, mf, 0, h(0x3001), h(0x4000))
+	importer.objsMu.Unlock()
+	// Overwriting slot 4 releases its memory.
+	exporter.objsMu.Lock()
+	nvp.vidmemExportLocked(fi.ctx, exporter, mf, 4, h(nvgpu.NV01_NULL_OBJECT))
+	exporter.objsMu.Unlock()
+	checkUsed(t, nvp, map[uint32]uint64{0: mib})
+	// Closing the export keeps the import's memory.
+	if err := mf.Close(); err != nil {
+		t.Fatalf("Close: %v", err)
+	}
+	checkUsed(t, nvp, map[uint32]uint64{0: mib})
+	if tracked(importer, h(0x4000)) != nil {
+		t.Error("import of an uncharged object is tracked")
+	}
+	free(nvp, importer, h(0x4003))
+	checkUsed(t, nvp, nil)
+}
