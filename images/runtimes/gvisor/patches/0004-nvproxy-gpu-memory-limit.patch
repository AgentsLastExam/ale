+func TestVidmemFabric(t *testing.T) {
+	nvp := newVidmemNVP(4 * mib)
+	client := addClient(nvp, 0x1000, 0)
+	fi := newVidmemFI(nvp)
+	if !alloc(t, nvp, client, h(0x1001), h(0x2000), 2*mib, 2*mib) {
+		t.Fatal("2 MiB refused")
+	}
+	fabric := func(hNew, hVidMem nvgpu.Handle) {
+		// map.hVidMem follows alignment, allocSize, pageSize, allocFlags and
+		// map.offset.
+		var p nvgpu.NV00F8_ALLOCATION_PARAMETERS
+		buf := make([]byte, p.SizeBytes())
+		hostarch.ByteOrder.PutUint32(buf[40:], hVidMem.Val)
+		p.UnmarshalBytes(buf)
+		if p.GetHVidMem() != hVidMem {
+			t.Fatalf("hVidMem %v, want %v", p.GetHVidMem(), hVidMem)
+		}
+		ioctlParams := nvgpu.NVOS64_PARAMETERS{HRoot: h(0x1000), HObjectParent: h(0x1001), HObjectNew: hNew, HClass: nvgpu.NV_MEMORY_FABRIC}
+		client.objsMu.Lock()
+		vidmemAddHolderObjLocked(vidmemFabricMemory)(fi, client, &ioctlParams, nvgpu.RS_ACCESS_MASK{}, &p)
+		client.objsMu.Unlock()
+	}
+	fabric(h(0x2100), h(0x2000))
+	// A flexible fabric object has no memory of its own.
+	fabric(h(0x2101), h(nvgpu.NV01_NULL_OBJECT))
+	free(nvp, client, h(0x2000))
+	checkUsed(t, nvp, map[uint32]uint64{0: 2 * mib})
+	free(nvp, client, h(0x2101))
+	checkUsed(t, nvp, map[uint32]uint64{0: 2 * mib})
+	free(nvp, client, h(0x2100))
+	checkUsed(t, nvp, nil)
+}
