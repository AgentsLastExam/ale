+package nvproxy
+
+// GPU memory limit
+//
+// With Options.GPUMemoryLimit set, nvproxy charges every allocation of device
+// memory for the application (class NV01_MEMORY_LOCAL_USER, by NV_ESC_RM_ALLOC
+// or by NV_ESC_RM_VID_HEAP_CONTROL) to the GPU it is made on, by device
+// instance, and keeps the sandbox's total on each GPU within the limit:
+//
+//   - Before calling the driver, nvproxy charges the requested size rounded up
+//     as in vidmemFootprint, and fails the allocation with NV_ERR_NO_MEMORY, as
+//     the driver does when the GPU is full, if that exceeds the limit or the
+//     GPU is unknown. The GPU is unknown unless the parent is a device, or a
+//     subdevice of one, that the client allocated itself, rather than
+//     duplicated or imported.
+//   - The driver returns the size it allocated, a whole number of pages. If
+//     its footprint exceeds the limit, nvproxy frees the new object with
+//     NV_ESC_RM_FREE, as the application's client, and fails the allocation
+//     in the same way; otherwise it charges that footprint.
+//   - nvproxy refuses NVOS32_ALLOC_FLAGS_FIXED_ADDRESS_ALLOCATE with
+//     NV_ERR_NOT_SUPPORTED: the driver then takes the requested size rounded
+//     up to the requested alignment, but returns the size rounded up to the
+//     page size only (src/nvidia/src/kernel/mem_mgr/video_mem.c:
+//     _vidmemPmaAllocate()).
+//
+// A charge lasts while anything that nvproxy tracks keeps the memory
+// allocated:
+//
+//   - a handle to it: the one allocated, a duplicate (NV_ESC_RM_DUP_OBJECT), or
+//     an import from a file (NV0000_CTRL_CMD_OS_UNIX_IMPORT_OBJECT(S)_FROM_FD);
+//     handles are released by NV_ESC_RM_FREE, with a freed parent, or in the
+//     teardown of their client when the client's file is closed;
+//   - an export to a file (NV0000_CTRL_CMD_OS_UNIX_EXPORT_OBJECT(S)_TO_FD),
+//     until the file is closed or the export's slot is overwritten: the driver
+//     holds a duplicate in its export client until then
+//     (src/nvidia/arch/nvalloc/unix/src/rmobjexportimport.c:RmExportObject(),
+//     osapi.c:rm_cleanup_file_private() => RmFreeObjExportHandle());
+//   - an object that the driver made with duplicates of the memory, which
+//     holds the memory's charge: a fabric object (NV_MEMORY_FABRIC with
+//     map.hVidMem; src/nvidia/src/kernel/mem_mgr/mem_fabric.c:
+//     memoryfabricConstruct_IMPL()), a semaphore surface (NV_SEMAPHORE_SURFACE;
+//     src/nvidia/src/kernel/gpu/mem_mgr/sem_surf.c:_semsurfDupMemory()), and a
+//     memory mapper made with a semaphore surface (NV_MEMORY_MAPPER;
+//     src/nvidia/src/kernel/gpu/mem_mgr/mem_mapper.c:
+//     memmapperConstruct_IMPL());
+//   - a UVM external mapping (UVM_MAP_EXTERNAL_ALLOCATION), which holds a
+//     duplicate until it is unmapped or its VA space is destroyed; see
+//     vidmem_uvm.go.
+//
+// Closing a file does not release what the driver keeps of it while another
+// file holds it: a file registered with NV_ESC_REGISTER_FD holds the file of
+// its ctl_fd, with its clients and exports, until it is closed itself
+// (src/nvidia/arch/nvalloc/unix/src/escape.c:RmIoctl(),
+// osapi.c:rm_cleanup_file_private() => nv_put_file_private()), and a UVM MM
+// file holds its VA space (vidmem_uvm.go). nvproxy keeps the other file's host
+// file open as long; see vidmemHoldRange.
+//
+// NV00F8_CTRL_CMD_ATTACH_MEM and NV00FD_CTRL_CMD_ATTACH_MEM need nothing: they
+// record inter-mappings, which the driver removes when the memory is freed
+// (src/nvidia/src/libraries/resserv/src/rs_client.c:clientFreeResource_IMPL()
+// => _clientUnmapInterBackRefMappings()). NV_ESC_EXPORT_TO_DMABUF_FD is
+// refused with NV_ERR_NOT_SUPPORTED, since its dma-buf keeps duplicates while
+// the kernel holds it (kernel-open/nvidia/nv-dmabuf.c), which nvproxy cannot
+// see. NV_MEMORY_EXPORT duplicates memory only in
+// NV00E0_CTRL_CMD_EXPORT_MEM, which nvproxy does not support.
+//
+// Not charged: memory the driver allocates for itself (channels, contexts,
+// page tables), whose amount grows with the number of contexts, channels and
+// mappings the application creates; and managed memory, whose pages UVM
+// allocates on fault and evicts when the GPU is full.
+//
+// The limit and the charges are saved with the sandbox. A restored sandbox
+// keeps the limit it was saved with, since Register is not called on restore,
+// and its charges move to the device instances its devices are remapped to.
+// nvproxy does not recreate exports and UVM mappings on restore; their charges
+// remain until their files are closed.
+
+import (
+	"fmt"
+	"slices"
+
+	"gvisor.dev/gvisor/pkg/abi/nvgpu"
+	"gvisor.dev/gvisor/pkg/context"
+	"gvisor.dev/gvisor/pkg/errors/linuxerr"
+	"gvisor.dev/gvisor/pkg/hostarch"
+	"gvisor.dev/gvisor/pkg/log"
+	"gvisor.dev/gvisor/pkg/sentry/memmap"
+)
+
+// vidmemPageSize is the granularity in which the driver takes device memory
+// for an application's allocation; see vidmemFootprint.
+const vidmemPageSize = 64 << 10
+
+// vidmemFootprint returns the device memory that an NV01_MEMORY_LOCAL_USER
+// allocation of size bytes takes, or false if that overflows. The driver
+// rounds the size up to the allocation's page size
+// (src/nvidia/src/kernel/gpu/mem_mgr/arch/maxwell/mem_mgr_gm107.c:
+// memmgrAllocDetermineAlignment_GM107()), returns the rounded size
+// (src/nvidia/src/kernel/mem_mgr/video_mem.c:vidmemConstruct_IMPL()), and
+// takes it from PMA in pages of that size, except that PMA allocates 4 KiB
+// pages as 64 KiB ones (video_mem.c:_vidmemPmaAllocate()). The footprint of a
+// size the driver returned is therefore that size rounded up to 64 KiB, and
+// the requested size rounded up to 64 KiB is never more than the footprint.
+// This does not hold for NVOS32_ALLOC_FLAGS_FIXED_ADDRESS_ALLOCATE, which
+// nvproxy refuses.
+func vidmemFootprint(size uint64) (uint64, bool) {
+	const mask = vidmemPageSize - 1
+	if size > ^uint64(0)-mask {
+		return 0, false
+	}
+	return (size + mask) &^ mask, true
+}
+
+// vidmemCharge is device memory charged against the GPU memory limit. Its
+// fields are protected by nvproxy.vidmemMu.
+//
+// +stateify savable
+type vidmemCharge struct {
+	// gpu is the device instance of the GPU that the memory is on.
+	gpu uint32
+	// size is the memory's footprint in bytes.
+	size uint64
+	// refs is the number of holders of the charge.
+	refs int
+	// parts, if not nil, are the charges that this charge holds, instead of
+	// charging memory itself: those of an object that holds several, such as
+	// a semaphore surface. Such a charge is not in nvproxy.vidmemCharges.
+	parts []*vidmemCharge
+}
+
+// vidmemTryCharge charges the footprint of size bytes on the GPU with device
+// instance gpu. It returns nil, charging nothing, if that would exceed the
+// limit.
+func (nvp *nvproxy) vidmemTryCharge(ctx context.Context, gpu uint32, size uint64) *vidmemCharge {
+	footprint, ok := vidmemFootprint(size)
+	nvp.vidmemMu.Lock()
+	defer nvp.vidmemMu.Unlock()
+	used := nvp.vidmemUsed[gpu]
+	if !ok || footprint > nvp.vidmemLimit || used > nvp.vidmemLimit-footprint {
+		ctx.Infof("nvproxy: GPU memory limit: refused %d bytes on device instance %d, %d of %d in use", size, gpu, used, nvp.vidmemLimit)
+		return nil
+	}
+	nvp.vidmemUsed[gpu] = used + footprint
+	c := &vidmemCharge{gpu: gpu, size: footprint, refs: 1}
+	nvp.vidmemCharges[c] = struct{}{}
+	if ctx.IsLogging(log.Debug) {
+		ctx.Debugf("nvproxy: GPU memory limit: charged %d bytes on device instance %d, %d of %d in use", footprint, gpu, used+footprint, nvp.vidmemLimit)
+	}
+	return c
+}
+
+// vidmemSettle sets c's size to the footprint of size bytes, the size that the
+// driver allocated. If that would exceed the limit, it returns false and
+// leaves c unchanged, unless force is true.
+func (nvp *nvproxy) vidmemSettle(ctx context.Context, c *vidmemCharge, size uint64, force bool) bool {
+	footprint, ok := vidmemFootprint(size)
+	if !ok {
+		footprint = size
+	}
+	nvp.vidmemMu.Lock()
+	defer nvp.vidmemMu.Unlock()
+	others := nvp.vidmemUsed[c.gpu] - c.size
+	if !force && (!ok || footprint > nvp.vidmemLimit || others > nvp.vidmemLimit-footprint) {
+		return false
+	}
+	nvp.vidmemUsed[c.gpu] = others + footprint
+	if footprint != c.size && ctx.IsLogging(log.Debug) {
+		ctx.Debugf("nvproxy: GPU memory limit: the driver allocated %d bytes for %d on device instance %d, %d of %d in use", footprint, c.size, c.gpu, others+footprint, nvp.vidmemLimit)
+	}
+	c.size = footprint
+	return true
+}
+
+// vidmemIncRef adds a holder of c.
+func (nvp *nvproxy) vidmemIncRef(c *vidmemCharge) {
+	nvp.vidmemMu.Lock()
+	defer nvp.vidmemMu.Unlock()
+	nvp.vidmemIncRefLocked(c)
+}
+
+// Preconditions: nvp.vidmemMu must be locked.
+func (nvp *nvproxy) vidmemIncRefLocked(c *vidmemCharge) {
+	if c.refs <= 0 {
+		log.Traceback("nvproxy: GPU memory limit: reference to a released charge")
+	}
+	c.refs++
+}
+
+// vidmemDecRef removes a holder of c, and releases c when it was the last.
+func (nvp *nvproxy) vidmemDecRef(ctx context.Context, c *vidmemCharge) {
+	nvp.vidmemMu.Lock()
+	defer nvp.vidmemMu.Unlock()
+	nvp.vidmemDecRefLocked(ctx, c)
+}
+
+// Preconditions: nvp.vidmemMu must be locked.
+func (nvp *nvproxy) vidmemDecRefLocked(ctx context.Context, c *vidmemCharge) {
+	c.refs--
+	if c.refs > 0 {
+		return
+	}
+	if c.refs < 0 {
+		log.Traceback("nvproxy: GPU memory limit: charge released twice")
+		return
+	}
+	if c.parts != nil {
+		for _, p := range c.parts {
+			nvp.vidmemDecRefLocked(ctx, p)
+		}
+		return
+	}
+	used := nvp.vidmemUsed[c.gpu] - c.size
+	if used == 0 {
+		delete(nvp.vidmemUsed, c.gpu)
+	} else {
+		nvp.vidmemUsed[c.gpu] = used
+	}
+	delete(nvp.vidmemCharges, c)
+	if ctx.IsLogging(log.Debug) {
+		ctx.Debugf("nvproxy: GPU memory limit: released %d bytes on device instance %d, %d of %d in use", c.size, c.gpu, used, nvp.vidmemLimit)
+	}
+}
+
+// vidmemRelease releases a holder's reference to c once; *released records
+// that it has.
+func (nvp *nvproxy) vidmemRelease(ctx context.Context, released *bool, c *vidmemCharge) {
+	if *released {
+		return
+	}
+	*released = true
+	nvp.vidmemDecRef(ctx, c)
+}
+
+// vidmemAfterLoad moves the charges of a restored sandbox from the device
+// instances of its saved devices to those of the devices that dr maps them
+// to.
+func (nvp *nvproxy) vidmemAfterLoad(dr *DeviceRemapping) {
+	if nvp.vidmemUsed == nil {
+		nvp.vidmemUsed = make(map[uint32]uint64)
+	}
+	if nvp.vidmemCharges == nil {
+		nvp.vidmemCharges = make(map[*vidmemCharge]struct{})
+	}
+	if dr == nil || len(nvp.vidmemCharges) == 0 {
+		return
+	}
+	used := make(map[uint32]uint64)
+	for c := range nvp.vidmemCharges {
+		oldDev, ok := dr.OldDeviceByDeviceInstance[c.gpu]
+		if !ok {
+			panic(fmt.Sprintf("nvproxy: remapping does not contain a saved device with device instance %d, which has GPU memory charges: %+v", c.gpu, dr))
+		}
+		c.gpu = dr.NewDeviceByOld[oldDev].DeviceInstance
+		used[c.gpu] += c.size
+	}
+	nvp.vidmemUsed = used
+}
+
+// vidmemObject is an rmAllocObject that holds a charge: device memory
+// allocated by NV_ESC_RM_ALLOC, or an object made with duplicates of charged
+// memory (vidmemAddHolderLocked).
+//
+// +stateify savable
+type vidmemObject struct {
+	rmAllocObject
+
+	charge   *vidmemCharge
+	released bool // protected by client.objsMu
+}
+
+// Release implements objectImpl.Release.
+func (o *vidmemObject) Release(ctx context.Context) func() {
+	o.nvp.vidmemRelease(ctx, &o.released, o.charge)
+	return nil
+}
+
+// vidmemRef is a handle that holds a charge and was not created by
+// NV_ESC_RM_ALLOC: device memory allocated by NV_ESC_RM_VID_HEAP_CONTROL, a
+// duplicate, or an import.
+type vidmemRef struct {
+	object
+
+	charge   *vidmemCharge
+	released bool // protected by client.objsMu
+}
+
+// Release implements objectImpl.Release.
+func (o *vidmemRef) Release(ctx context.Context) func() {
+	o.nvp.vidmemRelease(ctx, &o.released, o.charge)
+	return nil
+}
+
+// vidmemChargeOf returns the charge that impl holds, or nil.
+//
+// Precondition: the client of impl must be locked.
+func vidmemChargeOf(impl objectImpl) *vidmemCharge {
+	switch o := impl.(type) {
+	case *vidmemObject:
+		if !o.released {
+			return o.charge
+		}
+	case *vidmemRef:
+		if !o.released {
+			return o.charge
+		}
+	}
+	return nil
+}
+
+// vidmemForget releases the charge that impl holds, if any, when nvproxy stops
+// tracking impl without freeing it.
+//
+// Precondition: the client of impl must be locked.
+func (nvp *nvproxy) vidmemForget(ctx context.Context, impl objectImpl) {
+	switch o := impl.(type) {
+	case *vidmemObject:
+		nvp.vidmemRelease(ctx, &o.released, o.charge)
+	case *vidmemRef:
+		nvp.vidmemRelease(ctx, &o.released, o.charge)
+	}
+}
+
+// vidmemForgetFreedLocked releases the charges that o and the objects that
+// depend on it hold, when the driver has freed o, and with it those objects,
+// without nvproxy seeing it.
+//
+// Precondition: o.client.objsMu must be locked.
+func (nvp *nvproxy) vidmemForgetFreedLocked(ctx context.Context, o *object) {
+	if nvp.vidmemLimit == 0 {
+		return
+	}
+	seen := make(map[*object]struct{})
+	var forget func(o *object)
+	forget = func(o *object) {
+		if _, ok := seen[o]; ok {
+			return
+		}
+		seen[o] = struct{}{}
+		nvp.vidmemForget(ctx, o.impl)
+		for r := range o.rdeps {
+			forget(r)
+		}
+	}
+	forget(o)
+}
+
+// vidmemGPULocked returns the device instance of the GPU that memory allocated
+// with parent h, a device or a subdevice, is on, or false if nvproxy does not
+// know it.
+//
+// Precondition: client.objsMu must be locked.
+func vidmemGPULocked(client *rootClient, h nvgpu.Handle) (uint32, bool) {
+	o := client.resources[h]
+	if o != nil && o.class == nvgpu.NV20_SUBDEVICE_0 {
+		o = client.resources[o.parent]
+	}
+	if o == nil || o.class != nvgpu.NV01_DEVICE_0 {
+		return 0, false
+	}
+	dev, ok := o.impl.(*rmAllocObject)
+	if !ok {
+		return 0, false
+	}
+	var allocParams nvgpu.NV0080_ALLOC_PARAMETERS
+	// src/nvidia/src/kernel/gpu/device.c:deviceConstruct_IMPL() treats NULL
+	// allocParams as the zero value.
+	if len(dev.params.allocParams) >= allocParams.SizeBytes() {
+		allocParams.UnmarshalBytes(dev.params.allocParams)
+	}
+	return allocParams.DeviceID, true
+}
+
+// vidmemChargeNewLocked charges an allocation of size bytes of device memory
+// with parent hParent in client. It returns nil, charging nothing, if that
+// would exceed the limit or nvproxy does not know the GPU.
+//
+// Precondition: client.objsMu must be locked.
+func (nvp *nvproxy) vidmemChargeNewLocked(ctx context.Context, client *rootClient, hParent nvgpu.Handle, size uint64) *vidmemCharge {
+	gpu, ok := vidmemGPULocked(client, hParent)
+	if !ok {
+		ctx.Warningf("nvproxy: GPU memory limit: refused %d bytes with parent %v:%v, whose GPU is unknown", size, client.handle, hParent)
+		return nil
+	}
+	return nvp.vidmemTryCharge(ctx, gpu, size)
+}
+
+// vidmemAlloc charges an allocation of device memory against the GPU memory
+// limit: checkLocked before the driver allocates the memory, addLocked once it
+// has, and done at the end, which releases the charge unless the memory holds
+// it.
+type vidmemAlloc struct {
+	nvp    *nvproxy
+	charge *vidmemCharge
+}
+
+// checkLocked charges an allocation of size bytes with the given
+// NVOS32_ALLOC_FLAGS_* and parent hParent in client. It returns the status
+// with which to fail the allocation, without calling the driver, or NV_OK.
+//
+// Precondition: client.objsMu must be locked.
+func (a *vidmemAlloc) checkLocked(ctx context.Context, client *rootClient, hParent nvgpu.Handle, flags uint32, size uint64) uint32 {
+	if flags&nvgpu.NVOS32_ALLOC_FLAGS_FIXED_ADDRESS_ALLOCATE != 0 {
+		ctx.Warningf("nvproxy: GPU memory limit: refused %d bytes at a fixed address with parent %v:%v", size, client.handle, hParent)
+		return nvgpu.NV_ERR_NOT_SUPPORTED
+	}
+	a.charge = a.nvp.vidmemChargeNewLocked(ctx, client, hParent, size)
+	if a.charge == nil {
+		return nvgpu.NV_ERR_NO_MEMORY
+	}
+	return nvgpu.NV_OK
+}
+
+// addLocked records the device memory that the driver allocated as size bytes
+// with handle h, class c and parent hParent in client, as the object that
+// newImpl returns for the charge, unless its footprint exceeds the limit. It
+// returns the status with which the allocation ends.
+//
+// Precondition: client.objsMu must be locked.
+func (a *vidmemAlloc) addLocked(fi *frontendIoctlState, client *rootClient, h nvgpu.Handle, c nvgpu.ClassID, hParent nvgpu.Handle, size uint64, newImpl func(*vidmemCharge) objectImpl) uint32 {
+	if !a.nvp.vidmemSettleAllocLocked(fi, client, a.charge, hParent, h, size) {
+		return nvgpu.NV_ERR_NO_MEMORY
+	}
+	if a.nvp.objAdd(fi.ctx, client, h, c, newImpl(a.charge), hParent) {
+		a.charge = nil // the object holds it
+	}
+	return nvgpu.NV_OK
+}
+
+// done releases the charge unless the memory holds it.
+func (a *vidmemAlloc) done(ctx context.Context) {
+	if a.charge != nil {
+		a.nvp.vidmemDecRef(ctx, a.charge)
+		a.charge = nil
+	}
+}
+
+// vidmemSettleAllocLocked charges c with the footprint of device memory that
+// the driver allocated as size bytes, with handle h and parent hParent in
+// client. If that exceeds the limit, it frees the memory and returns false,
+// leaving c unchanged; the caller then fails the allocation with
+// NV_ERR_NO_MEMORY. If the driver fails to free it, the memory stays allocated
+// and charged beyond the limit, and the allocation succeeds.
+//
+// Precondition: client.objsMu must be locked.
+func (nvp *nvproxy) vidmemSettleAllocLocked(fi *frontendIoctlState, client *rootClient, c *vidmemCharge, hParent, h nvgpu.Handle, size uint64) bool {
+	if nvp.vidmemSettle(fi.ctx, c, size, false /* force */) {
+		return true
+	}
+	status, err := vidmemRMFree(fi.fd, client.handle, hParent, h)
+	if err == nil && status == nvgpu.NV_OK {
+		fi.ctx.Infof("nvproxy: GPU memory limit: refused %v:%v, which the driver allocated as %d bytes on device instance %d", client.handle, h, size, c.gpu)
+		return false
+	}
+	fi.ctx.Warningf("nvproxy: GPU memory limit: failed to free %v:%v beyond the limit (status %#x, %v); charging its %d bytes", client.handle, h, status, err, size)
+	nvp.vidmemSettle(fi.ctx, c, size, true /* force */)
+	return true
+}
+
+// vidmemRMFree is frontendRMFree; tests replace it.
+var vidmemRMFree = frontendRMFree
+
+type vidmemAllocParamsPtr[T any] interface {
+	marshalPtr[T]
+	GetSize() uint64
+	GetFlags() uint32
+}
+
+// rmAllocLocalUser implements NV_ESC_RM_ALLOC for NV01_MEMORY_LOCAL_USER. With
+// a GPU memory limit, it charges the memory against the limit and fails the
+// allocation with NV_ERR_NO_MEMORY if it would exceed it.
+func rmAllocLocalUser[Params any, PtrParams vidmemAllocParamsPtr[Params]](fi *frontendIoctlState, ioctlParams *nvgpu.NVOS64_PARAMETERS, isNVOS64 bool) (uintptr, error) {
+	nvp := fi.fd.dev.nvp
+	// The driver refuses an allocation without parameters.
+	if nvp.vidmemLimit == 0 || ioctlParams.PAllocParms == 0 {
+		return rmAllocSimple[Params, PtrParams](fi, ioctlParams, isNVOS64)
+	}
+
+	var allocParamsValue Params
+	allocParams := PtrParams(&allocParamsValue)
+	if _, err := allocParams.CopyIn(fi.t, addrFromP64(ioctlParams.PAllocParms)); err != nil {
+		return 0, err
+	}
+	a := vidmemAlloc{nvp: nvp}
+	checkLocked, addObjLocked := vidmemLocalUserCallbacks[Params, PtrParams](&a)
+	n, err := rmAllocInvokeChecked(fi, ioctlParams, &allocParamsValue, isNVOS64, checkLocked, addObjLocked)
+	a.done(fi.ctx)
+	if err != nil {
+		return n, err
+	}
+	if _, err := allocParams.CopyOut(fi.t, addrFromP64(ioctlParams.PAllocParms)); err != nil {
+		return n, err
+	}
+	return n, nil
+}
+
+// vidmemLocalUserCallbacks returns the checkLocked and addObjLocked functions
+// of rmAllocInvokeChecked for rmAllocLocalUser, which charge through a.
+func vidmemLocalUserCallbacks[Params any, PtrParams vidmemAllocParamsPtr[Params]](a *vidmemAlloc) (
+	func(*frontendIoctlState, *rootClient, *nvgpu.NVOS64_PARAMETERS, *Params) uint32,
+	func(*frontendIoctlState, *rootClient, *nvgpu.NVOS64_PARAMETERS, nvgpu.RS_ACCESS_MASK, *Params),
+) {
+	checkLocked := func(fi *frontendIoctlState, client *rootClient, ioctlParams *nvgpu.NVOS64_PARAMETERS, allocParams *Params) uint32 {
+		p := PtrParams(allocParams)
+		return a.checkLocked(fi.ctx, client, ioctlParams.HObjectParent, p.GetFlags(), p.GetSize())
+	}
+	addObjLocked := func(fi *frontendIoctlState, client *rootClient, ioctlParams *nvgpu.NVOS64_PARAMETERS, rightsRequested nvgpu.RS_ACCESS_MASK, allocParams *Params) {
+		ioctlParams.Status = a.addLocked(fi, client, ioctlParams.HObjectNew, ioctlParams.HClass, ioctlParams.HObjectParent, PtrParams(allocParams).GetSize(), func(c *vidmemCharge) objectImpl {
+			o := &vidmemObject{charge: c}
+			o.params = captureRmAllocParams(fi.fd, ioctlParams, rightsRequested, allocParams)
+			return o
+		})
+	}
+	return checkLocked, addObjLocked
+}
+
+// checkHeapLocked is checkLocked for NV_ESC_RM_VID_HEAP_CONTROL's
+// NVOS32_FUNCTION_ALLOC_SIZE with parameters p and parent hParent in client,
+// which charges only device memory, and only with a GPU memory limit.
+//
+// Precondition: client.objsMu must be locked.
+func (a *vidmemAlloc) checkHeapLocked(ctx context.Context, client *rootClient, hParent nvgpu.Handle, p *nvgpu.NVOS32AllocSize) uint32 {
+	if a.nvp.vidmemLimit == 0 || !vidmemHeapAllocatesLocalUser(p) {
+		return nvgpu.NV_OK
+	}
+	return a.checkLocked(ctx, client, hParent, p.Flags, p.Size)
+}
+
+// addHeapLocked is addLocked for the device memory with class c that
+// NVOS32_FUNCTION_ALLOC_SIZE allocated with parameters p, as they are after
+// the driver's return, and parent hParent in client.
+//
+// Precondition: client.objsMu must be locked.
+func (a *vidmemAlloc) addHeapLocked(fi *frontendIoctlState, client *rootClient, hParent nvgpu.Handle, c nvgpu.ClassID, p *nvgpu.NVOS32AllocSize) uint32 {
+	return a.addLocked(fi, client, p.HMemory, c, hParent, p.Size, func(c *vidmemCharge) objectImpl {
+		return &vidmemRef{charge: c}
+	})
+}
+
+// vidmemHeapAllocatesLocalUser returns true if NV_ESC_RM_VID_HEAP_CONTROL's
+// NVOS32_FUNCTION_ALLOC_SIZE allocates NV01_MEMORY_LOCAL_USER, device memory,
+// for p; see
+// src/nvidia/interface/deprecated/rmapi_deprecated_vidheapctrl.c:
+// _rmVidHeapControlAllocCommon().
+func vidmemHeapAllocatesLocalUser(p *nvgpu.NVOS32AllocSize) bool {
+	return p.Flags&nvgpu.NVOS32_ALLOC_FLAGS_VIRTUAL == 0 &&
+		(p.Attr2>>nvgpu.NVOS32_ATTR2_USE_EGM_SHIFT)&nvgpu.NVOS32_ATTR2_USE_EGM_MASK != nvgpu.NVOS32_ATTR2_USE_EGM_TRUE &&
+		(p.Attr>>nvgpu.NVOS32_ATTR_LOCATION_SHIFT)&nvgpu.NVOS32_ATTR_LOCATION_MASK == nvgpu.NVOS32_ATTR_LOCATION_VIDMEM
+}
+
+// rmAllocVidmemHolder returns an implementation of NV_ESC_RM_ALLOC for a class
+// whose objects the driver makes with duplicates of the objects whose handles
+// handles returns from the allocation parameters: with a GPU memory limit,
+// such an object holds their charges.
+func rmAllocVidmemHolder[Params any, PtrParams marshalPtr[Params]](handles func(*Params) []nvgpu.Handle) func(*frontendIoctlState, *nvgpu.NVOS64_PARAMETERS, bool) (uintptr, error) {
+	return func(fi *frontendIoctlState, ioctlParams *nvgpu.NVOS64_PARAMETERS, isNVOS64 bool) (uintptr, error) {
+		return rmAllocSimpleParams[Params, PtrParams](fi, ioctlParams, isNVOS64, vidmemAddHolderObjLocked(handles))
+	}
+}
+
+// vidmemAddHolderObjLocked returns the addObjLocked function of rmAllocInvoke
+// for rmAllocVidmemHolder.
+func vidmemAddHolderObjLocked[Params any](handles func(*Params) []nvgpu.Handle) func(*frontendIoctlState, *rootClient, *nvgpu.NVOS64_PARAMETERS, nvgpu.RS_ACCESS_MASK, *Params) {
+	return func(fi *frontendIoctlState, client *rootClient, ioctlParams *nvgpu.NVOS64_PARAMETERS, rightsRequested nvgpu.RS_ACCESS_MASK, allocParams *Params) {
+		var hs []nvgpu.Handle
+		if allocParams != nil {
+			hs = handles(allocParams)
+		}
+		fi.fd.dev.nvp.vidmemAddHolderLocked(fi.ctx, client, ioctlParams.HObjectNew, ioctlParams.HClass, newRmAllocObject(fi.fd, ioctlParams, rightsRequested, allocParams), ioctlParams.HObjectParent, hs...)
+	}
+}
+
+// vidmemFabricMemory returns the memory that the driver duplicates for a
+// fabric object (NV_MEMORY_FABRIC), if any; see
+// src/nvidia/src/kernel/mem_mgr/mem_fabric.c:memoryfabricConstruct_IMPL().
+func vidmemFabricMemory(p *nvgpu.NV00F8_ALLOCATION_PARAMETERS) []nvgpu.Handle {
+	return []nvgpu.Handle{p.GetHVidMem()}
+}
+
+// vidmemSemaphoreSurfaceMemory returns the memory that the driver duplicates
+// for a semaphore surface (NV_SEMAPHORE_SURFACE); see
+// src/nvidia/src/kernel/gpu/mem_mgr/sem_surf.c:_semsurfDupMemory().
+func vidmemSemaphoreSurfaceMemory(p *nvgpu.NV_SEMAPHORE_SURFACE_ALLOC_PARAMETERS) []nvgpu.Handle {
+	return []nvgpu.Handle{p.HSemaphoreMem, p.HMaxSubmittedMem}
+}
+
+// vidmemMemoryMapperSurface returns the semaphore surface that the driver
+// duplicates for a memory mapper (NV_MEMORY_MAPPER); see
+// src/nvidia/src/kernel/gpu/mem_mgr/mem_mapper.c:memmapperConstruct_IMPL().
+func vidmemMemoryMapperSurface(p *nvgpu.NV_MEMORY_MAPPER_ALLOCATION_PARAMS_V550) []nvgpu.Handle {
+	return []nvgpu.Handle{p.HSemaphoreSurface}
+}
+
+// vidmemMemoryMapperSurfaceV555 is vidmemMemoryMapperSurface for
+// NV_MEMORY_MAPPER_ALLOCATION_PARAMS_V555.
+func vidmemMemoryMapperSurfaceV555(p *nvgpu.NV_MEMORY_MAPPER_ALLOCATION_PARAMS_V555) []nvgpu.Handle {
+	return vidmemMemoryMapperSurface(&p.NV_MEMORY_MAPPER_ALLOCATION_PARAMS_V550)
+}
+
+// vidmemHoldLocked returns a charge that holds the charges of the objects with
+// handles hs in client, with a reference for the caller, or nil if none of
+// them holds a charge.
+//
+// Precondition: client.objsMu must be locked.
+func (nvp *nvproxy) vidmemHoldLocked(client *rootClient, hs ...nvgpu.Handle) *vidmemCharge {
+	var parts []*vidmemCharge
+	for _, h := range hs {
+		if h.Val == nvgpu.NV01_NULL_OBJECT {
+			continue
+		}
+		if o := client.resources[h]; o != nil {
+			if c := vidmemChargeOf(o.impl); c != nil && !slices.Contains(parts, c) {
+				parts = append(parts, c)
+			}
+		}
+	}
+	if len(parts) == 0 {
+		return nil
+	}
+	nvp.vidmemMu.Lock()
+	defer nvp.vidmemMu.Unlock()
+	for _, c := range parts {
+		nvp.vidmemIncRefLocked(c)
+	}
+	if len(parts) == 1 {
+		return parts[0]
+	}
+	return &vidmemCharge{refs: 1, parts: parts}
+}
+
+// vidmemAddHolderLocked records the object o with handle h, class c and parent
+// hParent in client, which the driver made with duplicates of the objects with
+// handles hs in client. If any of those holds a charge, o holds it too.
+//
+// Precondition: client.objsMu must be locked.
+func (nvp *nvproxy) vidmemAddHolderLocked(ctx context.Context, client *rootClient, h nvgpu.Handle, c nvgpu.ClassID, o *rmAllocObject, hParent nvgpu.Handle, hs ...nvgpu.Handle) {
+	charge := nvp.vidmemHoldLocked(client, hs...)
+	if charge == nil {
+		nvp.objAdd(ctx, client, h, c, o, hParent)
+		return
+	}
+	if !nvp.objAdd(ctx, client, h, c, &vidmemObject{rmAllocObject: *o, charge: charge}, hParent) {
+		nvp.vidmemDecRef(ctx, charge)
+	}
+}
+
+// vidmemExport is an object exported to a file that holds a charge.
+//
+// +stateify savable
+type vidmemExport struct {
+	charge *vidmemCharge
+	class  nvgpu.ClassID
+}
+
+// vidmemExportLocked records that the object with handle h in client, if any,
+// was exported to slot of the file whose memmap file is mf, replacing what the
+// slot held. The slot holds the object's charge until it is replaced or the
+// file is closed.
+//
+// Precondition: client.objsMu must be locked.
+func (nvp *nvproxy) vidmemExportLocked(ctx context.Context, client *rootClient, mf *frontendFDMemmapFile, slot uint32, h nvgpu.Handle) {
+	var e vidmemExport
+	if h.Val != nvgpu.NV01_NULL_OBJECT {
+		if o := client.resources[h]; o != nil {
+			e = vidmemExport{charge: vidmemChargeOf(o.impl), class: o.class}
+		}
+	}
+	nvp.vidmemMu.Lock()
+	defer nvp.vidmemMu.Unlock()
+	if old, ok := mf.vidmemExports[slot]; ok {
+		delete(mf.vidmemExports, slot)
+		nvp.vidmemDecRefLocked(ctx, old.charge)
+	}
+	if e.charge == nil {
+		return
+	}
+	nvp.vidmemIncRefLocked(e.charge)
+	if mf.vidmemExports == nil {
+		mf.vidmemExports = make(map[uint32]vidmemExport)
+	}
+	mf.vidmemExports[slot] = e
+}
+
+// vidmemImportLocked records that the object in slot of the file whose memmap
+// file is mf was imported with handle h and parent hParent in client. If the
+// slot holds a charge, the new handle holds it too.
+//
+// Precondition: client.objsMu must be locked.
+func (nvp *nvproxy) vidmemImportLocked(ctx context.Context, client *rootClient, mf *frontendFDMemmapFile, slot uint32, hParent, h nvgpu.Handle) {
+	nvp.vidmemMu.Lock()
+	e, ok := mf.vidmemExports[slot]
+	if ok {
+		nvp.vidmemIncRefLocked(e.charge) // for the new handle
+	}
+	nvp.vidmemMu.Unlock()
+	if !ok {
+		return
+	}
+	if hParent.Val == nvgpu.NV01_NULL_OBJECT {
+		// Free the new handle with its client at least.
+		hParent = client.handle
+	}
+	if !nvp.objAdd(ctx, client, h, e.class, &vidmemRef{charge: e.charge}, hParent) {
+		nvp.vidmemDecRef(ctx, e.charge)
+	}
+}
+
+// vidmemReleaseExports releases the charges that objects exported to the file
+// whose memmap file is mf hold, once the file is closed.
+func (nvp *nvproxy) vidmemReleaseExports(ctx context.Context, mf *frontendFDMemmapFile) {
+	nvp.vidmemMu.Lock()
+	defer nvp.vidmemMu.Unlock()
+	for slot, e := range mf.vidmemExports {
+		delete(mf.vidmemExports, slot)
+		nvp.vidmemDecRefLocked(ctx, e.charge)
+	}
+}
+
+// exportObjectHandles returns the handles in an
+// NV0000_CTRL_OS_UNIX_EXPORT_OBJECT of type
+// NV0000_CTRL_OS_UNIX_EXPORT_OBJECT_TYPE_RM; see
+// src/common/sdk/nvidia/inc/ctrl/ctrl0000/ctrl0000unix.h.
+func exportObjectHandles(o *nvgpu.NV0000_CTRL_OS_UNIX_EXPORT_OBJECT) (hDevice, hParent, hObject nvgpu.Handle) {
+	hDevice.Val = hostarch.ByteOrder.Uint32(o.Data[0:4])
+	hParent.Val = hostarch.ByteOrder.Uint32(o.Data[4:8])
+	hObject.Val = hostarch.ByteOrder.Uint32(o.Data[8:12])
+	return
+}
+
+// ctrlVidmemFD implements a control that exports objects to a file or imports
+// them from one, as ctrlHasFrontendFD does; with a GPU memory limit, it also
+// calls update, with the client locked, when the driver succeeds (see
+// vidmemFDControl).
+func ctrlVidmemFD[Params any, PtrParams hasFrontendFDPtr[Params]](update func(fi *frontendIoctlState, client *rootClient, mf *frontendFDMemmapFile, ctrlParams PtrParams)) func(*frontendIoctlState, *nvgpu.NVOS54_PARAMETERS) (uintptr, error) {
+	return func(fi *frontendIoctlState, ioctlParams *nvgpu.NVOS54_PARAMETERS) (uintptr, error) {
+		nvp := fi.fd.dev.nvp
+		if nvp.vidmemLimit == 0 {
+			return ctrlHasFrontendFD[Params, PtrParams](fi, ioctlParams)
+		}
+		var ctrlParamsValue Params
+		ctrlParams := PtrParams(&ctrlParamsValue)
+		if ctrlParams.SizeBytes() != int(ioctlParams.ParamsSize) {
+			return 0, linuxerr.EINVAL
+		}
+		if _, err := ctrlParams.CopyIn(fi.t, addrFromP64(ioctlParams.Params)); err != nil {
+			return 0, err
+		}
+		origFD := ctrlParams.GetFrontendFD()
+		fileGeneric, _ := fi.t.FDTable().Get(origFD)
+		if fileGeneric == nil {
+			return 0, linuxerr.EINVAL
+		}
+		// Released after the locks below, since the release may close the
+		// file.
+		defer fileGeneric.DecRef(fi.ctx)
+		file, ok := fileGeneric.Impl().(*frontendFD)
+		if !ok {
+			return 0, linuxerr.EINVAL
+		}
+
+		var (
+			n   uintptr
+			err error
+		)
+		if !nvp.vidmemFDControl(fi.ctx, ioctlParams.HClient, func() bool {
+			ctrlParams.SetFrontendFD(file.hostFD)
+			n, err = rmControlInvoke(fi, ioctlParams, ctrlParams)
+			ctrlParams.SetFrontendFD(origFD)
+			return err == nil && ioctlParams.Status == nvgpu.NV_OK
+		}, func(client *rootClient) {
+			update(fi, client, &file.memmapFile, ctrlParams)
+		}) {
+			return 0, frontendFailWithStatus(fi, ioctlParams, nvgpu.NV_ERR_INVALID_CLIENT)
+		}
+		if err != nil {
+			return n, err
+		}
+		if _, err := ctrlParams.CopyOut(fi.t, addrFromP64(ioctlParams.Params)); err != nil {
+			return n, err
+		}
+		return n, nil
+	}
+}
+
+// vidmemFDControl runs invoke, which calls a control that exports objects to
+// a file or imports them from one in the client with handle hClient, and if it
+// returns true, update, both with the client locked. These controls are
+// serialized, so that the slots nvproxy records change in the driver's order.
+// vidmemFDControl returns false, running neither, if nvproxy does not know the
+// client.
+func (nvp *nvproxy) vidmemFDControl(ctx context.Context, hClient nvgpu.Handle, invoke func() bool, update func(client *rootClient)) bool {
+	nvp.vidmemFDMu.Lock()
+	defer nvp.vidmemFDMu.Unlock()
+	client, unlock := nvp.getClientWithLock(ctx, hClient)
+	if client == nil {
+		return false
+	}
+	defer unlock()
+	if invoke() {
+		update(client)
+	}
+	return true
+}
+
+// vidmemExportObjectToFD updates slot 0 after
+// NV0000_CTRL_CMD_OS_UNIX_EXPORT_OBJECT_TO_FD; see
+// src/nvidia/arch/nvalloc/unix/src/os.c:cliresCtrlCmdOsUnixExportObjectToFd_IMPL().
+func vidmemExportObjectToFD(fi *frontendIoctlState, client *rootClient, mf *frontendFDMemmapFile, p *nvgpu.NV0000_CTRL_OS_UNIX_EXPORT_OBJECT_TO_FD_PARAMS) {
+	_, _, hObject := exportObjectHandles(&p.Object)
+	fi.fd.dev.nvp.vidmemExportLocked(fi.ctx, client, mf, 0, hObject)
+}
+
+// vidmemExportObjectsToFD updates the slots that
+// NV0000_CTRL_CMD_OS_UNIX_EXPORT_OBJECTS_TO_FD replaced; see
+// src/nvidia/arch/nvalloc/unix/src/os.c:cliresCtrlCmdOsUnixExportObjectsToFd_IMPL().
+func vidmemExportObjectsToFD(fi *frontendIoctlState, client *rootClient, mf *frontendFDMemmapFile, p *nvgpu.NV0000_CTRL_OS_UNIX_EXPORT_OBJECTS_TO_FD_PARAMS) {
+	for i := 0; i < int(p.NumObjects) && i < len(p.Objects); i++ {
+		fi.fd.dev.nvp.vidmemExportLocked(fi.ctx, client, mf, uint32(p.Index)+uint32(i), p.Objects[i])
+	}
+}
+
+// vidmemImportObjectFromFD records the handle that
+// NV0000_CTRL_CMD_OS_UNIX_IMPORT_OBJECT_FROM_FD imported from slot 0; see
+// src/nvidia/arch/nvalloc/unix/src/os.c:cliresCtrlCmdOsUnixImportObjectFromFd_IMPL().
+func vidmemImportObjectFromFD(fi *frontendIoctlState, client *rootClient, mf *frontendFDMemmapFile, p *nvgpu.NV0000_CTRL_OS_UNIX_IMPORT_OBJECT_FROM_FD_PARAMS) {
+	_, hParent, hObject := exportObjectHandles(&p.Object)
+	fi.fd.dev.nvp.vidmemImportLocked(fi.ctx, client, mf, 0, hParent, hObject)
+}
+
+// vidmemImportObjectsFromFD records the handles that
+// NV0000_CTRL_CMD_OS_UNIX_IMPORT_OBJECTS_FROM_FD imported; see
+// src/nvidia/arch/nvalloc/unix/src/os.c:cliresCtrlCmdOsUnixImportObjectsFromFd_IMPL().
+func vidmemImportObjectsFromFD(fi *frontendIoctlState, client *rootClient, mf *frontendFDMemmapFile, p *nvgpu.NV0000_CTRL_OS_UNIX_IMPORT_OBJECTS_FROM_FD_PARAMS) {
+	for i := 0; i < int(p.NumObjects) && i < len(p.Objects); i++ {
+		if p.Objects[i].Val != nvgpu.NV01_NULL_OBJECT {
+			fi.fd.dev.nvp.vidmemImportLocked(fi.ctx, client, mf, uint32(p.Index)+uint32(i), p.HParent, p.Objects[i])
+		}
+	}
+}
+
+// vidmemHoldRange is the range of the page reference by which an nvproxy file
+// holds another's host file open, while the driver holds the other's file
+// (NV_ESC_REGISTER_FD, UVM_MM_INITIALIZE). No mapping uses it: nvproxy's files
+// are mapped at offsets below 2^63.
+var vidmemHoldRange = memmap.FileRange{Start: ^uint64(0) - 2*uint64(hostarch.PageSize) + 1, End: ^uint64(0) - uint64(hostarch.PageSize) + 1}
+
+// vidmemHold makes mf hold the host file of ctl open until mf's own host file
+// is closed, as NV_ESC_REGISTER_FD makes the registering file hold the file of
+// its ctl_fd, with the clients allocated through it and the objects exported
+// to it (src/nvidia/arch/nvalloc/unix/src/escape.c:RmIoctl() =>
+// nv_get_file_private(), osapi.c:rm_cleanup_file_private() =>
+// nv_put_file_private()). mf's Close releases the hold.
+func (mf *frontendFDMemmapFile) vidmemHold(ctl *frontendFDMemmapFile) {
+	ctl.IncRef(vidmemHoldRange, 0 /* memCgID */)
+	mf.vidmemCtl = ctl
+}
