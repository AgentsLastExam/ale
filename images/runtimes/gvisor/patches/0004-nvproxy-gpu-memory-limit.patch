+func TestVidmemConcurrentCharges(t *testing.T) {
+	const limit = 64 * mib
+	nvp := newVidmemNVP(limit)
+	ctx := context.Background()
+	var (
+		wg      sync.WaitGroup
+		mu      sync.Mutex
+		charges []*vidmemCharge
+	)
+	for i := 0; i < 16; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for j := 0; j < 100; j++ {
+				c := nvp.vidmemTryCharge(ctx, 0, 3*mib/2)
+				if c == nil {
+					continue
+				}
+				if !nvp.vidmemSettle(ctx, c, 2*mib, false) {
+					nvp.vidmemDecRef(ctx, c)
+					continue
+				}
+				mu.Lock()
+				charges = append(charges, c)
+				mu.Unlock()
+			}
+		}()
+	}
+	wg.Wait()
+	charged := uint64(len(charges)) * 2 * mib
+	if charged == 0 || charged > limit {
+		t.Errorf("%d bytes charged, want up to %d", charged, uint64(limit))
+	}
+	checkUsed(t, nvp, map[uint32]uint64{0: charged})
+	for _, c := range charges {
+		nvp.vidmemDecRef(ctx, c)
+	}
+	checkUsed(t, nvp, nil)
+}
+
+func TestVidmemHoldRange(t *testing.T) {
+	// The hold's page reference is a whole page that no mapping can use.
+	if vidmemHoldRange.Length() != uint64(hostarch.PageSize) || vidmemHoldRange.Start%uint64(hostarch.PageSize) != 0 || vidmemHoldRange.Start < math.MaxInt64 {
+		t.Errorf("vidmemHoldRange %v", vidmemHoldRange)
+	}
+}
