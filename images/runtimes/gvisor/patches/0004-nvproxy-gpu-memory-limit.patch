+// UVM external mappings under the GPU memory limit (vidmem.go)
+//
+// UVM_MAP_EXTERNAL_ALLOCATION maps device memory, named by its RM client and
+// handle, into a UVM VA space on each of the given GPUs. For each GPU, UVM
+// duplicates the memory and keeps the duplicate while any part of the mapping
+// remains, its pieces sharing it after an unmap splits it
+// (kernel-open/nvidia-uvm/uvm_map_external.c:
+// uvm_map_external_allocation_on_gpu() => nvUvmInterfaceDupMemory(),
+// uvm_ext_gpu_map_split(), uvm_release_rm_handle()). A mapping on a GPU loses
+// the part of its range that a later UVM_MAP_EXTERNAL_ALLOCATION or a
+// UVM_UNMAP_EXTERNAL on the same GPU covers (uvm_unmap_external_in_range()),
+// and all of itself when UVM_FREE frees its external range (uvm_free()), when
+// UVM_UNREGISTER_GPU_VASPACE or UVM_UNREGISTER_GPU removes the GPU's VA space
+// (uvm_va_space.c:remove_gpu_va_space()), or when the VA space is destroyed
+// as its file is released. A UVM MM file, initialized with UVM_MM_INITIALIZE,
+// holds the VA space's file until it is released itself
+// (kernel-open/nvidia-uvm/uvm.c:uvm_api_mm_initialize() => fget(),
+// uvm_mm_release() => fput()).
+//
+// With a GPU memory limit, nvproxy mirrors this for mappings of charged
+// memory: each mapping holds the memory's charge on each GPU, and is split and
+// removed as above. Mappings that UVM also removes in UVM_DISABLE_PEER_ACCESS,
+// in UVM_UNREGISTER_GPU of the GPU that owns memory mapped on another GPU, and
+// in an UVM_MAP_EXTERNAL_ALLOCATION that fails after unmapping what its range
+// held, keep their charge until one of the above, which can only overcount.
+// nvproxy serializes these ioctls on each VA space, so that it records them in
+// the driver's order, and keeps the host file of a VA space open while a UVM
+// MM file holds it, as UVM does.
+
+import (
+	"fmt"
+	"slices"
+	"sort"
+
+	"gvisor.dev/gvisor/pkg/abi/nvgpu"
+	"gvisor.dev/gvisor/pkg/context"
+	"gvisor.dev/gvisor/pkg/errors/linuxerr"
+)
+
+// vidmemUVM holds the external ranges of a UVM VA space and its external
+// mappings of charged memory. It is protected by nvproxy.vidmemMu.
+//
+// +stateify savable
+type vidmemUVM struct {
+	// ranges maps the first address of each external range
+	// (UVM_CREATE_EXTERNAL_RANGE) to its last.
+	ranges map[uint64]uint64
+	// mappings holds, for each GPU, its mappings of charged memory, disjoint
+	// and sorted by address.
+	mappings map[nvgpu.NvUUID][]vidmemUVMMapping
+}
+
+// vidmemUVMMapping is all or part of an external mapping of charged memory on
+// one GPU. It holds a reference on charge.
+//
+// +stateify savable
+type vidmemUVMMapping struct {
+	start  uint64 // first address
+	last   uint64 // last address
+	charge *vidmemCharge
+}
+
+// vidmemUVMUnmapLocked removes [start, last] from the mappings of v on gpu.
+//
+// Precondition: nvp.vidmemMu must be locked.
+func (nvp *nvproxy) vidmemUVMUnmapLocked(ctx context.Context, v *vidmemUVM, gpu nvgpu.NvUUID, start, last uint64) {
+	ms := v.mappings[gpu]
+	i := sort.Search(len(ms), func(i int) bool { return ms[i].last >= start })
+	j := i
+	var rest []vidmemUVMMapping
+	for ; j < len(ms) && ms[j].start <= last; j++ {
+		m := ms[j]
+		if m.start < start {
+			rest = append(rest, vidmemUVMMapping{start: m.start, last: start - 1, charge: m.charge})
+			nvp.vidmemIncRefLocked(m.charge)
+		}
+		if m.last > last {
+			rest = append(rest, vidmemUVMMapping{start: last + 1, last: m.last, charge: m.charge})
+			nvp.vidmemIncRefLocked(m.charge)
+		}
+		nvp.vidmemDecRefLocked(ctx, m.charge)
+	}
+	if i == j {
+		return
+	}
+	v.setMappings(gpu, slices.Replace(ms, i, j, rest...))
+}
+
+// vidmemUVMMapLocked records a mapping of [start, last] on gpu, which replaces
+// what the range held there, of the memory that c charges, if not nil.
+//
+// Precondition: nvp.vidmemMu must be locked.
+func (nvp *nvproxy) vidmemUVMMapLocked(ctx context.Context, v *vidmemUVM, gpu nvgpu.NvUUID, start, last uint64, c *vidmemCharge) {
+	nvp.vidmemUVMUnmapLocked(ctx, v, gpu, start, last)
+	if c == nil {
+		return
+	}
+	nvp.vidmemIncRefLocked(c)
+	ms := v.mappings[gpu]
+	i := sort.Search(len(ms), func(i int) bool { return ms[i].start > start })
+	v.setMappings(gpu, slices.Insert(ms, i, vidmemUVMMapping{start: start, last: last, charge: c}))
+}
+
+// createRangeLocked records the external range [start, last].
+//
+// Precondition: nvp.vidmemMu must be locked.
+func (v *vidmemUVM) createRangeLocked(start, last uint64) {
+	if v.ranges == nil {
+		v.ranges = make(map[uint64]uint64)
+	}
+	v.ranges[start] = last
+}
+
+// vidmemUVMFreeLocked removes the external range that starts at start, and the
+// mappings in it.
+//
+// Precondition: nvp.vidmemMu must be locked.
+func (nvp *nvproxy) vidmemUVMFreeLocked(ctx context.Context, v *vidmemUVM, start uint64) {
+	last, ok := v.ranges[start]
+	if !ok {
+		return
+	}
+	delete(v.ranges, start)
+	for gpu, ms := range v.mappings {
+		i := sort.Search(len(ms), func(i int) bool { return ms[i].start >= start })
+		j := i
+		for ; j < len(ms) && ms[j].start <= last; j++ {
+			nvp.vidmemDecRefLocked(ctx, ms[j].charge)
+		}
+		if i != j {
+			v.setMappings(gpu, slices.Delete(ms, i, j))
+		}
+	}
+}
+
+// vidmemUVMRemoveGPULocked removes the mappings of v on gpu.
+//
+// Precondition: nvp.vidmemMu must be locked.
+func (nvp *nvproxy) vidmemUVMRemoveGPULocked(ctx context.Context, v *vidmemUVM, gpu nvgpu.NvUUID) {
+	for _, m := range v.mappings[gpu] {
+		nvp.vidmemDecRefLocked(ctx, m.charge)
+	}
+	delete(v.mappings, gpu)
+}
+
+// vidmemUVMReleaseLocked removes all ranges and mappings of v, whose VA space
+// was destroyed.
+//
+// Precondition: nvp.vidmemMu must be locked.
+func (nvp *nvproxy) vidmemUVMReleaseLocked(ctx context.Context, v *vidmemUVM) {
+	for gpu := range v.mappings {
+		nvp.vidmemUVMRemoveGPULocked(ctx, v, gpu)
+	}
+	v.ranges = nil
+}
+
+func (v *vidmemUVM) setMappings(gpu nvgpu.NvUUID, ms []vidmemUVMMapping) {
+	if len(ms) == 0 {
+		delete(v.mappings, gpu)
+		return
+	}
+	if v.mappings == nil {
+		v.mappings = make(map[nvgpu.NvUUID][]vidmemUVMMapping)
+	}
+	v.mappings[gpu] = ms
+}
+
+// vidmemTracked returns true if the VA space of mf is tracked under a GPU
+// memory limit.
+func (mf *uvmFDMemmapFile) vidmemTracked() bool {
+	return mf.nvp != nil && mf.nvp.vidmemLimit != 0
+}
+
+// vidmemUnref calls unref, which drops a reference to the host file of mf.
+// Once that has closed the host file, which destroys the VA space, since a UVM
+// MM file that holds it keeps it open (vidmemHold), vidmemUnref releases the
+// charges of its mappings, and the VA space file that mf holds as a UVM MM
+// file, if any. mf.vidmemCloseMu serializes these calls, so that the closing
+// of the host file is seen once and without a data race.
+func (mf *uvmFDMemmapFile) vidmemUnref(unref func()) {
+	mf.vidmemCloseMu.Lock()
+	unref()
+	closed := !mf.vidmemClosed && mf.FD() < 0
+	var held *uvmFDMemmapFile
+	if closed {
+		mf.vidmemClosed = true
+		held, mf.vidmemHeld = mf.vidmemHeld, nil
+	}
+	mf.vidmemCloseMu.Unlock()
+	if !closed {
+		return
+	}
+	mf.nvp.vidmemMu.Lock()
+	mf.nvp.vidmemUVMReleaseLocked(context.Background(), &mf.vidmem)
+	mf.nvp.vidmemMu.Unlock()
+	if held != nil {
+		held.DecRef(vidmemHoldRange)
+	}
+}
+
+// vidmemHold makes mf, a UVM MM file, hold the host file of the VA space file
+// va open until mf's own host file is closed, as UVM_MM_INITIALIZE makes the
+// MM file hold the VA space's file.
+func (mf *uvmFDMemmapFile) vidmemHold(va *uvmFDMemmapFile) {
+	va.IncRef(vidmemHoldRange, 0 /* memCgID */)
+	mf.vidmemCloseMu.Lock()
+	mf.vidmemHeld = va
+	mf.vidmemCloseMu.Unlock()
+}
+
+// uvmExternalAllocation returns the fields of UVM_MAP_EXTERNAL_ALLOCATION's
+// parameters that the GPU memory limit uses.
+func uvmExternalAllocation(params any) (base, length uint64, gpus []nvgpu.UvmGpuMappingAttributes, hClient, hMemory nvgpu.Handle) {
+	switch p := params.(type) {
+	case *nvgpu.UVM_MAP_EXTERNAL_ALLOCATION_PARAMS:
+		return p.Base, p.Length, p.PerGPUAttributes[:min(p.GPUAttributesCount, uint64(len(p.PerGPUAttributes)))], nvgpu.Handle{Val: p.HClient}, nvgpu.Handle{Val: p.HMemory}
+	case *nvgpu.UVM_MAP_EXTERNAL_ALLOCATION_PARAMS_V550:
+		return p.Base, p.Length, p.PerGPUAttributes[:min(p.GPUAttributesCount, uint64(len(p.PerGPUAttributes)))], nvgpu.Handle{Val: p.HClient}, nvgpu.Handle{Val: p.HMemory}
+	default:
+		panic(fmt.Sprintf("nvproxy: unknown UVM_MAP_EXTERNAL_ALLOCATION parameters %T", params))
+	}
+}
+
+// uvmMapExternalAllocation implements UVM_MAP_EXTERNAL_ALLOCATION. With a GPU
+// memory limit, the mapping holds the charge of the memory it maps.
+func uvmMapExternalAllocation[Params any, PtrParams hasFrontendFDAndStatusPtr[Params]](ui *uvmIoctlState) (uintptr, error) {
+	nvp := ui.nvp
+	if nvp.vidmemLimit == 0 || ui.fd == nil {
+		return uvmIoctlHasFrontendFD[Params, PtrParams](ui)
+	}
+	var ioctlParamsValue Params
+	ioctlParams := PtrParams(&ioctlParamsValue)
+	if _, err := ioctlParams.CopyIn(ui.t, ui.ioctlParamsAddr); err != nil {
+		return 0, err
+	}
+	base, length, gpus, hClient, hMemory := uvmExternalAllocation(ioctlParams)
+
+	// Translate the frontend FD, if any, before vidmemUVMMapExternal locks the
+	// client, and release it after, since the release may close the file.
+	origFD := ioctlParams.GetFrontendFD()
+	if origFD >= 0 {
+		ctlFileGeneric, _ := ui.t.FDTable().Get(origFD)
+		if ctlFileGeneric == nil {
+			return 0, linuxerr.EINVAL
+		}
+		defer ctlFileGeneric.DecRef(ui.ctx)
+		ctlFile, ok := ctlFileGeneric.Impl().(*frontendFD)
+		if !ok {
+			return 0, linuxerr.EINVAL
+		}
+		ioctlParams.SetFrontendFD(ctlFile.hostFD)
+	}
+	var (
+		n   uintptr
+		err error
+	)
+	nvp.vidmemUVMMapExternal(ui.ctx, &ui.fd.memmapFile, hClient, hMemory, base, length, gpus, func() bool {
+		n, err = uvmIoctlInvoke(ui, ioctlParams)
+		return err == nil && ioctlParams.GetStatus() == nvgpu.NV_OK
+	})
+	ioctlParams.SetFrontendFD(origFD)
+	if err != nil {
+		return n, err
+	}
+	if _, err := ioctlParams.CopyOut(ui.t, ui.ioctlParamsAddr); err != nil {
+		return n, err
+	}
+	return n, nil
+}
+
+// vidmemUVMMapExternal runs invoke, which calls UVM_MAP_EXTERNAL_ALLOCATION to
+// map the memory with handle hMemory in the client with handle hClient at
+// [base, base+length) on gpus in the VA space of mf, and if it returns true,
+// records the mapping. The client stays locked meanwhile, so that the handle
+// cannot be freed, and reused for other memory, before UVM duplicates it.
+func (nvp *nvproxy) vidmemUVMMapExternal(ctx context.Context, mf *uvmFDMemmapFile, hClient, hMemory nvgpu.Handle, base, length uint64, gpus []nvgpu.UvmGpuMappingAttributes, invoke func() bool) {
+	mf.vidmemOpMu.Lock()
+	defer mf.vidmemOpMu.Unlock()
+	var charge *vidmemCharge
+	if client, unlock := nvp.getClientWithLock(ctx, hClient); client != nil {
+		defer unlock()
+		if o := client.resources[hMemory]; o != nil {
+			charge = vidmemChargeOf(o.impl)
+		}
+	}
+	if !invoke() || length == 0 {
+		return
+	}
+	nvp.vidmemMu.Lock()
+	defer nvp.vidmemMu.Unlock()
+	for i := range gpus {
+		nvp.vidmemUVMMapLocked(ctx, &mf.vidmem, gpus[i].GPUUUID, base, base+length-1, charge)
+	}
+}
+
+// uvmIoctlVidmem returns an implementation of a UVM ioctl that removes
+// external ranges or mappings: uvmIoctlSimple, which with a GPU memory limit
+// also calls update when the driver succeeds.
+func uvmIoctlVidmem[Params any, PtrParams hasStatusPtr[Params]](update func(ctx context.Context, nvp *nvproxy, v *vidmemUVM, p PtrParams)) func(*uvmIoctlState) (uintptr, error) {
+	return func(ui *uvmIoctlState) (uintptr, error) {
+		nvp := ui.nvp
+		if nvp.vidmemLimit == 0 || ui.fd == nil {
+			return uvmIoctlSimple[Params, PtrParams](ui)
+		}
+		var ioctlParamsValue Params
+		ioctlParams := PtrParams(&ioctlParamsValue)
+		if _, err := ioctlParams.CopyIn(ui.t, ui.ioctlParamsAddr); err != nil {
+			return 0, err
+		}
+		mf := &ui.fd.memmapFile
+		mf.vidmemOpMu.Lock()
+		n, err := uvmIoctlInvoke(ui, ioctlParams)
+		if err == nil && ioctlParams.GetStatus() == nvgpu.NV_OK {
+			nvp.vidmemMu.Lock()
+			update(ui.ctx, nvp, &mf.vidmem, ioctlParams)
+			nvp.vidmemMu.Unlock()
+		}
+		mf.vidmemOpMu.Unlock()
+		if err != nil {
+			return n, err
+		}
+		if _, err := ioctlParams.CopyOut(ui.t, ui.ioctlParamsAddr); err != nil {
+			return n, err
+		}
+		return n, nil
+	}
+}
+
+func vidmemUVMCreateExternalRange(ctx context.Context, nvp *nvproxy, v *vidmemUVM, p *nvgpu.UVM_CREATE_EXTERNAL_RANGE_PARAMS) {
+	if p.Length != 0 {
+		v.createRangeLocked(p.Base, p.Base+p.Length-1)
+	}
+}
+
+func vidmemUVMUnmapExternal(ctx context.Context, nvp *nvproxy, v *vidmemUVM, p *nvgpu.UVM_UNMAP_EXTERNAL_PARAMS) {
+	if p.Length != 0 {
+		nvp.vidmemUVMUnmapLocked(ctx, v, p.GPUUUID, p.Base, p.Base+p.Length-1)
+	}
+}
+
+func vidmemUVMFree(ctx context.Context, nvp *nvproxy, v *vidmemUVM, p *nvgpu.UVM_FREE_PARAMS) {
+	nvp.vidmemUVMFreeLocked(ctx, v, p.Base)
+}
+
+func vidmemUVMFreeV590(ctx context.Context, nvp *nvproxy, v *vidmemUVM, p *nvgpu.UVM_FREE_PARAMS_V590) {
+	nvp.vidmemUVMFreeLocked(ctx, v, p.Base)
+}
+
+func vidmemUVMUnregisterGPUVASpace(ctx context.Context, nvp *nvproxy, v *vidmemUVM, p *nvgpu.UVM_UNREGISTER_GPU_VASPACE_PARAMS) {
+	nvp.vidmemUVMRemoveGPULocked(ctx, v, p.GPUUUID)
+}
+
+func vidmemUVMUnregisterGPU(ctx context.Context, nvp *nvproxy, v *vidmemUVM, p *nvgpu.UVM_UNREGISTER_GPU_PARAMS) {
+	nvp.vidmemUVMRemoveGPULocked(ctx, v, p.GPUUUID)
+}
