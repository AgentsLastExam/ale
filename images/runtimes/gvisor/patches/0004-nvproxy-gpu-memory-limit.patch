+func TestVidmemFDControl(t *testing.T) {
+	nvp := newVidmemNVP(4 * mib)
+	client := addClient(nvp, 0x1000, 0)
+	ctx := context.Background()
+	for _, ok := range []bool{true, false} {
+		updated := false
+		if !nvp.vidmemFDControl(ctx, h(0x1000), func() bool {
+			// The control runs serialized, with the client locked.
+			if nvp.vidmemFDMu.TryLock() {
+				nvp.vidmemFDMu.Unlock()
+				t.Error("control invoked without vidmemFDMu")
+			}
+			if client.objsMu.mu.TryLock() {
+				client.objsMu.mu.Unlock()
+				t.Error("control invoked with the client unlocked")
+			}
+			return ok
+		}, func(c *rootClient) {
+			if c != client {
+				t.Errorf("updated client %p, want %p", c, client)
+			}
+			updated = true
+		}) {
+			t.Error("known client refused")
+		}
+		if updated != ok {
+			t.Errorf("control returned %t, but update ran: %t", ok, updated)
+		}
+	}
+	if nvp.vidmemFDControl(ctx, h(0x9999), func() bool {
+		t.Error("control invoked for an unknown client")
+		return true
+	}, func(*rootClient) {}) {
+		t.Error("unknown client accepted")
+	}
+}
