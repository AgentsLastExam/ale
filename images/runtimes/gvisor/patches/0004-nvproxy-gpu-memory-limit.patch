+func TestVidmemChargeAndRefuse(t *testing.T) {
+	nvp := newVidmemNVP(2 * mib)
+	client := addClient(nvp, 0x1000, 3, 5)
+	dev3, subdev5 := h(0x1001), h(0x1101)
+
+	// A 4 KiB allocation takes 64 KiB.
+	if !alloc(t, nvp, client, dev3, h(0x2000), 4*kib, 4*kib) {
+		t.Fatal("4 KiB refused")
+	}
+	checkUsed(t, nvp, map[uint32]uint64{3: 64 * kib})
+	// Up to the limit, by subdevice too, and on another GPU.
+	if !alloc(t, nvp, client, dev3, h(0x2001), 2*mib-64*kib, 2*mib-64*kib) {
+		t.Fatal("allocation up to the limit refused")
+	}
+	if !alloc(t, nvp, client, subdev5, h(0x2002), 2*mib, 2*mib) {
+		t.Fatal("allocation on another GPU refused")
+	}
+	checkUsed(t, nvp, map[uint32]uint64{3: 2 * mib, 5: 2 * mib})
+	// Beyond it, refused before calling the driver.
+	freed := fakeRMFree(t, nvgpu.NV_OK)
+	if status := allocFlags(nvp, client, dev3, h(0x2003), 0, 1, 1); status != nvgpu.NV_ERR_NO_MEMORY {
+		t.Errorf("allocation beyond the limit: status %#x, want NV_ERR_NO_MEMORY", status)
+	}
+	if alloc(t, nvp, client, dev3, h(0x2003), ^uint64(0), ^uint64(0)) {
+		t.Error("allocation of 2^64-1 bytes succeeded")
+	}
+	if len(*freed) != 0 {
+		t.Errorf("freed %v, want nothing", *freed)
+	}
+	if tracked(client, h(0x2003)) != nil {
+		t.Error("refused allocation is tracked")
+	}
+	checkUsed(t, nvp, map[uint32]uint64{3: 2 * mib, 5: 2 * mib})
+	// Freeing returns the memory.
+	free(nvp, client, h(0x2001))
+	checkUsed(t, nvp, map[uint32]uint64{3: 64 * kib, 5: 2 * mib})
+	if !alloc(t, nvp, client, dev3, h(0x2003), mib, mib) {
+		t.Error("allocation after a free refused")
+	}
+	checkUsed(t, nvp, map[uint32]uint64{3: mib + 64*kib, 5: 2 * mib})
+}
