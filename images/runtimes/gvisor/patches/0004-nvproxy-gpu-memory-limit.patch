+func TestVidmemUVMMMHold(t *testing.T) {
+	nvp := newVidmemNVP(4 * mib)
+	client := addClient(nvp, 0x1000, 0)
+	va, mm := newUVMFile(t, nvp), newUVMFile(t, nvp)
