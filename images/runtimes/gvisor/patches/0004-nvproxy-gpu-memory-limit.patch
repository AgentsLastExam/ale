+func TestVidmemExportImport(t *testing.T) {
+	nvp := newVidmemNVP(4 * mib)
+	exporter := addClient(nvp, 0x1000, 0)
+	importer := addClient(nvp, 0x3000, 0)
+	fi := newVidmemFI(nvp)
+	mf := &frontendFDMemmapFile{nvp: nvp, hostFD: -1}
+	if !alloc(t, nvp, exporter, h(0x1001), h(0x2000), mib, mib) ||
