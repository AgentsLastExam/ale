+// fakeRMFree replaces the driver's NV_ESC_RM_FREE for the duration of a test
+// and returns the handles it frees.
+func fakeRMFree(t *testing.T, status uint32) *[]nvgpu.Handle {
+	var freed []nvgpu.Handle
+	orig := vidmemRMFree
+	vidmemRMFree = func(fd *frontendFD, hClient, hParent, h nvgpu.Handle) (uint32, error) {
+		freed = append(freed, h)
+		return status, nil
+	}
+	t.Cleanup(func() { vidmemRMFree = orig })
+	return &freed
+}
