+func TestVidmemRegisterFDHold(t *testing.T) {
+	nvp := newVidmemNVP(4 * mib)
+	client := addClient(nvp, 0x1000, 0)
+	ctl, dev := newFrontendFile(t), newFrontendFile(t)
+	if !alloc(t, nvp, client, h(0x1001), h(0x2000), 2*mib, 2*mib) {
+		t.Fatal("2 MiB refused")
+	}
+	exporter := addClient(nvp, 0x3000, 0)
+	if !alloc(t, nvp, exporter, h(0x3001), h(0x4000), mib, mib) {
+		t.Fatal("1 MiB refused")
+	}
+	exporter.objsMu.Lock()
+	nvp.vidmemExportLocked(context.Background(), exporter, ctl, 0, h(0x4000))
+	exporter.objsMu.Unlock()
+	free(nvp, exporter, h(0x4000))
+	// NV_ESC_REGISTER_FD registers dev with ctl, through which the client
+	// was allocated and to which the memory was exported.
+	dev.vidmemHold(ctl)
+	// Closing ctl keeps its host file, clients and exports while dev holds
+	// it.
+	releaseFrontendFile(nvp, ctl, client)
