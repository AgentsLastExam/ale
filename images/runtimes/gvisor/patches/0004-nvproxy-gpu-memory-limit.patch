+
+func h(v uint32) nvgpu.Handle {
+	return nvgpu.Handle{Val: v}
+}
+
+func newVidmemNVP(limit uint64) *nvproxy {
+	return &nvproxy{
+		clients:       make(map[nvgpu.Handle]*rootClient),
+		vidmemLimit:   limit,
+		vidmemUsed:    make(map[uint32]uint64),
+		vidmemCharges: make(map[*vidmemCharge]struct{}),
+	}
+}
+
+func newVidmemFI(nvp *nvproxy) *frontendIoctlState {
+	return &frontendIoctlState{
+		fd:  &frontendFD{dev: &frontendDevice{nvp: nvp}, hostFD: -1},
+		ctx: context.Background(),
+	}
+}
+
+// addClient adds a client with handle hClient and, for each device instance
+// in gpus, a device with handle hClient+1+i and a subdevice with handle
+// hClient+0x100+i.
+func addClient(nvp *nvproxy, hClient uint32, gpus ...uint32) *rootClient {
+	ctx := context.Background()
+	client := &rootClient{
+		resources: make(map[nvgpu.Handle]*object),
+		params:    capturedRmAllocParams{fd: &frontendFD{}},
+	}
+	nvp.clients[h(hClient)] = client
+	client.objsMu.Lock()
+	defer client.objsMu.Unlock()
+	nvp.objAdd(ctx, client, h(hClient), nvgpu.NV01_ROOT_CLIENT, client, h(0))
+	for i, gpu := range gpus {
+		hDev := h(hClient + 1 + uint32(i))
+		addDevice(nvp, client, hDev, gpu)
+		nvp.objAdd(ctx, client, h(hClient+0x100+uint32(i)), nvgpu.NV20_SUBDEVICE_0, &rmAllocObject{}, hDev)
+	}
+	return client
+}
+
+// addDevice adds a device with handle hDev and device instance gpu to client.
+//
+// Precondition: client.objsMu must be locked.
+func addDevice(nvp *nvproxy, client *rootClient, hDev nvgpu.Handle, gpu uint32) {
+	params := nvgpu.NV0080_ALLOC_PARAMETERS{DeviceID: gpu}
+	buf := make([]byte, params.SizeBytes())
+	params.MarshalBytes(buf)
+	nvp.objAdd(context.Background(), client, hDev, nvgpu.NV01_DEVICE_0, &rmAllocObject{params: capturedRmAllocParams{allocParams: buf}}, client.handle)
+}
+
+// allocFlags allocates device memory with handle hMem, parent hParent and the
+// given flags in client as rmAllocLocalUser does, for a request of requested
+// bytes that the driver allocates as allocated bytes, or fails if allocated is
+// 0. It returns the status of the allocation.
+func allocFlags(nvp *nvproxy, client *rootClient, hParent, hMem nvgpu.Handle, flags uint32, requested, allocated uint64) uint32 {
+	fi := newVidmemFI(nvp)
+	a := vidmemAlloc{nvp: nvp}
+	checkLocked, addObjLocked := vidmemLocalUserCallbacks[nvgpu.NV_MEMORY_ALLOCATION_PARAMS](&a)
+	ioctlParams := nvgpu.NVOS64_PARAMETERS{
+		HRoot:         client.handle,
+		HObjectParent: hParent,
+		HObjectNew:    hMem,
+		HClass:        nvgpu.NV01_MEMORY_LOCAL_USER,
+	}
+	params := nvgpu.NV_MEMORY_ALLOCATION_PARAMS{Flags: flags, Size: requested}
+	// As rmAllocInvokeChecked does.
+	client.objsMu.Lock()
+	ioctlParams.Status = checkLocked(fi, client, &ioctlParams, &params)
+	if ioctlParams.Status == nvgpu.NV_OK {
+		// The driver allocates.
+		if allocated == 0 {
+			ioctlParams.Status = nvgpu.NV_ERR_NO_MEMORY
+		} else {
+			params.Size = allocated
+			addObjLocked(fi, client, &ioctlParams, nvgpu.RS_ACCESS_MASK{}, &params)
+		}
+	}
+	client.objsMu.Unlock()
+	a.done(fi.ctx)
+	return ioctlParams.Status
+}
+
+// alloc is allocFlags without flags. It returns false if the allocation
+// failed.
+func alloc(t *testing.T, nvp *nvproxy, client *rootClient, hParent, hMem nvgpu.Handle, requested, allocated uint64) bool {
+	t.Helper()
+	return allocFlags(nvp, client, hParent, hMem, 0, requested, allocated) == nvgpu.NV_OK
+}
+
+func free(nvp *nvproxy, client *rootClient, hObj nvgpu.Handle) {
+	client.objsMu.Lock()
+	releases := nvp.objFree(context.Background(), client, hObj)
+	client.objsMu.Unlock()
+	for _, release := range releases {
+		release()
+	}
+}
+
+func dup(nvp *nvproxy, dst, src *rootClient, hDst, hParentDst, hSrc nvgpu.Handle) {
+	src.objsMu.Lock()
+	dst.objsMu.Lock()
+	nvp.objDup(context.Background(), dst, src, hDst, hParentDst, hSrc)
+	dst.objsMu.Unlock()
+	src.objsMu.Unlock()
+}
+
+func tracked(client *rootClient, hObj nvgpu.Handle) *object {
+	client.objsMu.Lock()
+	defer client.objsMu.Unlock()
+	return client.resources[hObj]
+}
+
+// checkUsed checks the charges on each GPU, and that they add up.
+func checkUsed(t *testing.T, nvp *nvproxy, want map[uint32]uint64) {
+	t.Helper()
+	nvp.vidmemMu.Lock()
+	defer nvp.vidmemMu.Unlock()
+	sums := make(map[uint32]uint64)
+	for c := range nvp.vidmemCharges {
+		if c.refs <= 0 {
+			t.Errorf("charge %+v is registered without holders", *c)
+		}
+		if c.parts != nil {
+			t.Errorf("charge %+v that holds others is registered", *c)
+		}
+		sums[c.gpu] += c.size
+	}
+	for gpu, used := range nvp.vidmemUsed {
+		if sums[gpu] != used {
+			t.Errorf("device instance %d: charges add up to %d, but %d is used", gpu, sums[gpu], used)
+		}
+		if used > nvp.vidmemLimit {
+			t.Errorf("device instance %d: %d used beyond the limit %d", gpu, used, nvp.vidmemLimit)
+		}
+	}
+	for gpu := range sums {
+		if _, ok := nvp.vidmemUsed[gpu]; !ok {
+			t.Errorf("device instance %d: charges add up to %d, but none is used", gpu, sums[gpu])
+		}
+	}
+	for gpu, w := range want {
+		if got := nvp.vidmemUsed[gpu]; got != w {
+			t.Errorf("device instance %d: %d used, want %d", gpu, got, w)
+		}
+	}
+	for gpu, got := range nvp.vidmemUsed {
+		if _, ok := want[gpu]; !ok {
+			t.Errorf("device instance %d: %d used, want 0", gpu, got)
+		}
+	}
+}
