+func TestVidmemHolders(t *testing.T) {
+	nvp := newVidmemNVP(8 * mib)
+	client := addClient(nvp, 0x1000, 0)
+	other := addClient(nvp, 0x3000, 0)
+	fi := newVidmemFI(nvp)
+	if !alloc(t, nvp, client, h(0x1001), h(0x2000), mib, mib) ||
+		!alloc(t, nvp, client, h(0x1001), h(0x2001), 2*mib, 2*mib) ||
+		!alloc(t, nvp, client, h(0x1001), h(0x2002), 4*mib, 4*mib) {
+		t.Fatal("allocation refused")
+	}
+	addObj := func(hNew nvgpu.Handle, class nvgpu.ClassID, f func(*nvgpu.NVOS64_PARAMETERS)) {
+		ioctlParams := nvgpu.NVOS64_PARAMETERS{HRoot: h(0x1000), HObjectParent: h(0x1100), HObjectNew: hNew, HClass: class}
+		client.objsMu.Lock()
+		f(&ioctlParams)
+		client.objsMu.Unlock()
+	}
+	// A semaphore surface on two memory objects, one on a single one twice,
+	// and a memory mapper on the first surface.
+	addObj(h(0x5000), nvgpu.NV_SEMAPHORE_SURFACE, func(ioctlParams *nvgpu.NVOS64_PARAMETERS) {
+		vidmemAddHolderObjLocked(vidmemSemaphoreSurfaceMemory)(fi, client, ioctlParams, nvgpu.RS_ACCESS_MASK{}, &nvgpu.NV_SEMAPHORE_SURFACE_ALLOC_PARAMETERS{HSemaphoreMem: h(0x2000), HMaxSubmittedMem: h(0x2001)})
+	})
+	addObj(h(0x5001), nvgpu.NV_SEMAPHORE_SURFACE, func(ioctlParams *nvgpu.NVOS64_PARAMETERS) {
+		vidmemAddHolderObjLocked(vidmemSemaphoreSurfaceMemory)(fi, client, ioctlParams, nvgpu.RS_ACCESS_MASK{}, &nvgpu.NV_SEMAPHORE_SURFACE_ALLOC_PARAMETERS{HSemaphoreMem: h(0x2002), HMaxSubmittedMem: h(0x2002)})
+	})
+	addObj(h(0x5002), nvgpu.NV_MEMORY_MAPPER, func(ioctlParams *nvgpu.NVOS64_PARAMETERS) {
+		p := nvgpu.NV_MEMORY_MAPPER_ALLOCATION_PARAMS_V555{}
+		p.HSemaphoreSurface = h(0x5000)
+		vidmemAddHolderObjLocked(vidmemMemoryMapperSurfaceV555)(fi, client, ioctlParams, nvgpu.RS_ACCESS_MASK{}, &p)
+	})
+	// A duplicate of the second surface.
+	dup(nvp, other, client, h(0x6000), h(0x3001), h(0x5001))
+	// The memory stays while the surfaces hold it.
+	for _, hMem := range []nvgpu.Handle{h(0x2000), h(0x2001), h(0x2002)} {
+		free(nvp, client, hMem)
+	}
+	checkUsed(t, nvp, map[uint32]uint64{0: 7 * mib})
+	free(nvp, client, h(0x5001))
+	checkUsed(t, nvp, map[uint32]uint64{0: 7 * mib})
+	free(nvp, other, h(0x6000))
+	checkUsed(t, nvp, map[uint32]uint64{0: 3 * mib})
+	// The mapper keeps the first surface's memory after the surface is freed.
+	free(nvp, client, h(0x5000))
+	checkUsed(t, nvp, map[uint32]uint64{0: 3 * mib})
+	free(nvp, client, h(0x5002))
+	checkUsed(t, nvp, nil)
+}
