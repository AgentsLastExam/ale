+	client.objsMu.Lock()
+	addDevice(nvp, client, h(0x1001), 0)
+	client.objsMu.Unlock()
+	checkUsed(t, nvp, map[uint32]uint64{0: mib})
+	// It reuses the memory's handle too: the charge that the duplicate holds
+	// is not released again.
+	if !alloc(t, nvp, client, h(0x1001), h(0x2000), 64*kib, 64*kib) {
+		t.Fatal("64 KiB refused")
