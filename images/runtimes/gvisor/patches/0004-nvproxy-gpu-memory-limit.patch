+func TestVidmemUVMConcurrentClose(t *testing.T) {
+	nvp := newVidmemNVP(4 * mib)
+	client := addClient(nvp, 0x1000, 0)
+	for i := 0; i < 20; i++ {
+		mf := newUVMFile(t, nvp)
+		if !alloc(t, nvp, client, h(0x1001), h(0x2000), mib, mib) {
+			t.Fatal("1 MiB refused")
+		}
+		mapUVM(nvp, mf, client, h(0x2000), 0x7f0000000000, mib, nvgpu.NvUUID{0: 1})
+		free(nvp, client, h(0x2000))
+		// The last page references and the release race to close the host
+		// file; the mappings are released once.
+		var frs []memmap.FileRange
+		for j := uint64(0); j < 8; j++ {
+			fr := memmap.FileRange{Start: 0x7f0000000000 + j*uint64(hostarch.PageSize), End: 0x7f0000000000 + (j+1)*uint64(hostarch.PageSize)}
+			mf.IncRef(fr, 0)
+			frs = append(frs, fr)
+		}
+		var wg sync.WaitGroup
+		for _, fr := range frs {
+			wg.Add(1)
+			go func() {
+				defer wg.Done()
+				mf.DecRef(fr)
+			}()
+		}
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			mf.MappableRelease()
+		}()
+		wg.Wait()
+		if mf.FD() >= 0 {
+			t.Fatal("host file still open")
+		}
+		checkUsed(t, nvp, nil)
+	}
+}
