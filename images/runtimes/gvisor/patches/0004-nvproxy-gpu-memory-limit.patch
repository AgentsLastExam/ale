+func TestVidmemSettleBeyondLimit(t *testing.T) {
+	nvp := newVidmemNVP(2 * mib)
+	client := addClient(nvp, 0x1000, 0)
+	dev := h(0x1001)
+	if !alloc(t, nvp, client, dev, h(0x2000), mib, mib) {
+		t.Fatal("1 MiB refused")
+	}
+
+	// The driver rounds 768 KiB up to a 2 MiB page: freed and refused.
+	freed := fakeRMFree(t, nvgpu.NV_OK)
+	if alloc(t, nvp, client, dev, h(0x2001), 768*kib, 2*mib) {
+		t.Error("allocation that the driver rounded beyond the limit succeeded")
+	}
+	if len(*freed) != 1 || (*freed)[0] != h(0x2001) {
+		t.Errorf("freed %v, want [%v]", *freed, h(0x2001))
+	}
+	checkUsed(t, nvp, map[uint32]uint64{0: mib})
+	if tracked(client, h(0x2001)) != nil {
+		t.Error("refused allocation is tracked")
+	}
+
+	// Rounding within the limit is charged.
+	if !alloc(t, nvp, client, dev, h(0x2002), 100*kib, 512*kib) {
+		t.Error("allocation rounded within the limit refused")
+	}
+	checkUsed(t, nvp, map[uint32]uint64{0: mib + 512*kib})
+
+	// If the driver cannot free it, the memory stays charged.
+	fakeRMFree(t, nvgpu.NV_ERR_INVALID_OBJECT_HANDLE)
+	if !alloc(t, nvp, client, dev, h(0x2003), 64*kib, 2*mib) {
+		t.Error("allocation the driver failed to free was refused")
+	}
+	nvp.vidmemMu.Lock()
+	if got, want := nvp.vidmemUsed[0], 3*mib+512*kib; got != want {
+		t.Errorf("%d used, want %d", got, want)
+	}
+	nvp.vidmemMu.Unlock()
+	free(nvp, client, h(0x2003))
+	checkUsed(t, nvp, map[uint32]uint64{0: mib + 512*kib})
+}
