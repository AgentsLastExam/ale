diff --git a/pkg/sentry/socket/netstack/stack.go b/pkg/sentry/socket/netstack/stack.go
index b429974..cb56ada 100644
--- a/pkg/sentry/socket/netstack/stack.go
+++ b/pkg/sentry/socket/netstack/stack.go
@@ -235,16 +235,29 @@ func (s *Stack) SetInterface(ctx context.Context, msg *nlmsg.Message) *syserr.Er
 			return syserr.ErrNotSupported
 		}
 	}
-	flags := msg.Header().Flags
-	if ifinfomsg.Index == 0 {
-		if flags&linux.NLM_F_CREATE != 0 {
-			return s.newInterface(ctx, msg, attrs)
+	hdr := msg.Header()
+	if hdr.Type == linux.RTM_SETLINK {
+		// Linux's rtnl_setlink only changes an existing interface: it ignores
+		// NLM_F_CREATE, NLM_F_EXCL and NLM_F_REPLACE, which only RTM_NEWLINK
+		// takes, and fails with EINVAL when the request names no interface.
+		if ifinfomsg.Index == 0 {
+			if _, ok := attrs[linux.IFLA_IFNAME]; !ok {
+				return syserr.ErrInvalidArgument
+			}
+			return syserr.ErrNoDevice
+		}
+	} else {
+		flags := hdr.Flags
+		if ifinfomsg.Index == 0 {
+			if flags&linux.NLM_F_CREATE != 0 {
+				return s.newInterface(ctx, msg, attrs)
+			}
+			return syserr.ErrNoDevice
 		}
-		return syserr.ErrNoDevice
-	}
 
-	if flags&(linux.NLM_F_EXCL|linux.NLM_F_REPLACE) != 0 {
-		return syserr.ErrExists
+		if flags&(linux.NLM_F_EXCL|linux.NLM_F_REPLACE) != 0 {
+			return syserr.ErrExists
+		}
 	}
 
 	dstNs, err := s.lockSrcAndDst(ctx, attrs)
diff --git a/test/syscalls/linux/socket_netlink_route.cc b/test/syscalls/linux/socket_netlink_route.cc
index a920ce0..b267dc6 100644
--- a/test/syscalls/linux/socket_netlink_route.cc
+++ b/test/syscalls/linux/socket_netlink_route.cc
@@ -6154,6 +6154,130 @@ TEST(NetlinkRouteTest, NonGetRequestsRequireCapNetAdmin) {
   EXPECT_TRUE(got_eperm) << "Did not get an EPERM from the kernel.";
 }
 
+// EnterNewNetns moves the calling thread into a new network namespace and
+// returns a Cleanup that moves it back.
+PosixErrorOr<Cleanup> EnterNewNetns() {
+  ASSIGN_OR_RETURN_ERRNO(FileDescriptor netns,
+                         Open("/proc/thread-self/ns/net", O_RDONLY));
+  RETURN_ERROR_IF_SYSCALL_FAIL(unshare(CLONE_NEWNET));
+  const int fd = netns.release();
+  return Cleanup([fd] {
+    TEST_CHECK_SUCCESS(setns(fd, CLONE_NEWNET));
+    close(fd);
+  });
+}
+
+// LinkAttrs are the attributes of one link in an RTM_NEWLINK message.
+struct LinkAttrs {
+  int index = 0;
+  std::string name;
+  uint32_t link = 0;
+  uint32_t master = 0;
+  uint16_t nlmsg_flags = 0;
+};
+
+LinkAttrs ParseLinkAttrs(const struct nlmsghdr* hdr) {
+  LinkAttrs attrs;
+  attrs.nlmsg_flags = hdr->nlmsg_flags;
+  const struct ifinfomsg* ifi =
+      reinterpret_cast<const struct ifinfomsg*>(NLMSG_DATA(hdr));
+  attrs.index = ifi->ifi_index;
+  int len = IFLA_PAYLOAD(hdr);
+  for (const struct rtattr* rta = IFLA_RTA(ifi); RTA_OK(rta, len);
+       rta = RTA_NEXT(rta, len)) {
+    switch (rta->rta_type) {
+      case IFLA_IFNAME:
+        attrs.name = reinterpret_cast<const char*>(RTA_DATA(rta));
+        break;
+      case IFLA_LINK:
+        attrs.link = *reinterpret_cast<const uint32_t*>(RTA_DATA(rta));
+        break;
+      case IFLA_MASTER:
+        attrs.master = *reinterpret_cast<const uint32_t*>(RTA_DATA(rta));
+        break;
+    }
+  }
+  return attrs;
+}
+
+// DumpLinkAttrs dumps the links with request req, of length len, and returns
+// them by name.
+PosixErrorOr<std::map<std::string, LinkAttrs>> DumpLinkAttrs(
+    const FileDescriptor& fd, void* req, size_t len) {
+  std::map<std::string, LinkAttrs> links;
+  RETURN_IF_ERRNO(NetlinkRequestResponse(
+      fd, req, len,
+      [&](const struct nlmsghdr* hdr) {
+        if (hdr->nlmsg_type != RTM_NEWLINK) {
+          return;
+        }
+        LinkAttrs attrs = ParseLinkAttrs(hdr);
+        links[attrs.name] = attrs;
+      },
+      false));
+  return links;
+}
+
+PosixErrorOr<std::map<std::string, LinkAttrs>> DumpLinkAttrs(
+    const FileDescriptor& fd) {
+  struct {
+    struct nlmsghdr hdr;
+    struct ifinfomsg ifm;
+  } req = {};
+  req.hdr.nlmsg_len = sizeof(req);
+  req.hdr.nlmsg_type = RTM_GETLINK;
+  req.hdr.nlmsg_flags = NLM_F_REQUEST | NLM_F_DUMP;
+  req.hdr.nlmsg_seq = kSeq;
+  req.ifm.ifi_family = AF_UNSPEC;
+  return DumpLinkAttrs(fd, &req, sizeof(req));
+}
+
+// RTM_SETLINK changes an existing link only. Like Linux's rtnl_setlink(), it
+// ignores NLM_F_CREATE, NLM_F_EXCL and NLM_F_REPLACE, which netavark sets when
+// it brings a link up.
+TEST(NetlinkRouteTest, SetLinkIgnoresNewLinkFlags) {
+  SKIP_IF(!ASSERT_NO_ERRNO_AND_VALUE(HaveCapability(CAP_NET_ADMIN)));
+  SKIP_IF(!ASSERT_NO_ERRNO_AND_VALUE(HaveCapability(CAP_SYS_ADMIN)));
+  SKIP_IF(IsRunningWithHostinet());
+  Cleanup restore = ASSERT_NO_ERRNO_AND_VALUE(EnterNewNetns());
+
+  FileDescriptor fd =
+      ASSERT_NO_ERRNO_AND_VALUE(NetlinkBoundSocket(NETLINK_ROUTE));
+  const Link lo = ASSERT_NO_ERRNO_AND_VALUE(LoopbackLink());
+
+  struct {
+    struct nlmsghdr hdr;
+    struct ifinfomsg ifm;
+    char buf[64];
+  } req = {};
+  req.hdr.nlmsg_len = NLMSG_LENGTH(sizeof(struct ifinfomsg));
+  req.hdr.nlmsg_type = RTM_SETLINK;
+  req.hdr.nlmsg_flags =
+      NLM_F_REQUEST | NLM_F_ACK | NLM_F_EXCL | NLM_F_CREATE | NLM_F_REPLACE;
+  req.hdr.nlmsg_seq = kSeq;
+  req.ifm.ifi_family = AF_UNSPEC;
+  req.ifm.ifi_index = lo.index;
+  req.ifm.ifi_flags = IFF_UP;
+  req.ifm.ifi_change = IFF_UP;
+  EXPECT_NO_ERRNO(NetlinkRequestAckOrError(fd, kSeq, &req, req.hdr.nlmsg_len));
+  EXPECT_NE(ASSERT_NO_ERRNO_AND_VALUE(LoopbackLink()).flags & IFF_UP, 0);
+
+  // A name that no link has: ENODEV, and no link is created.
+  req.hdr.nlmsg_len = NLMSG_LENGTH(sizeof(struct ifinfomsg));
+  req.ifm.ifi_index = 0;
+  addattr(&req.hdr, sizeof(req), IFLA_IFNAME, "nosuchlink0",
+          strlen("nosuchlink0"));
+  EXPECT_THAT(NetlinkRequestAckOrError(fd, kSeq, &req, req.hdr.nlmsg_len),
+              PosixErrorIs(ENODEV, ::testing::_));
+  EXPECT_EQ(ASSERT_NO_ERRNO_AND_VALUE(DumpLinkAttrs(fd)).count("nosuchlink0"),
+            0);
+
+  // Neither an index nor a name: EINVAL.
+  req.hdr.nlmsg_len = NLMSG_LENGTH(sizeof(struct ifinfomsg));
+  EXPECT_THAT(NetlinkRequestAckOrError(fd, kSeq, &req, req.hdr.nlmsg_len),
+              PosixErrorIs(EINVAL, ::testing::_));
+}
+
