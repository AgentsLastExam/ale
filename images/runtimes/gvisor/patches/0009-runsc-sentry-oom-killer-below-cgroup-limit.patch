+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package kernel
+
+import (
+	"time"
+
+	"gvisor.dev/gvisor/pkg/abi/linux"
+	"gvisor.dev/gvisor/pkg/hostarch"
+	"gvisor.dev/gvisor/pkg/log"
+	"gvisor.dev/gvisor/pkg/sentry/mm"
+	"gvisor.dev/gvisor/pkg/sentry/pgalloc"
+	"gvisor.dev/gvisor/pkg/sync"
+)
+
+// oomKiller ends the application process that uses the most memory when an
+// allocation is refused by the MemoryFile's pgalloc.HostMemoryLimit, as a
+// guest kernel's OOM killer would, so that the host's OOM killer, whose
+// victims free nothing until the Sentry releases their memory, is not the one
+// that acts.
+//
+// Each round kills at most one thread group and waits until its memory is
+// released; tasks whose allocation was refused wait for the round and retry.
+type oomKiller struct {
+	k     *Kernel
+	limit *pgalloc.HostMemoryLimit
+	kick  chan struct{}
+
+	mu sync.Mutex
+	// done is closed when the round in progress ends. It is nil when no
+	// round is in progress.
+	done chan struct{}
+	// kills counts the thread groups killed, by the memory cgroup ID of each
+	// victim's leader when it was killed.
+	kills map[uint32]uint64
+}
+
+// OOMKills returns how many processes the OOM killer ended in the memory
+// cgroups with the given IDs, as cgroup v1's memory.oom_control reports
+// oom_kill.
+func (k *Kernel) OOMKills(memCgIDs map[uint32]struct{}) uint64 {
+	o := k.oom
+	if o == nil {
+		return 0
+	}
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	var n uint64
+	for id := range memCgIDs {
+		n += o.kills[id]
+	}
+	return n
+}
+
+// EnableOOMKiller makes the kernel kill application processes when mf's host
+// memory limit refuses an allocation. It must be called before the
+// application starts.
+func (k *Kernel) EnableOOMKiller() {
+	limit := k.mf.HostMemoryLimit()
+	if limit == nil {
+		return
+	}
+	o := &oomKiller{k: k, limit: limit, kick: make(chan struct{}, 1), kills: make(map[uint32]uint64)}
+	limit.SetOnExceeded(func() { o.request() })
+	k.oom = o
+	go o.run() // S/R-SAFE: no state is kept across rounds.
+}
+
+// request returns a channel that is closed when the round in progress, or the
+// one this starts, ends. It does not block.
+func (o *oomKiller) request() chan struct{} {
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if o.done == nil {
+		o.done = make(chan struct{})
+		select {
+		case o.kick <- struct{}{}:
+		default:
+		}
+	}
+	return o.done
+}
+
+// waitForOOMKill blocks t until the OOM killer has freed memory after one of
+// t's allocations was refused with pgalloc.ErrMemoryLimit. It returns false if
+// the kernel has no OOM killer, in which case the caller must fail as before.
+func (t *Task) waitForOOMKill() bool {
+	o := t.k.oom
+	if o == nil {
+		return false
+	}
+	// A SIGKILL, such as the OOM killer's, interrupts the wait.
+	t.BlockWithTimeout(o.request(), true, 2*time.Second)
+	return true
+}
+
+func (o *oomKiller) run() {
+	for range o.kick {
+		o.round()
+		o.mu.Lock()
+		close(o.done)
+		o.done = nil
+		o.mu.Unlock()
+	}
+}
+
+// round frees memory for the last refused allocation, killing one thread group
+// if waiting for the MemoryFile's releaser is not enough.
+func (o *oomKiller) round() {
+	mf := o.k.mf
+	if !o.released(mf, 500*time.Millisecond) {
+		return
+	}
+	current, limit := o.limit.Usage()
+	totalPages := limit / hostarch.PageSize
+	victim := o.selectVictim(totalPages)
+	if victim == nil {
+		// Nothing to kill: let allocations reach the host's limit, as
+		// without this OOM killer.
+		log.Warningf("Out of memory: no process to kill; memory.current %d of %d", current, limit)
+		o.limit.Allow(16 << 20)
+		return
+	}
+	log.Warningf("Out of memory: Killed process %d (%s) rss:%dkB oom_score_adj:%d points:%d; host cgroup memory.current %d of %d",
+		victim.pid, victim.name, victim.rss>>10, victim.adj, victim.points, current, limit)
+	// Counted before the kill, so that whoever sees the victim gone also sees
+	// the count.
+	o.mu.Lock()
+	o.kills[victim.memCgID]++
+	o.mu.Unlock()
+	victim.tg.SendSignal(&linux.SignalInfo{
+		Signo: int32(linux.SIGKILL),
+		Code:  linux.SI_KERNEL,
+	})
+	start := time.Now()
+	for !victim.tg.oomVictimGone() {
+		if time.Since(start) > 2*time.Second {
+			log.Warningf("OOM victim %d has not exited after %v", victim.pid, time.Since(start))
+			return
+		}
+		time.Sleep(time.Millisecond)
+	}
+	o.released(mf, 500*time.Millisecond)
+	log.Infof("OOM victim %d gone after %v", victim.pid, time.Since(start))
+}
+
+// released waits up to timeout for mf's releaser to decommit freed memory and
+// returns true if the last refused allocation still does not fit.
+func (o *oomKiller) released(mf *pgalloc.MemoryFile, timeout time.Duration) bool {
+	start := time.Now()
+	for mf.HasWaste() && time.Since(start) < timeout {
+		time.Sleep(time.Millisecond)
+	}
+	return o.limit.Exceeded(0)
+}
+
+type oomCandidate struct {
+	tg      *ThreadGroup
+	mm      *mm.MemoryManager
+	pid     ThreadID
+	name    string
+	memCgID uint32
+	adj     int32
+	rss     uint64
+	points  int64
+}
+
+// selectVictim returns the thread group with the highest badness, computed as
+// Linux's oom_badness() does: its resident set in pages plus oom_score_adj
+// thousandths of the memory limit in pages. As Linux spares the global init,
+// it never chooses the root PID namespace's init, whose end ends the sandbox,
+// nor a process whose oom_score_adj is -1000.
+func (o *oomKiller) selectVictim(totalPages uint64) *oomCandidate {
+	ts := o.k.tasks
+	var cands []oomCandidate
+	ts.mu.RLock()
+	for tg, pid := range ts.Root.tgids {
+		adj := tg.oomScoreAdj.Load()
+		if adj == -1000 || pid == initTID {
+			continue
+		}
+		if sh := tg.signalHandlers; sh != nil {
+			sh.mu.Lock()
+			exiting := tg.exiting
+			sh.mu.Unlock()
+			if exiting {
+				continue
+			}
+		}
+		var m *mm.MemoryManager
+		var name string
+		for t := tg.tasks.Front(); t != nil && m == nil; t = t.Next() {
+			t.mu.Lock()
+			if tm := t.image.MemoryManager; tm != nil && tm.IncUsers() {
+				m = tm
+				name = t.image.Name
+			}
+			t.mu.Unlock()
+		}
+		if m == nil {
+			continue
+		}
+		var memCgID uint32
+		if tg.leader != nil {
+			memCgID = tg.leader.memCgID.Load()
+		}
+		cands = append(cands, oomCandidate{tg: tg, mm: m, pid: pid, name: name, memCgID: memCgID, adj: adj})
+	}
+	ts.mu.RUnlock()
+
+	ctx := o.k.SupervisorContext()
+	var best *oomCandidate
+	for i := range cands {
+		c := &cands[i]
+		c.rss = c.mm.ResidentSetSize()
+		c.points = int64(c.rss/hostarch.PageSize) + int64(c.adj)*int64(totalPages)/1000
+		c.mm.DecUsers(ctx)
+		c.mm = nil
+		if best == nil || c.points > best.points {
+			best = c
+		}
+	}
+	return best
+}
+
+// oomVictimGone returns true if every task in tg has released its resources.
+func (tg *ThreadGroup) oomVictimGone() bool {
+	tg.pidns.owner.mu.RLock()
+	defer tg.pidns.owner.mu.RUnlock()
+	for t := tg.tasks.Front(); t != nil; t = t.Next() {
+		if t.exitStateLocked() < TaskExitZombie {
+			return false
+		}
+	}
+	return true
+}
