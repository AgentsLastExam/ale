+)
+
+// ErrMemoryLimit is returned by MemoryFile.Allocate when the allocation would
+// take the host memory cgroup that contains the sandbox within the headroom
+// of its limit. The caller may wait for the kernel's OOM killer to free memory
+// (see HostMemoryLimit.OnExceeded) and retry.
+var ErrMemoryLimit = errors.New(errno.ENOMEM, "sandbox memory limit reached")
+
+// HostMemoryLimit keeps the memory charged to the host memory cgroup that
+// contains the sandbox below that cgroup's limit, minus a headroom.
+//
+// The application's memory is committed to the MemoryFile, which the host
+// charges to the cgroup but which only the Sentry can release. When the host's
+// OOM killer ends an application process (a stub) because the cgroup is full,
+// nothing is freed until the Sentry has torn the process down and decommitted
+// its memory; if anything in the cgroup charges memory meanwhile, as the
+// Sentry itself does, the host's OOM killer ends more stubs and then the
+// Sentry. Without swap the host cannot reclaim the MemoryFile, so the sandbox
+// must not let the application fill the cgroup: allocations stop at the
+// headroom, and the Sentry's own OOM killer frees memory first.
+type HostMemoryLimit struct {
+	current  *os.File
+	stat     *os.File
+	max      *os.File
+	headroom uint64
+
+	// onExceeded is called, without blocking, when an allocation is refused.
+	onExceeded func()
+
+	// budget is the number of bytes that may still be allocated before
+	// memory.current is read again.
+	budget atomicbitops.Int64
+
+	// refused is the length of the last refused allocation.
+	refused atomicbitops.Uint64
+
+	// mu serializes reads of the cgroup files.
+	mu sync.Mutex
+}
+
+// NewHostMemoryLimit returns a HostMemoryLimit for the cgroup whose
+// memory.current, memory.stat and memory.max are open in the given files.
+func NewHostMemoryLimit(current, stat, max *os.File, headroom uint64) *HostMemoryLimit {
+	return &HostMemoryLimit{current: current, stat: stat, max: max, headroom: headroom}
+}
+
+// SetOnExceeded sets the function called, without blocking and possibly with
+// locks held, when an allocation is refused.
+func (l *HostMemoryLimit) SetOnExceeded(f func()) {
+	l.onExceeded = f
+}
+
+// SetHostMemoryLimit makes f refuse allocations that would take the host
+// memory cgroup within the headroom of its limit.
+func (f *MemoryFile) SetHostMemoryLimit(l *HostMemoryLimit) {
+	f.hostLimit = l
+}
+
+// HostMemoryLimit returns the limit set by SetHostMemoryLimit, or nil.
+func (f *MemoryFile) HostMemoryLimit() *HostMemoryLimit {
+	return f.hostLimit
+}
+
+// check returns ErrMemoryLimit if allocating length bytes would take the
+// cgroup within the headroom of its limit.
+func (l *HostMemoryLimit) check(length uint64) error {
+	if l.budget.Add(-int64(length)) >= 0 {
+		return nil
+	}
+	if l.Exceeded(length) {
+		l.refused.Store(length)
+		if l.onExceeded != nil {
+			l.onExceeded()
+		}
+		return ErrMemoryLimit
+	}
+	return nil
+}
+
+// Exceeded reads the cgroup and returns true if allocating length more bytes
+// would take it within the headroom of its limit. Length 0 asks about the last
+// refused allocation instead.
+func (l *HostMemoryLimit) Exceeded(length uint64) bool {
+	if length == 0 {
+		length = l.refused.Load()
+	}
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	limit, ok := readCgroupUint(l.max)
+	if !ok || limit == math.MaxUint64 {
+		// No limit; look again after 64 MB.
+		l.budget.Store(64 << 20)
+		return false
+	}
+	current, ok := readCgroupUint(l.current)
+	if !ok {
+		l.budget.Store(64 << 20)
+		return false
+	}
+	threshold := int64(limit) - int64(l.headroom)
+	room := threshold - int64(current) - int64(length)
+	if room >= 0 {
+		// Read again after half the room: allocations are counted by
+		// length, but the Sentry's own memory is not.
+		l.budget.Store(room / 2)
+		return false
+	}
+	// Close to the limit, every allocation reads the cgroup.
+	l.budget.Store(0)
+	// The host can still reclaim the cgroup's file cache, which is on the
+	// file LRUs; the MemoryFile (shmem) is on the anonymous ones.
+	return room+int64(readReclaimable(l.stat)) < 0
+}
+
+// Allow lets the next n bytes be allocated without reading the cgroup.
+func (l *HostMemoryLimit) Allow(n int64) {
+	l.budget.Store(n)
+}
+
+// HasWaste returns true if f has freed pages that its releaser has not yet
+// decommitted.
+func (f *MemoryFile) HasWaste() bool {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return f.haveWaste
+}
+
+// Usage returns the cgroup's memory.current and memory.max.
+func (l *HostMemoryLimit) Usage() (current, limit uint64) {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	current, _ = readCgroupUint(l.current)
+	limit, _ = readCgroupUint(l.max)
+	return current, limit
+}
+
+var statBufPool = sync.Pool{New: func() any { b := make([]byte, 8192); return &b }}
+
+func readCgroupUint(f *os.File) (uint64, bool) {
+	var buf [32]byte
+	n, err := f.ReadAt(buf[:], 0)
+	if n == 0 {
+		log.Warningf("Reading %s: %v", f.Name(), err)
+		return 0, false
+	}
+	s := bytes.TrimSpace(buf[:n])
+	if string(s) == "max" {
+		return math.MaxUint64, true
+	}
+	v, err := strconv.ParseUint(string(s), 10, 64)
+	if err != nil {
+		log.Warningf("Parsing %s %q: %v", f.Name(), s, err)
+		return 0, false
+	}
+	return v, true
+}
+
+// readReclaimable returns the bytes on the cgroup's file LRUs.
+func readReclaimable(f *os.File) uint64 {
+	bp := statBufPool.Get().(*[]byte)
+	defer statBufPool.Put(bp)
+	n, _ := f.ReadAt(*bp, 0)
+	var total uint64
+	for _, line := range bytes.Split((*bp)[:n], []byte{'\n'}) {
+		key, value, ok := bytes.Cut(line, []byte{' '})
+		if !ok {
+			continue
+		}
+		switch string(key) {
+		case "active_file", "inactive_file":
+			if v, err := strconv.ParseUint(string(value), 10, 64); err == nil {
+				total += v
+			}
+		}
+	}
+	return total
+}
