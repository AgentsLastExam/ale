+// memoryOOMControlData implements vfs.DynamicBytesSource for memory.oom_control.
+// As in Linux, oom_kill counts the processes of the cgroup and its descendants
+// that the kernel's OOM killer ended; the OOM killer cannot be disabled.
+//
+// +stateify savable
+type memoryOOMControlData struct {
+	memCg *memoryCgroup
+}
+
+// Generate implements vfs.DynamicBytesSource.Generate.
+func (d *memoryOOMControlData) Generate(ctx context.Context, buf *bytes.Buffer) error {
+	k := kernel.KernelFromContext(ctx)
+	memCgIDs := make(map[uint32]struct{})
+	d.memCg.collectMemCgIDs(memCgIDs)
+	fmt.Fprintf(buf, "oom_kill_disable 0\nunder_oom 0\noom_kill %d\n", k.OOMKills(memCgIDs))
+	return nil
+}
