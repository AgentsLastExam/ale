+
+// memoryCgroupFiles opens memory.current, memory.stat and memory.max of the
+// cgroup v2 that limits the sandbox's memory, for the Sentry to keep its
+// memory below the limit (config.Config.MemoryLimitHeadroom). It returns nil
+// if the cgroup is not v2, or if it may swap: the host can then reclaim the
+// Sentry's memory file, and the host's OOM killer is left to act as before.
+func memoryCgroupFiles(cg cgroup.Cgroup) []*os.File {
+	dir := cg.MakePath("memory")
+	read := func(dir, name string) string {
+		data, err := os.ReadFile(filepath.Join(dir, name))
+		if err != nil {
+			return ""
+		}
+		return strings.TrimSpace(string(data))
+	}
+	if read(dir, "memory.current") == "" {
+		return nil
+	}
+	// As cgroup.MemoryLimit does: under systemd the limit may be on the
+	// parent.
+	if read(dir, "memory.max") == "max" {
+		if parent := filepath.Dir(dir); read(parent, "memory.max") != "" && read(parent, "memory.max") != "max" {
+			dir = parent
+		}
+	}
+	if swap := read(dir, "memory.swap.max"); swap != "" && swap != "0" && hostHasSwap() {
+		log.Infof("Memory cgroup %s may swap; leaving its limit to the host", dir)
+		return nil
+	}
+	var files []*os.File
+	for _, name := range []string{"memory.current", "memory.stat", "memory.max"} {
+		f, err := os.Open(filepath.Join(dir, name))
+		if err != nil {
+			log.Warningf("Cannot open %s: %v", filepath.Join(dir, name), err)
+			for _, f := range files {
+				f.Close()
+			}
+			return nil
+		}
+		files = append(files, f)
+	}
+	log.Infof("Sandbox keeps memory below the limit of %s", dir)
+	return files
+}
+
+// hostHasSwap returns true if the host has any swap space.
+func hostHasSwap() bool {
+	data, err := os.ReadFile("/proc/meminfo")
+	if err != nil {
+		return true
+	}
+	for _, line := range strings.Split(string(data), "\n") {
+		if fields := strings.Fields(line); len(fields) >= 2 && fields[0] == "SwapTotal:" {
+			return fields[1] != "0"
+		}
+	}
+	return true
+}
