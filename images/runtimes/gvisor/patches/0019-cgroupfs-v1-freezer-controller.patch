+// SyncCgroupFreezer stops t while one of its cgroups is freezing, and lets it
+// run again once none is, as cgroup v1's freezer controller does in Linux's
+// kernel/cgroup/legacy_freezer.c. cgroupfs calls it for each task of a cgroup
+// whose freezer.state changes, and the kernel for a task that is created in a
+// cgroup or moves to another. It does not wait for t to stop.
+func (t *Task) SyncCgroupFreezer() {
+	sh := t.tg.signalLock()
+	defer sh.mu.Unlock()
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	t.syncCgroupFreezerLocked()
+}
+
+// Preconditions: The signal mutex must be locked.
+//
+// +checklocks:t.mu
+func (t *Task) syncCgroupFreezerLocked() {
+	// As in Linux, a task that has started to exit is not frozen.
+	freeze := false
+	if !t.cgroupFreezerExempt.Load() && !t.tg.cgroupFreezerExempt.Load() && t.ExitState() == TaskExitNone {
+		for c := range t.cgroups {
+			if c.Freezing() {
+				freeze = true
+				break
+			}
+		}
+	}
+	if freeze == t.cgroupFrozen.Load() {
+		return
+	}
+	if !freeze {
+		t.thawCgroupFreezerLocked()
+		return
+	}
+	t.cgroupFrozen.Store(true)
+	t.beginStopLocked()
+	t.interrupt()
+}
+
+// thawCgroupFreezerLocked ends the stop of cgroup v1's freezer on t.
+//
+// Preconditions: The signal mutex must be locked. t.cgroupFrozen is true.
+func (t *Task) thawCgroupFreezerLocked() {
+	t.cgroupFrozen.Store(false)
+	// t.canReceiveSignalLocked() skips frozen tasks, so we may need to handle
+	// signals that were sent while we were frozen.
+	if (t.pendingSignals.pendingSet.RacyLoad()|t.tg.pendingSignals.pendingSet.RacyLoad())&^t.signalMask.RacyLoad() != 0 {
+		t.interrupt()
+	}
+	t.endStopLocked()
+}
+
+// exemptFromCgroupFreezerLocked thaws t if cgroup v1's freezer stops it, and
+// keeps the freezer from stopping it again.
+//
+// Preconditions: The signal mutex must be locked.
+func (t *Task) exemptFromCgroupFreezerLocked() {
+	t.cgroupFreezerExempt.Store(true)
+	if t.cgroupFrozen.Load() {
+		t.thawCgroupFreezerLocked()
+	}
+}
+
+// exemptFromCgroupFreezer exempts tg from cgroup v1's freezer, as Linux's
+// mm/oom_kill.c:mark_oom_victim() thaws the OOM killer's victim, which could
+// not free its memory while frozen. The exemption is the thread group's, so a
+// thread created after it, while the group is being killed, does not start
+// frozen either (the publication gap the OOM killer would otherwise leave:
+// it signals the group after exempting the threads it can see).
+func (tg *ThreadGroup) exemptFromCgroupFreezer() {
+	tg.pidns.owner.mu.RLock()
+	defer tg.pidns.owner.mu.RUnlock()
+	tg.signalHandlers.mu.Lock()
+	defer tg.signalHandlers.mu.Unlock()
+	tg.exemptFromCgroupFreezerLocked()
+}
+
+// exemptFromCgroupFreezerLocked is exemptFromCgroupFreezer with the signal
+// mutex held.
+//
+// Preconditions: The signal mutex must be locked.
+func (tg *ThreadGroup) exemptFromCgroupFreezerLocked() {
+	tg.cgroupFreezerExempt.Store(true)
+	for t := tg.tasks.Front(); t != nil; t = t.Next() {
+		if t.cgroupFrozen.Load() {
+			t.thawCgroupFreezerLocked()
+		}
+	}
+}
+
+// CgroupFreezerFrozen returns true if t keeps no freezing cgroup from being
+// FROZEN: cgroup v1's freezer has stopped it, or will not stop it because it
+// is exiting or exempt. It is a snapshot in time.
+func (t *Task) CgroupFreezerFrozen() bool {
+	if !t.cgroupFrozen.Load() {
+		return t.cgroupFreezerExempt.Load() || t.tg.cgroupFreezerExempt.Load() || t.ExitState() != TaskExitNone
+	}
+	// A task that has not started yet stops before it runs.
+	switch t.TaskGoroutineState() {
+	case TaskGoroutineStopped, TaskGoroutineNonexistent:
+		return true
+	default:
+		return false
+	}
+}
