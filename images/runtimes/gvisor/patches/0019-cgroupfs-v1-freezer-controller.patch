+// canMigrateCgroup reports whether the writer in ctx may move a task owned by
+// targetCreds into a cgroup, as Linux's
+// kernel/cgroup/cgroup-v1.c:__cgroup1_procs_write() checks on a write to a
+// cgroup v1 cgroup.procs or tasks: the writer's effective UID must be the
+// global root, or equal the target's real or saved UID. gVisor does not check
+// this elsewhere; where a freezer subtree is delegated writable to another
+// user, the check keeps that user from moving, and so freezing, a process it
+// does not own (patch 0019).
+func canMigrateCgroup(ctx context.Context, targetCreds *auth.Credentials) bool {
+	creds := auth.CredentialsFromContext(ctx)
+	if creds == nil {
+		return true
+	}
+	euid := creds.EffectiveKUID
+	return euid == auth.RootKUID || euid == targetCreds.RealKUID || euid == targetCreds.SavedKUID
+}
