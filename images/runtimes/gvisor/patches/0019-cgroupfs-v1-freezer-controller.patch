+  Cgroup a = Child(*top_, "ale_freezer_a");
+  Cgroup b = Child(a, "b");
+  Counters* n = MapCounters();
+  pid_t busy = ForkCounter(&n->busy, false);
+  auto kill_busy = Cleanup([busy] { KillAndReap(busy); });
+  pid_t sleeping = ForkCounter(&n->sleeping, true);
+  auto kill_sleeping = Cleanup([sleeping] { KillAndReap(sleeping); });
+  auto thaw = Thaw(a);
+  ASSERT_NO_ERRNO(a.Enter(busy));
+  ASSERT_NO_ERRNO(b.Enter(sleeping));
+  ASSERT_TRUE(Moves(&n->busy));
+  ASSERT_TRUE(Moves(&n->sleeping));
+
+  ASSERT_NO_ERRNO(a.WriteControlFile("freezer.state", "FROZEN"));
+  ASSERT_NO_ERRNO(WaitForFreezerState(a, "FROZEN"));
+  EXPECT_THAT(b.ReadControlFile("freezer.state"),
+              IsPosixErrorOkAndHolds("FROZEN\n"));
+  EXPECT_TRUE(Stopped(&n->busy));
+  EXPECT_TRUE(Stopped(&n->sleeping));
+  // A frozen task is not stopped as SIGSTOP stops it: wait does not report
+  // it, and /proc shows it in uninterruptible sleep.
+  int status;
+  EXPECT_THAT(waitpid(busy, &status, WNOHANG | WUNTRACED),
+              SyscallSucceedsWithValue(0));
+  EXPECT_EQ(ProcState(busy), 'D');
+  EXPECT_EQ(ProcState(sleeping), 'D');
+
+  ASSERT_NO_ERRNO(a.WriteControlFile("freezer.state", "THAWED"));
+  EXPECT_THAT(a.ReadControlFile("freezer.state"),
+              IsPosixErrorOkAndHolds("THAWED\n"));
+  EXPECT_TRUE(Moves(&n->busy));
+  EXPECT_TRUE(Moves(&n->sleeping));
+}
