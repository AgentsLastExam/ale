+  Cgroup c = Child(b, "c");
+  EXPECT_THAT(c.ReadControlFile("freezer.state"),
+              IsPosixErrorOkAndHolds("FROZEN\n"));
+  EXPECT_THAT(c.ReadControlFile("freezer.parent_freezing"),
+              IsPosixErrorOkAndHolds("1\n"));
+
+  // Thawing a descendant of a freezing cgroup changes nothing.
