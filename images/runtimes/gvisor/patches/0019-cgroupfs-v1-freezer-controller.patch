+  EXPECT_THAT(a.ReadControlFile("freezer.self_freezing"),
+              IsPosixErrorOkAndHolds("1\n"));
+  EXPECT_THAT(a.ReadControlFile("freezer.parent_freezing"),
+              IsPosixErrorOkAndHolds("0\n"));
+  EXPECT_THAT(b.ReadControlFile("freezer.state"),
