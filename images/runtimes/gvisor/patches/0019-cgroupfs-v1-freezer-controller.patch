+TEST_F(CgroupFreezer, KilledTaskExitsWhenThawed) {
+  const DisableSave ds;  // Timing-sensitive.
+  Cgroup a = Child(*top_, "ale_freezer_a");
+  Counters* n = MapCounters();
+  pid_t pid = ForkCounter(&n->busy, false);
+  auto kill_pid = Cleanup([pid] { KillAndReap(pid); });
+  auto thaw = Thaw(a);
+  ASSERT_NO_ERRNO(a.Enter(pid));
+  ASSERT_NO_ERRNO(a.WriteControlFile("freezer.state", "FROZEN"));
+  ASSERT_NO_ERRNO(WaitForFreezerState(a, "FROZEN"));
+
+  // As in Linux, a frozen task that is sent SIGKILL exits once it is thawed.
+  ASSERT_THAT(kill(pid, SIGKILL), SyscallSucceeds());
+  absl::SleepFor(absl::Milliseconds(200));
+  int status;
+  EXPECT_THAT(waitpid(pid, &status, WNOHANG), SyscallSucceedsWithValue(0));
+  EXPECT_THAT(a.ReadControlFile("freezer.state"),
+              IsPosixErrorOkAndHolds("FROZEN\n"));
+
+  ASSERT_NO_ERRNO(a.WriteControlFile("freezer.state", "THAWED"));
+  ASSERT_THAT(waitpid(pid, &status, 0), SyscallSucceedsWithValue(pid));
+  kill_pid.Release();
+  EXPECT_TRUE(WIFSIGNALED(status));
+  EXPECT_EQ(WTERMSIG(status), SIGKILL);
+}
