+TEST_F(CgroupFreezer, MigrationChecksCredentials) {
+  // Writing a process to cgroup.procs or tasks moves it into the cgroup, which
+  // can freeze it; as Linux's __cgroup1_procs_write(), a writer whose effective
+  // UID is not the global root and does not match the target's real or saved
+  // UID is refused (EACCES), so a user with a delegated freezer subtree cannot
+  // freeze another user's process.
+  SKIP_IF(!ASSERT_NO_ERRNO_AND_VALUE(HaveCapability(CAP_SETUID)));
+  SKIP_IF(!ASSERT_NO_ERRNO_AND_VALUE(HaveCapability(CAP_SETGID)));
+  SKIP_IF(!ASSERT_NO_ERRNO_AND_VALUE(HaveCapability(CAP_CHOWN)));
+  Cgroup a = Child(*top_, "ale_freezer_creds");
+  const std::string procs = a.Relpath("cgroup.procs");
+  const std::string tasks = a.Relpath("tasks");
+  const pid_t root_pid = getpid();  // This process runs as root.
+  // Delegate the subtree to uid 65534, so it may open the files; the write is
+  // then refused by the credential check, not by file permissions.
+  ASSERT_THAT(chown(a.Path().c_str(), 65534, 65534), SyscallSucceeds());
+  ASSERT_THAT(chown(procs.c_str(), 65534, 65534), SyscallSucceeds());
+  ASSERT_THAT(chown(tasks.c_str(), 65534, 65534), SyscallSucceeds());
+
+  EXPECT_THAT(InForkedProcess([&] {
+                TEST_PCHECK(setgroups(0, nullptr) == 0);
+                TEST_PCHECK(setgid(65534) == 0);
+                TEST_PCHECK(setuid(65534) == 0);
+                // Moving a root-owned process in is refused.
+                int fd = open(procs.c_str(), O_WRONLY);
+                TEST_PCHECK(fd >= 0);
+                std::string s = absl::StrCat(root_pid);
+                TEST_CHECK(write(fd, s.data(), s.size()) == -1);
+                TEST_CHECK(errno == EACCES);
+                close(fd);
+                fd = open(tasks.c_str(), O_WRONLY);
+                TEST_PCHECK(fd >= 0);
+                TEST_CHECK(write(fd, s.data(), s.size()) == -1);
+                TEST_CHECK(errno == EACCES);
+                close(fd);
+                // Moving itself in is allowed (its own UID).
+                fd = open(procs.c_str(), O_WRONLY);
+                TEST_PCHECK(fd >= 0);
+                std::string self = absl::StrCat(getpid());
+                TEST_CHECK(write(fd, self.data(), self.size()) ==
+                           static_cast<ssize_t>(self.size()));
+                close(fd);
+              }),
+              IsPosixErrorOkAndHolds(0));
+
+  // Root is never refused; the cgroup still holds only root's process.
+  EXPECT_NO_ERRNO(a.WriteControlFile("freezer.state", "THAWED"));
+}
