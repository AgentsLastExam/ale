+package cgroupfs
+
+import (
+	"bytes"
+	"strings"
+
+	"gvisor.dev/gvisor/pkg/atomicbitops"
+	"gvisor.dev/gvisor/pkg/context"
+	"gvisor.dev/gvisor/pkg/errors/linuxerr"
+	"gvisor.dev/gvisor/pkg/hostarch"
+	"gvisor.dev/gvisor/pkg/sentry/fsimpl/kernfs"
+	"gvisor.dev/gvisor/pkg/sentry/kernel"
+	"gvisor.dev/gvisor/pkg/sentry/kernel/auth"
+	"gvisor.dev/gvisor/pkg/sentry/vfs"
+	"gvisor.dev/gvisor/pkg/usermem"
+)
+
+// freezerController is cgroup v1's freezer controller, as in Linux's
+// kernel/cgroup/legacy_freezer.c. Writing FROZEN to a cgroup's freezer.state
+// stops every task of the cgroup and its descendants until THAWED is written
+// to it; freezer.state reads FREEZING until all of them have stopped, then
+// FROZEN. The root cgroup has no control files and cannot be frozen.
+//
+// +stateify savable
+type freezerController struct {
+	controllerCommon
+	controllerStateless
+	controllerNoResource
+
+	// cg is the cgroup of this controller. Immutable once set by
+	// AddControlFiles.
+	cg *cgroupInode
+
+	// self is Linux's CGROUP_FREEZING_SELF: FROZEN was written to this
+	// cgroup's freezer.state, and THAWED not since. It is written with
+	// fs.tasksMu locked and may be read without it.
+	self atomicbitops.Bool
+}
+
+var _ controller = (*freezerController)(nil)
+
+func newFreezerController(fs *filesystem) *freezerController {
+	c := &freezerController{}
+	c.controllerCommon.init(kernel.CgroupControllerFreezer, fs)
+	return c
+}
+
+// Clone implements controller.Clone.
+func (c *freezerController) Clone() controller {
+	new := &freezerController{}
+	new.controllerCommon.cloneFromParent(c)
+	return new
+}
+
+// AddControlFiles implements controller.AddControlFiles.
+func (c *freezerController) AddControlFiles(ctx context.Context, creds *auth.Credentials, cg *cgroupInode, contents map[string]kernfs.Inode) {
+	c.cg = cg
+	if c.parent == nil {
+		// Linux's CFTYPE_NOT_ON_ROOT.
+		return
+	}
+	contents["freezer.state"] = c.fs.newControllerWritableFile(ctx, creds, &freezerStateData{c}, true)
+	contents["freezer.self_freezing"] = c.fs.newControllerFile(ctx, creds, &freezerFlagData{c: c, self: true}, true)
+	contents["freezer.parent_freezing"] = c.fs.newControllerFile(ctx, creds, &freezerFlagData{c: c}, true)
+}
+
+func (c *freezerController) parentFreezer() *freezerController {
+	if c.parent == nil {
+		return nil
+	}
+	return c.parent.(*freezerController)
+}
+
+// freezing returns true if FROZEN was written to the freezer.state of c or
+// one of its ancestors, and THAWED not since: Linux's CGROUP_FREEZING, which
+// its CGROUP_FREEZING_PARENT carries down the hierarchy.
+func (c *freezerController) freezing() bool {
+	for f := c; f != nil; f = f.parentFreezer() {
+		if f.self.Load() {
+			return true
+		}
+	}
+	return false
+}
+
+// forEachCgroupLocked calls fn on c's cgroup and each of its descendants.
+//
+// Preconditions: c.fs.tasksMu is locked.
+func (c *freezerController) forEachCgroupLocked(fn func(*cgroupInode)) {
+	fn(c.cg)
+	c.cg.dir.OrderedChildren.ForEachChild(func(_ string, i kernfs.Inode) {
+		if child, ok := i.(*cgroupInode); ok {
+			child.controllers[kernel.CgroupControllerFreezer].(*freezerController).forEachCgroupLocked(fn)
+		}
+	})
+}
+
+// setSelf sets the freezer.state of c to FROZEN or THAWED, and stops or
+// resumes the tasks of c and its descendants accordingly.
+func (c *freezerController) setSelf(freeze bool) {
+	var ts []*kernel.Task
+	c.fs.tasksMu.Lock()
+	if c.self.Swap(freeze) != freeze {
+		c.forEachCgroupLocked(func(cg *cgroupInode) {
+			for t := range cg.ts {
+				ts = append(ts, t)
+			}
+		})
+	}
+	c.fs.tasksMu.Unlock()
+	// A task that moves between cgroups meanwhile syncs itself, after it
+	// moves.
+	for _, t := range ts {
+		t.SyncCgroupFreezer()
+	}
+}
+
+// state returns the freezer.state of c: FROZEN once c is freezing and all
+// tasks of c and its descendants have stopped, as Linux's
+// legacy_freezer.c:update_if_frozen() finds.
+func (c *freezerController) state() string {
+	if !c.freezing() {
+		return "THAWED"
+	}
+	frozen := true
+	c.fs.tasksMu.RLock()
+	c.forEachCgroupLocked(func(cg *cgroupInode) {
+		for t := range cg.ts {
+			if frozen && !t.CgroupFreezerFrozen() {
+				frozen = false
+			}
+		}
+	})
+	c.fs.tasksMu.RUnlock()
+	if frozen {
+		return "FROZEN"
+	}
+	return "FREEZING"
+}
+
+// Freezing implements kernel.CgroupImpl.Freezing.
+func (c *cgroupInode) Freezing() bool {
+	f, ok := c.controllers[kernel.CgroupControllerFreezer].(*freezerController)
+	return ok && f.freezing()
+}
+
+// freezerStateData implements freezer.state.
+//
+// +stateify savable
+type freezerStateData struct {
+	c *freezerController
+}
+
+// Generate implements vfs.DynamicBytesSource.Generate.
+func (d *freezerStateData) Generate(ctx context.Context, buf *bytes.Buffer) error {
+	buf.WriteString(d.c.state())
+	buf.WriteString("\n")
+	return nil
+}
+
+// Write implements vfs.WritableDynamicBytesSource.Write.
+func (d *freezerStateData) Write(ctx context.Context, _ *vfs.FileDescription, src usermem.IOSequence, offset int64) (int64, error) {
+	return d.WriteBackground(ctx, src)
+}
+
+// WriteBackground implements writableControllerFileImpl.WriteBackground.
+func (d *freezerStateData) WriteBackground(ctx context.Context, src usermem.IOSequence) (int64, error) {
+	buf := copyScratchBufferFromContext(ctx, int(hostarch.PageSize))
+	n, err := src.CopyIn(ctx, buf)
+	if err != nil {
+		return 0, err
+	}
+	// As Linux's legacy_freezer.c:freezer_write(), which takes no other
+	// state.
+	switch strings.TrimSpace(string(buf[:n])) {
+	case "THAWED":
+		d.c.setSelf(false)
+	case "FROZEN":
+		d.c.setSelf(true)
+	default:
+		return 0, linuxerr.EINVAL
+	}
+	return int64(n), nil
+}
+
+// freezerFlagData implements freezer.self_freezing and
+// freezer.parent_freezing.
+//
+// +stateify savable
+type freezerFlagData struct {
+	c    *freezerController
+	self bool
+}
+
+// Generate implements vfs.DynamicBytesSource.Generate.
+func (d *freezerFlagData) Generate(ctx context.Context, buf *bytes.Buffer) error {
+	var freezing bool
+	if d.self {
+		freezing = d.c.self.Load()
+	} else {
+		freezing = d.c.parentFreezer().freezing()
+	}
+	if freezing {
+		buf.WriteString("1\n")
+	} else {
+		buf.WriteString("0\n")
+	}
+	return nil
+}
