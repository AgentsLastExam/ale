+// The freezer tests also run on Linux, given CAP_SYS_ADMIN in the initial
+// cgroup namespace, where they mount cgroup v1's freezer hierarchy.
+class CgroupFreezer : public ::testing::Test {
+ protected:
+  void SetUp() override {
+    SKIP_IF(!TEST_CHECK_NO_ERRNO_AND_VALUE(HaveCapability(CAP_SYS_ADMIN)));
+    mounter_ = std::make_unique<Mounter>(
+        ASSERT_NO_ERRNO_AND_VALUE(TempPath::CreateDir()));
+    PosixErrorOr<Cgroup> top = mounter_->MountCgroupfs("freezer");
+    if (!top.ok() && !IsRunningOnGvisor()) {
+      GTEST_SKIP() << "cannot mount cgroup v1's freezer: " << top.error().ToString();
+    }
+    ASSERT_NO_ERRNO(top);
+    top_.emplace(top.ValueOrDie());
+  }
+
+  // Creates a child of c that is removed at the end of the test, after the
+  // children created after it. Linux may take a moment to let go of a thread
+  // that has just exited.
+  Cgroup Child(const Cgroup& c, absl::string_view name) {
+    Cgroup child = TEST_CHECK_NO_ERRNO_AND_VALUE(c.CreateChild(name));
+    std::string path = child.Path();
+    cleanups_.emplace_back([path] {
+      absl::Time deadline = absl::Now() + absl::Seconds(5);
+      while (rmdir(path.c_str()) < 0 && errno == EBUSY &&
+             absl::Now() < deadline) {
+        absl::SleepFor(absl::Milliseconds(10));
+      }
+    });
+    return child;
+  }
+
+  void TearDown() override {
+    while (!cleanups_.empty()) {
+      cleanups_.pop_back();
+    }
+  }
+
+  std::unique_ptr<Mounter> mounter_;
+  std::optional<Cgroup> top_;
+  std::vector<Cleanup> cleanups_;
+};
+
+// Waits until c's freezer.state reads want.
+PosixError WaitForFreezerState(const Cgroup& c, absl::string_view want) {
+  std::string got;
+  absl::Time deadline = absl::Now() + absl::Seconds(10);
+  while (absl::Now() < deadline) {
+    ASSIGN_OR_RETURN_ERRNO(got, c.ReadControlFile("freezer.state"));
+    if (got == absl::StrCat(want, "\n")) {
+      return NoError();
+    }
+    absl::SleepFor(absl::Milliseconds(5));
+  }
+  return PosixError(ETIMEDOUT, absl::StrCat("freezer.state is ", got));
+}
+
+// Counters is memory shared with child processes, which count in it.
+struct Counters {
+  std::atomic<uint64_t> busy;
+  std::atomic<uint64_t> sleeping;
+};
+
+Counters* MapCounters() {
+  void* p = mmap(nullptr, sizeof(Counters), PROT_READ | PROT_WRITE,
+                 MAP_SHARED | MAP_ANONYMOUS, -1, 0);
+  TEST_CHECK(p != MAP_FAILED);
+  return new (p) Counters();
+}
+
+// Forks a process that counts in *counter until it is killed, busily or
+// sleeping between counts.
+pid_t ForkCounter(std::atomic<uint64_t>* counter, bool sleep) {
+  pid_t pid = fork();
+  if (pid == 0) {
+    while (true) {
+      counter->fetch_add(1);
+      if (sleep) {
+        usleep(1000);
+      }
+    }
+  }
+  TEST_CHECK(pid > 0);
+  return pid;
+}
+
+// Returns true if *counter does not move for 100 ms.
+bool Stopped(const std::atomic<uint64_t>* counter) {
+  uint64_t before = counter->load();
+  absl::SleepFor(absl::Milliseconds(100));
+  return counter->load() == before;
+}
+
+// Returns true if *counter moves within 10 s.
+bool Moves(const std::atomic<uint64_t>* counter) {
+  uint64_t before = counter->load();
+  absl::Time deadline = absl::Now() + absl::Seconds(10);
+  while (absl::Now() < deadline) {
+    if (counter->load() != before) {
+      return true;
+    }
+    absl::SleepFor(absl::Milliseconds(1));
+  }
+  return false;
+}
+
+char ProcState(pid_t pid) {
+  std::string stat = TEST_CHECK_NO_ERRNO_AND_VALUE(
+      GetContents(absl::StrCat("/proc/", pid, "/stat")));
+  size_t paren = stat.rfind(')');
+  TEST_CHECK(paren != std::string::npos && paren + 2 < stat.size());
+  return stat[paren + 2];
+}
+
+void KillAndReap(pid_t pid) {
+  kill(pid, SIGKILL);
+  int status;
+  waitpid(pid, &status, 0);
+}
+
+// Returns a cleanup that thaws c, which must precede reaping a process that c
+// may hold.
+Cleanup Thaw(const Cgroup& c) {
+  return Cleanup([c] { c.WriteControlFile("freezer.state", "THAWED"); });
+}
