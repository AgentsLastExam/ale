+TEST_F(CgroupFreezer, ExitWhileFreezeToggles) {
+  // A task that is exiting must not be left parked by a freeze raised while it
+  // runs its exit path: once it leaves its cgroups, THAWED cannot reach it and
+  // SIGKILL does not end a freeze, so it would never be reaped. Churn
+  // short-lived children through a cgroup while toggling its freezer, and make
+  // sure every child is reaped once the cgroup is thawed.
+  const DisableSave ds;  // Timing-sensitive.
+  Cgroup a = Child(*top_, "ale_freezer_exit");
+  for (int i = 0; i < 400; ++i) {
+    pid_t pid = fork();
+    if (pid == 0) {
+      _exit(0);
+    }
+    ASSERT_GT(pid, 0);
+    // Place the child in the cgroup; it may already have exited.
+    a.Enter(pid).IgnoreError();
+    // Toggle the freezer around the child's exit.
+    a.WriteControlFile("freezer.state", "FROZEN").IgnoreError();
+    a.WriteControlFile("freezer.state", "THAWED").IgnoreError();
+    // The child must be reaped; poll rather than block forever on a bug.
+    int status = 0;
+    bool reaped = false;
+    absl::Time deadline = absl::Now() + absl::Seconds(20);
+    while (absl::Now() < deadline) {
+      pid_t w = waitpid(pid, &status, WNOHANG);
+      if (w == pid) {
+        reaped = true;
+        break;
+      }
+      ASSERT_THAT(w, SyscallSucceeds());
+      // In case the loop lost a race, leave the cgroup thawed.
+      a.WriteControlFile("freezer.state", "THAWED").IgnoreError();
+      absl::SleepFor(absl::Milliseconds(1));
+    }
+    ASSERT_TRUE(reaped) << "child " << pid << " not reaped at iteration " << i;
+  }
+}
