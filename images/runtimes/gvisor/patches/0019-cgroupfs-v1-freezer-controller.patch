+TEST_F(CgroupFreezer, FreezesOneThread) {
+  const DisableSave ds;  // Timing-sensitive.
+  Cgroup a = Child(*top_, "ale_freezer_a");
+  std::atomic<uint64_t> counter(0);
+  std::atomic<pid_t> tid(0);
+  std::atomic<bool> done(false);
+  ScopedThread thread([&] {
+    tid.store(syscall(SYS_gettid));
+    while (!done.load()) {
+      counter.fetch_add(1);
+    }
+  });
+  auto stop = Cleanup([&] { done.store(true); });
+  while (tid.load() == 0) {
+    absl::SleepFor(absl::Milliseconds(1));
+  }
+  auto thaw = Thaw(a);
+  ASSERT_NO_ERRNO(a.EnterThread(tid.load()));
+  ASSERT_NO_ERRNO(a.WriteControlFile("freezer.state", "FROZEN"));
+  // The other threads of the process, this one too, go on.
+  ASSERT_NO_ERRNO(WaitForFreezerState(a, "FROZEN"));
+  EXPECT_TRUE(Stopped(&counter));
+  ASSERT_NO_ERRNO(a.WriteControlFile("freezer.state", "THAWED"));
+  EXPECT_TRUE(Moves(&counter));
+}
