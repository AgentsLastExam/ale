+
+// SIOCSIFFLAGS sets an interface's flags, as Linux's dev_ifsioc() does through
+// dev_change_flags(), in the socket's network namespace. crun brings up the
+// loopback interface of a new network namespace so.
+TEST(NetdeviceTest, SetInterfaceFlags) {
+  SKIP_IF(!ASSERT_NO_ERRNO_AND_VALUE(HaveCapability(CAP_NET_ADMIN)));
+  SKIP_IF(!ASSERT_NO_ERRNO_AND_VALUE(HaveCapability(CAP_SYS_ADMIN)));
+  SKIP_IF(IsRunningWithHostinet());
+
+  const FileDescriptor netns =
+      ASSERT_NO_ERRNO_AND_VALUE(Open("/proc/thread-self/ns/net", O_RDONLY));
+  auto restore = Cleanup(
+      [&] { EXPECT_THAT(setns(netns.get(), CLONE_NEWNET), SyscallSucceeds()); });
+  ASSERT_THAT(unshare(CLONE_NEWNET), SyscallSucceeds());
+
+  FileDescriptor sock =
+      ASSERT_NO_ERRNO_AND_VALUE(Socket(AF_INET, SOCK_DGRAM, 0));
+  struct ifreq ifr = {};
+  snprintf(ifr.ifr_name, IFNAMSIZ, "lo");
+
+  for (const bool up : {true, false, true}) {
+    ASSERT_THAT(ioctl(sock.get(), SIOCGIFFLAGS, &ifr), SyscallSucceeds());
+    if (up) {
+      ifr.ifr_flags |= IFF_UP;
+    } else {
+      ifr.ifr_flags &= ~IFF_UP;
+    }
+    ASSERT_THAT(ioctl(sock.get(), SIOCSIFFLAGS, &ifr), SyscallSucceeds());
+    ASSERT_THAT(ioctl(sock.get(), SIOCGIFFLAGS, &ifr), SyscallSucceeds());
+    EXPECT_EQ(ifr.ifr_flags & IFF_UP, up ? IFF_UP : 0);
+    EXPECT_NE(ifr.ifr_flags & IFF_LOOPBACK, 0);
+  }
+
+  struct ifreq unknown = ifr;
+  snprintf(unknown.ifr_name, IFNAMSIZ, "nosuchdev0");
+  EXPECT_THAT(ioctl(sock.get(), SIOCSIFFLAGS, &unknown),
+              SyscallFailsWithErrno(ENODEV));
+
+  // The ioctls act in the socket's network namespace, not the caller's, as
+  // Linux's sock_ioctl() passes sock_net() to dev_ioctl().
+  ASSERT_THAT(unshare(CLONE_NEWNET), SyscallSucceeds());
+  FileDescriptor other =
+      ASSERT_NO_ERRNO_AND_VALUE(Socket(AF_INET, SOCK_DGRAM, 0));
+  struct ifreq other_lo = {};
+  snprintf(other_lo.ifr_name, IFNAMSIZ, "lo");
+  for (const bool up : {false, true}) {
+    ASSERT_THAT(ioctl(sock.get(), SIOCGIFFLAGS, &ifr), SyscallSucceeds());
+    if (up) {
+      ifr.ifr_flags |= IFF_UP;
+    } else {
+      ifr.ifr_flags &= ~IFF_UP;
+    }
+    ASSERT_THAT(ioctl(sock.get(), SIOCSIFFLAGS, &ifr), SyscallSucceeds());
+    ASSERT_THAT(ioctl(sock.get(), SIOCGIFFLAGS, &ifr), SyscallSucceeds());
+    EXPECT_EQ(ifr.ifr_flags & IFF_UP, up ? IFF_UP : 0);
+    ASSERT_THAT(ioctl(other.get(), SIOCGIFFLAGS, &other_lo),
+                SyscallSucceeds());
+    EXPECT_EQ(other_lo.ifr_flags & IFF_UP, 0);
+  }
+
+  // Without CAP_NET_ADMIN, before the device is looked up.
+  AutoCapability cap(CAP_NET_ADMIN, false);
+  EXPECT_THAT(ioctl(sock.get(), SIOCSIFFLAGS, &ifr),
+              SyscallFailsWithErrno(EPERM));
+  EXPECT_THAT(ioctl(sock.get(), SIOCSIFFLAGS, &unknown),
+              SyscallFailsWithErrno(EPERM));
+}
