diff --git a/pkg/sentry/socket/netstack/stack.go b/pkg/sentry/socket/netstack/stack.go
index 0c46102..669d8cd 100644
--- a/pkg/sentry/socket/netstack/stack.go
+++ b/pkg/sentry/socket/netstack/stack.go
@@ -308,6 +308,30 @@ func (s *Stack) SetInterface(ctx context.Context, msg *nlmsg.Message) *syserr.Er
 	return s.setLinkLocked(ctx, tcpip.NICID(ifinfomsg.Index), attrs, ifinfomsg.Flags, ifinfomsg.Change, dstNs)
 }
 
+// SetInterfaceFlags sets the flags of interface id to flags, as SIOCSIFFLAGS
+// does through Linux's dev_change_flags: flags is the complete set, and the
+// flags that userspace cannot change, such as IFF_RUNNING, are ignored.
+func (s *Stack) SetInterfaceFlags(ctx context.Context, id tcpip.NICID, flags uint32) *syserr.Error {
+	s.linkMu.Lock()
+	defer s.linkMu.Unlock()
+	nicInfo, ok := s.Stack.SingleNICInfo(id)
+	if !ok {
+		return syserr.ErrUnknownNICID
+	}
+	want, err := combineLinkFlags(nicInfo.Flags, flags, 0)
+	if err != nil {
+		ctx.Warningf("Unsupported interface flag change: ifr_flags %#x", flags)
+		return err
+	}
+	if up := want&linux.IFF_UP != 0; up != nicInfo.Flags.Up {
+		if err := s.setUpLocked(ctx, id, up); err != nil {
+			return err
+		}
+		s.sendChangeEvent(ctx, id)
+	}
+	return nil
+}
