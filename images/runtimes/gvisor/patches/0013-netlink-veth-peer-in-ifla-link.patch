diff --git a/pkg/sentry/socket/netstack/stack.go b/pkg/sentry/socket/netstack/stack.go
index cb56ada..0c46102 100644
--- a/pkg/sentry/socket/netstack/stack.go
+++ b/pkg/sentry/socket/netstack/stack.go
@@ -78,8 +78,8 @@ func (s *Stack) AddInterfaceEventSubscriber(sub inet.InterfaceEventSubscriber) {
 	s.eventSubscriber = sub
 }
 
-func makeInterfaceInfo(ni *stack.NICInfo) inet.Interface {
-	return inet.Interface{
+func (s *Stack) makeInterfaceInfo(ni *stack.NICInfo) inet.Interface {
+	i := inet.Interface{
 		Name:       ni.Name,
 		Addr:       []byte(ni.LinkAddress),
 		Flags:      uint32(nicStateFlagsToLinux(ni.Flags)),
@@ -88,6 +88,46 @@ func makeInterfaceInfo(ni *stack.NICInfo) inet.Interface {
 		Master:     uint32(ni.Primary),
 		Kind:       ni.Kind,
 	}
+	if ni.Kind == "veth" {
+		if ep := s.Stack.GetLinkEndpointByName(ni.Name); ep != nil {
+			if peer, peerStack, ok := vethPeer(ep); ok {
+				i.Link = int32(peer)
+				i.LinkOtherNetns = peerStack != s.Stack
+			}
+		}
+	}
+	return i
+}
+
+// vethPeer returns the index of the interface that the other end of the veth
+// pair under ep belongs to, in its own network namespace, as Linux's
+// veth_get_iflink returns it, and that namespace's stack.
+func vethPeer(ep stack.LinkEndpoint) (tcpip.NICID, *stack.Stack, bool) {
+	for {
+		switch e := ep.(type) {
+		case *veth.Endpoint:
+			// The peer's NIC, or its bridge port, is the dispatcher of the
+			// outermost endpoint wrapping the peer.
+			d := e.Peer().Dispatcher()
+			for d != nil {
+				if nic, ok := d.(stack.NICDispatcher); ok {
+					return nic.NICID(), nic.Stack(), true
+				}
+				wrapper, ok := d.(interface {
+					Dispatcher() stack.NetworkDispatcher
+				})
+				if !ok {
+					return 0, nil, false
+				}
+				d = wrapper.Dispatcher()
+			}
+			return 0, nil, false
+		case interface{ Child() stack.LinkEndpoint }:
+			ep = e.Child()
+		default:
+			return 0, nil, false
+		}
+	}
 }
 
