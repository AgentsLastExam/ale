+// SetLinkMaster makes the link of index index a port of the bridge of index
+// master.
+PosixError SetLinkMaster(const FileDescriptor& fd, int index, int master) {
+  struct {
+    struct nlmsghdr hdr;
+    struct ifinfomsg ifm;
+    char buf[64];
+  } req = {};
+  req.hdr.nlmsg_len = NLMSG_LENGTH(sizeof(struct ifinfomsg));
+  req.hdr.nlmsg_type = RTM_SETLINK;
+  req.hdr.nlmsg_flags = NLM_F_REQUEST | NLM_F_ACK;
+  req.hdr.nlmsg_seq = kSeq;
+  req.ifm.ifi_family = AF_UNSPEC;
+  req.ifm.ifi_index = index;
+  uint32_t m = master;
+  addattr(&req.hdr, sizeof(req), IFLA_MASTER, &m, sizeof(m));
+  return NetlinkRequestAckOrError(fd, kSeq, &req, req.hdr.nlmsg_len);
+}
+
 // RTM_SETLINK changes an existing link only. Like Linux's rtnl_setlink(), it
 // ignores NLM_F_CREATE, NLM_F_EXCL and NLM_F_REPLACE, which netavark sets when
 // it brings a link up.
@@ -6278,6 +6298,87 @@ TEST(NetlinkRouteTest, SetLinkIgnoresNewLinkFlags) {
               PosixErrorIs(EINVAL, ::testing::_));
 }
 
+// Each end of a veth pair reports the other's index in IFLA_LINK, as Linux's
+// veth_get_iflink() returns it, also when one end is a bridge port or in
+// another network namespace. netavark finds the host end of the pair it
+// created that way.
+TEST(NetlinkRouteTest, VethLink) {
+  SKIP_IF(!ASSERT_NO_ERRNO_AND_VALUE(HaveCapability(CAP_NET_ADMIN)));
+  SKIP_IF(!ASSERT_NO_ERRNO_AND_VALUE(HaveCapability(CAP_SYS_ADMIN)));
+  SKIP_IF(IsRunningWithHostinet());
+  Cleanup restore = ASSERT_NO_ERRNO_AND_VALUE(EnterNewNetns());
+
+  FileDescriptor fd =
+      ASSERT_NO_ERRNO_AND_VALUE(NetlinkBoundSocket(NETLINK_ROUTE));
+  VethRequest veth = GetVethRequest(kSeq, "vlink1", "vlink2");
+  ASSERT_NO_ERRNO(
+      NetlinkRequestAckOrError(fd, kSeq, &veth, veth.hdr.nlmsg_len));
+  BridgeRequest bridge = GetBridgeRequest(kSeq, "vlinkbr");
+  ASSERT_NO_ERRNO(
+      NetlinkRequestAckOrError(fd, kSeq, &bridge, bridge.hdr.nlmsg_len));
+
+  auto links = ASSERT_NO_ERRNO_AND_VALUE(DumpLinkAttrs(fd));
+  ASSERT_EQ(links.count("vlink1"), 1);
+  ASSERT_EQ(links.count("vlink2"), 1);
+  EXPECT_EQ(links["vlink1"].link, links["vlink2"].index);
+  EXPECT_EQ(links["vlink2"].link, links["vlink1"].index);
+  EXPECT_EQ(links["lo"].link, 0);
+  EXPECT_EQ(links["vlinkbr"].link, 0);
+
+  ASSERT_NO_ERRNO(
+      SetLinkMaster(fd, links["vlink1"].index, links["vlinkbr"].index));
+  links = ASSERT_NO_ERRNO_AND_VALUE(DumpLinkAttrs(fd));
+  EXPECT_EQ(links["vlink1"].master, links["vlinkbr"].index);
+  EXPECT_EQ(links["vlink1"].link, links["vlink2"].index);
+  EXPECT_EQ(links["vlink2"].link, links["vlink1"].index);
+
+  // A pair whose peer is created in another network namespace.
+  FileDescriptor peer_netns;
+  FileDescriptor peer_fd;
+  ScopedThread([&] {
+    TEST_CHECK_SUCCESS(unshare(CLONE_NEWNET));
+    peer_netns = TEST_CHECK_NO_ERRNO_AND_VALUE(
+        Open("/proc/thread-self/ns/net", O_RDONLY));
+    peer_fd = TEST_CHECK_NO_ERRNO_AND_VALUE(NetlinkBoundSocket(NETLINK_ROUTE));
+  });
+  veth = GetVethRequest(kSeq, "vlink3", "vlink4", peer_netns.get());
+  ASSERT_NO_ERRNO(
+      NetlinkRequestAckOrError(fd, kSeq, &veth, veth.hdr.nlmsg_len));
+  links = ASSERT_NO_ERRNO_AND_VALUE(DumpLinkAttrs(fd));
+  auto peer_links = ASSERT_NO_ERRNO_AND_VALUE(DumpLinkAttrs(peer_fd));
+  ASSERT_EQ(links.count("vlink3"), 1);
+  ASSERT_EQ(peer_links.count("vlink4"), 1);
+  EXPECT_EQ(links["vlink3"].link, peer_links["vlink4"].index);
+  EXPECT_EQ(peer_links["vlink4"].link, links["vlink3"].index);
+
+  // A pair across two new namespaces, whose ends both get index 2: across
+  // namespaces Linux puts IFLA_LINK whatever the index
+  // (rtnl_fill_link_netnsid()).
+  FileDescriptor netns_b;
+  FileDescriptor fd_a;
+  FileDescriptor fd_b;
+  ScopedThread([&] {
+    TEST_CHECK_SUCCESS(unshare(CLONE_NEWNET));
+    netns_b = TEST_CHECK_NO_ERRNO_AND_VALUE(
+        Open("/proc/thread-self/ns/net", O_RDONLY));
+    fd_b = TEST_CHECK_NO_ERRNO_AND_VALUE(NetlinkBoundSocket(NETLINK_ROUTE));
+  });
+  ScopedThread([&] {
+    TEST_CHECK_SUCCESS(unshare(CLONE_NEWNET));
+    fd_a = TEST_CHECK_NO_ERRNO_AND_VALUE(NetlinkBoundSocket(NETLINK_ROUTE));
+  });
+  veth = GetVethRequest(kSeq, "vlink5", "vlink6", netns_b.get());
+  ASSERT_NO_ERRNO(
+      NetlinkRequestAckOrError(fd_a, kSeq, &veth, veth.hdr.nlmsg_len));
+  auto links_a = ASSERT_NO_ERRNO_AND_VALUE(DumpLinkAttrs(fd_a));
+  auto links_b = ASSERT_NO_ERRNO_AND_VALUE(DumpLinkAttrs(fd_b));
+  ASSERT_EQ(links_a.count("vlink5"), 1);
+  ASSERT_EQ(links_b.count("vlink6"), 1);
+  ASSERT_EQ(links_a["vlink5"].index, links_b["vlink6"].index);
+  EXPECT_EQ(links_a["vlink5"].link, links_b["vlink6"].index);
+  EXPECT_EQ(links_b["vlink6"].link, links_a["vlink5"].index);
+}
