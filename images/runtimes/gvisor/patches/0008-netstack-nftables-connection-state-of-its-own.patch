+// SwapNFTablesState swaps the packet's connection tracking and NAT state for
+// iptables with its state for nftables. nftables calls it before and after it
+// evaluates a hook, so that each finds only its own connection and NAT on the
+// packet: a packet that iptables tracked and NATed, as once any of its tables
+// is set, is then tracked and NATed by nftables as well, instead of nftables
+// finding iptables' connection and panicking on its NAT.
+func (pk *PacketBuffer) SwapNFTablesState() {
+	pk.tuple, pk.nftTuple = pk.nftTuple, pk.tuple
+	pk.snatDone, pk.nftSNATDone = pk.nftSNATDone, pk.snatDone
+	pk.dnatDone, pk.nftDNATDone = pk.nftDNATDone, pk.dnatDone
+}
+
 // IsConnTrackConfigured returns whether connection tracking is configured for this packet.
 func (pk *PacketBuffer) IsConnTrackConfigured() bool {
 	return pk.tuple != nil && pk.tuple.conn != nil
diff --git a/pkg/tcpip/stack/packet_buffer_test.go b/pkg/tcpip/stack/packet_buffer_test.go
index ab7fefb..9c4af11 100644
--- a/pkg/tcpip/stack/packet_buffer_test.go
+++ b/pkg/tcpip/stack/packet_buffer_test.go
@@ -943,3 +943,32 @@ func BenchmarkPacketDataReadTo(b *testing.B) {
 		}
 	}
 }
