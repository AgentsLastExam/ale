+// TestSwapNFTablesState checks that iptables and nftables each keep their own
+// connection tracking and NAT state on a packet, and that a clone keeps both.
+func TestSwapNFTablesState(t *testing.T) {
+	pk := NewPacketBuffer(PacketBufferOptions{})
+	defer pk.DecRef()
+	iptTuple := &tuple{}
+	pk.tuple, pk.dnatDone = iptTuple, true
+
+	pk.SwapNFTablesState()
+	if pk.tuple != nil || pk.dnatDone || pk.snatDone {
+		t.Fatalf("nftables sees iptables' state: tuple %p, dnatDone %t, snatDone %t", pk.tuple, pk.dnatDone, pk.snatDone)
+	}
+	nftTuple := &tuple{}
+	pk.tuple, pk.snatDone = nftTuple, true
+	clone := pk.Clone()
+	defer clone.DecRef()
+
+	for _, p := range []*PacketBuffer{pk, clone} {
+		p.SwapNFTablesState()
+		if p.tuple != iptTuple || !p.dnatDone || p.snatDone {
+			t.Errorf("iptables' state = tuple %p, dnatDone %t, snatDone %t; want %p, true, false", p.tuple, p.dnatDone, p.snatDone, iptTuple)
+		}
+		p.SwapNFTablesState()
+		if p.tuple != nftTuple || p.dnatDone || !p.snatDone {
+			t.Errorf("nftables' state = tuple %p, dnatDone %t, snatDone %t; want %p, false, true", p.tuple, p.dnatDone, p.snatDone, nftTuple)
+		}
+	}
+}
