+func familyProtocol(family uint8) tcpip.NetworkProtocolNumber {
+	if family == linux.AF_INET6 {
+		return ipv6.ProtocolNumber
+	}
+	return ipv4.ProtocolNumber
+}
+
+// InterfaceConf implements inet.NetSysctlStack.InterfaceConf.
+func (s *Stack) InterfaceConf(idx int32, family uint8, name string) (int32, error) {
+	def, ok := interfaceConfDefaults[family][name]
+	if !ok {
+		return 0, linuxerr.ENOENT
+	}
+	id := tcpip.NICID(idx)
+	if !s.Stack.HasNIC(id) {
+		return 0, linuxerr.ENODEV
+	}
+	if name == "forwarding" {
+		on, err := s.Stack.NICForwarding(id, familyProtocol(family))
+		if err != nil {
+			return 0, syserr.TranslateNetstackError(err).ToError()
+		}
+		if on {
+			return 1, nil
+		}
+		return 0, nil
+	}
+	s.sysctlMu.Lock()
+	defer s.sysctlMu.Unlock()
+	if v, ok := s.interfaceConf[id][interfaceConfKey(family, name)]; ok {
+		return v, nil
+	}
+	return def, nil
+}
+
+// SetInterfaceConf implements inet.NetSysctlStack.SetInterfaceConf.
+func (s *Stack) SetInterfaceConf(idx int32, family uint8, name string, v int32) error {
+	if _, ok := interfaceConfDefaults[family][name]; !ok {
+		return linuxerr.ENOENT
+	}
+	id := tcpip.NICID(idx)
+	if !s.Stack.HasNIC(id) {
+		return linuxerr.ENODEV
+	}
+	if name == "forwarding" {
+		// As Linux's devinet_sysctl_forward and addrconf_sysctl_forward for
+		// one device: any value but 0 turns forwarding on.
+		if _, err := s.Stack.SetNICForwarding(id, familyProtocol(family), v != 0); err != nil {
+			return syserr.TranslateNetstackError(err).ToError()
+		}
+		return nil
+	}
+	s.sysctlMu.Lock()
+	defer s.sysctlMu.Unlock()
+	if s.interfaceConf == nil {
+		s.interfaceConf = make(map[tcpip.NICID]map[string]int32)
+	}
+	conf, ok := s.interfaceConf[id]
+	if !ok {
+		conf = make(map[string]int32)
+		s.interfaceConf[id] = conf
+	}
+	conf[interfaceConfKey(family, name)] = v
+	return nil
+}
+
+// InterfaceConfNames implements inet.NetSysctlStack.InterfaceConfNames.
+func (s *Stack) InterfaceConfNames(family uint8) []string {
+	return slices.Sorted(maps.Keys(interfaceConfDefaults[family]))
+}
+
+// forgetInterfaceConf drops the settings of interface id, which left this
+// stack, as Linux drops a device's configuration when it leaves a network
+// namespace.
+func (s *Stack) forgetInterfaceConf(id tcpip.NICID) {
+	s.sysctlMu.Lock()
+	defer s.sysctlMu.Unlock()
+	delete(s.interfaceConf, id)
+}
+
+// PingGroupRange implements inet.NetSysctlStack.PingGroupRange.
+func (s *Stack) PingGroupRange() (uint32, uint32) {
+	s.sysctlMu.Lock()
+	defer s.sysctlMu.Unlock()
+	if !s.pingGroupRangeSet {
+		return defaultPingGroupLow, defaultPingGroupHigh
+	}
+	return s.pingGroupRange[0], s.pingGroupRange[1]
+}
+
+// SetPingGroupRange implements inet.NetSysctlStack.SetPingGroupRange.
+func (s *Stack) SetPingGroupRange(low, high uint32) {
+	s.sysctlMu.Lock()
+	defer s.sysctlMu.Unlock()
+	s.pingGroupRange = [2]uint32{low, high}
+	s.pingGroupRangeSet = true
 }
 
