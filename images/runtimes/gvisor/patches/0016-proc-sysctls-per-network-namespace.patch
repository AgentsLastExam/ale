+// A process that may not write a /proc/sys/net setting cannot write it
+// through a file descriptor that a privileged one opened, as Linux's
+// proc_sys_call_handler() checks sysctl_perm() at every read and write.
+TEST(ProcSysNet, WriteChecksPermissionsAgain) {
+  SKIP_IF(!ASSERT_NO_ERRNO_AND_VALUE(HaveCapability(CAP_NET_ADMIN)));
+  SKIP_IF(!ASSERT_NO_ERRNO_AND_VALUE(HaveCapability(CAP_SYS_ADMIN)));
+  SKIP_IF(!ASSERT_NO_ERRNO_AND_VALUE(HaveCapability(CAP_SETUID)));
+  SKIP_IF(!ASSERT_NO_ERRNO_AND_VALUE(HaveCapability(CAP_SETGID)));
+  SKIP_IF(IsRunningWithHostinet());
+
+  Cleanup restore = ASSERT_NO_ERRNO_AND_VALUE(EnterNewNetns());
+  for (const auto& [path, value] :
+       std::vector<std::pair<std::string, std::string>>{
+           {"/proc/sys/net/ipv4/conf/lo/forwarding", "1\n"},
+           {"/proc/sys/net/ipv4/ping_group_range", "0 0\n"}}) {
+    const std::string before = ASSERT_NO_ERRNO_AND_VALUE(GetContents(path));
+    const FileDescriptor fd = ASSERT_NO_ERRNO_AND_VALUE(Open(path, O_RDWR));
+    EXPECT_THAT(InForkedProcess([&] {
+                  TEST_PCHECK(setgroups(0, nullptr) == 0);
+                  TEST_PCHECK(setgid(65534) == 0);
+                  TEST_PCHECK(setuid(65534) == 0);
+                  TEST_CHECK(pwrite(fd.get(), value.data(), value.size(), 0) ==
+                             -1);
+                  TEST_CHECK(errno == EPERM);
+                }),
+                IsPosixErrorOkAndHolds(0))
+        << path;
+    EXPECT_EQ(ASSERT_NO_ERRNO_AND_VALUE(GetContents(path)), before) << path;
+    // The opener may still write through it.
+    ASSERT_THAT(pwrite(fd.get(), value.data(), value.size(), 0),
+                SyscallSucceedsWithValue(value.size()))
+        << path;
+  }
+}
