+// A setting of /proc/sys/net/ipv4/conf/<interface> reached through a file
+// descriptor of its directory, kept across a change of network namespace, is
+// that directory's namespace's, as Linux's proc_sys_lookup() finds a
+// directory's entries in the directory's own sysctl header.
+TEST(ProcSysNet, InterfaceConfThroughDirectoryFD) {
+  SKIP_IF(!ASSERT_NO_ERRNO_AND_VALUE(HaveCapability(CAP_NET_ADMIN)));
+  SKIP_IF(!ASSERT_NO_ERRNO_AND_VALUE(HaveCapability(CAP_SYS_ADMIN)));
+  SKIP_IF(IsRunningWithHostinet());
+  constexpr char kPath[] = "/proc/sys/net/ipv4/conf/lo/forwarding";
+
+  Cleanup restore = ASSERT_NO_ERRNO_AND_VALUE(EnterNewNetns());
+  // Keep this namespace alive once the thread leaves it: Linux unregisters
+  // a namespace's sysctls, and gVisor drops its interfaces, when it ends.
+  const FileDescriptor netns =
+      ASSERT_NO_ERRNO_AND_VALUE(Open("/proc/thread-self/ns/net", O_RDONLY));
+  const FileDescriptor dir = ASSERT_NO_ERRNO_AND_VALUE(
+      Open("/proc/sys/net/ipv4/conf/lo", O_RDONLY | O_DIRECTORY));
+  ASSERT_NO_ERRNO(SetContents(kPath, "1\n"));
+  {
+    Cleanup restore_other = ASSERT_NO_ERRNO_AND_VALUE(EnterNewNetns());
+    // Linux's new namespaces may inherit the initial one's value.
+    ASSERT_NO_ERRNO(SetContents(kPath, "0\n"));
+    const FileDescriptor fd =
+        ASSERT_NO_ERRNO_AND_VALUE(OpenAt(dir.get(), "forwarding", O_RDWR));
+    EXPECT_EQ(ASSERT_NO_ERRNO_AND_VALUE(GetContentsFD(fd.get())), "1\n");
+    ASSERT_THAT(pwrite(fd.get(), "0\n", 2, 0), SyscallSucceedsWithValue(2));
+    ASSERT_NO_ERRNO(SetContents(kPath, "1\n"));
+    const FileDescriptor again =
+        ASSERT_NO_ERRNO_AND_VALUE(OpenAt(dir.get(), "forwarding", O_RDONLY));
+    EXPECT_EQ(ASSERT_NO_ERRNO_AND_VALUE(GetContentsFD(again.get())), "0\n");
+    EXPECT_EQ(ASSERT_NO_ERRNO_AND_VALUE(GetContents(kPath)), "1\n");
+  }
+  EXPECT_EQ(ASSERT_NO_ERRNO_AND_VALUE(GetContents(kPath)), "0\n");
+}
