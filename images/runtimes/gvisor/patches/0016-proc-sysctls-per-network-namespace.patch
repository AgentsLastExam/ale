+// EnterNewNetns moves the calling thread into a new network namespace and
+// returns a Cleanup that moves it back.
+PosixErrorOr<Cleanup> EnterNewNetns() {
+  ASSIGN_OR_RETURN_ERRNO(FileDescriptor netns,
+                         Open("/proc/thread-self/ns/net", O_RDONLY));
+  RETURN_ERROR_IF_SYSCALL_FAIL(unshare(CLONE_NEWNET));
+  const int fd = netns.release();
+  return Cleanup([fd] {
+    TEST_CHECK_SUCCESS(setns(fd, CLONE_NEWNET));
+    close(fd);
+  });
+}
+
+// /proc/sys/net/ipv4/conf and /proc/sys/net/ipv6/conf have a directory of
+// settings for each interface of the opener's network namespace, as Linux
+// registers one for each device in its namespace. Container engines and
+// network plugins, such as netavark, write some of them.
+TEST(ProcSysNet, InterfaceConf) {
+  SKIP_IF(!ASSERT_NO_ERRNO_AND_VALUE(HaveCapability(CAP_NET_ADMIN)));
+  SKIP_IF(!ASSERT_NO_ERRNO_AND_VALUE(HaveCapability(CAP_SYS_ADMIN)));
+  SKIP_IF(IsRunningWithHostinet());
+
+  {
+    Cleanup restore = ASSERT_NO_ERRNO_AND_VALUE(EnterNewNetns());
+    for (const char* conf : {"/proc/sys/net/ipv4/conf", "/proc/sys/net/ipv6/conf"}) {
+      // A new namespace has only lo.
+      EXPECT_THAT(ASSERT_NO_ERRNO_AND_VALUE(ListDir(conf, true)),
+                  ::testing::UnorderedElementsAre("all", "default", "lo"))
+          << conf;
+    }
+    for (const char* setting :
+         {"/proc/sys/net/ipv4/conf/lo/rp_filter",
+          "/proc/sys/net/ipv4/conf/lo/route_localnet",
+          "/proc/sys/net/ipv4/conf/lo/arp_notify",
+          "/proc/sys/net/ipv6/conf/lo/accept_dad",
+          "/proc/sys/net/ipv6/conf/lo/autoconf"}) {
+      int initial;
+      ASSERT_TRUE(absl::SimpleAtoi(
+          absl::StripTrailingAsciiWhitespace(
+              ASSERT_NO_ERRNO_AND_VALUE(GetContents(setting))),
+          &initial))
+          << setting;
+      const int want = initial == 2 ? 1 : 2;
+      ASSERT_NO_ERRNO(SetContents(setting, absl::StrCat(want, "\n")));
+      EXPECT_EQ(ASSERT_NO_ERRNO_AND_VALUE(GetContents(setting)),
+                absl::StrCat(want, "\n"))
+          << setting;
+    }
+    // Forwarding is the interface's own.
+    for (const char* v : {"1\n", "0\n"}) {
+      ASSERT_NO_ERRNO(SetContents("/proc/sys/net/ipv4/conf/lo/forwarding", v));
+      EXPECT_EQ(ASSERT_NO_ERRNO_AND_VALUE(
+                    GetContents("/proc/sys/net/ipv4/conf/lo/forwarding")),
+                v);
+    }
+    EXPECT_THAT(Open("/proc/sys/net/ipv4/conf/nosuchdev0/rp_filter", O_RDONLY),
+                PosixErrorIs(ENOENT, ::testing::_));
+  }
+
+  // Another new namespace has its own lo, with the defaults.
+  Cleanup restore = ASSERT_NO_ERRNO_AND_VALUE(EnterNewNetns());
+  EXPECT_EQ(ASSERT_NO_ERRNO_AND_VALUE(
+                GetContents("/proc/sys/net/ipv4/conf/lo/arp_notify")),
+            "0\n");
+}
+
+// net.ipv4.ping_group_range belongs to the opener's network namespace and is
+// written as Linux's ipv4_ping_group_range() takes it.
+TEST(ProcSysNet, PingGroupRange) {
+  SKIP_IF(!ASSERT_NO_ERRNO_AND_VALUE(HaveCapability(CAP_NET_ADMIN)));
+  SKIP_IF(!ASSERT_NO_ERRNO_AND_VALUE(HaveCapability(CAP_SYS_ADMIN)));
+  SKIP_IF(IsRunningWithHostinet());
+  constexpr char kPath[] = "/proc/sys/net/ipv4/ping_group_range";
+
+  Cleanup restore = ASSERT_NO_ERRNO_AND_VALUE(EnterNewNetns());
+  // Linux's default is no group; gVisor lets every group create ping sockets
+  // and says so.
+  EXPECT_EQ(ASSERT_NO_ERRNO_AND_VALUE(GetContents(kPath)),
+            IsRunningOnGvisor() ? "0\t4294967294\n" : "1\t0\n");
+
+  ASSERT_NO_ERRNO(SetContents(kPath, "0 0"));
+  EXPECT_EQ(ASSERT_NO_ERRNO_AND_VALUE(GetContents(kPath)), "0\t0\n");
+  // An empty range is kept as "1 0".
+  ASSERT_NO_ERRNO(SetContents(kPath, "5 2"));
+  EXPECT_EQ(ASSERT_NO_ERRNO_AND_VALUE(GetContents(kPath)), "1\t0\n");
+  ASSERT_NO_ERRNO(SetContents(kPath, "100 2147483648"));
+  EXPECT_EQ(ASSERT_NO_ERRNO_AND_VALUE(GetContents(kPath)),
+            "100\t2147483648\n");
+  // Only the first value given: the second is kept.
+  ASSERT_NO_ERRNO(SetContents(kPath, "200"));
+  EXPECT_EQ(ASSERT_NO_ERRNO_AND_VALUE(GetContents(kPath)),
+            "200\t2147483648\n");
+  // GID_T_MAX is the largest group.
+  EXPECT_THAT(SetContents(kPath, "0 4294967295"),
+              PosixErrorIs(EINVAL, ::testing::_));
+  EXPECT_THAT(SetContents(kPath, "-1 0"), PosixErrorIs(EINVAL, ::testing::_));
+  EXPECT_EQ(ASSERT_NO_ERRNO_AND_VALUE(GetContents(kPath)),
+            "200\t2147483648\n");
+
+  // Another namespace keeps its own.
+  Cleanup restore2 = ASSERT_NO_ERRNO_AND_VALUE(EnterNewNetns());
+  EXPECT_EQ(ASSERT_NO_ERRNO_AND_VALUE(GetContents(kPath)),
+            IsRunningOnGvisor() ? "0\t4294967294\n" : "1\t0\n");
+}
