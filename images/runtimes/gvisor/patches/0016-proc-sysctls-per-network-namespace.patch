+// NetSysctlStack is implemented by a Stack that keeps the /proc/sys/net
+// settings of its network namespace that are not global in gVisor: those of
+// each interface, in /proc/sys/net/ipv4/conf/<interface> and
+// /proc/sys/net/ipv6/conf/<interface>, and net.ipv4.ping_group_range.
+type NetSysctlStack interface {
+	// InterfaceConf returns the setting name of interface idx for family
+	// (linux.AF_INET or linux.AF_INET6). It fails with ENOENT for a setting
+	// the interface does not have.
+	InterfaceConf(idx int32, family uint8, name string) (int32, error)
+
+	// SetInterfaceConf changes the setting name of interface idx for family.
+	SetInterfaceConf(idx int32, family uint8, name string, v int32) error
+
+	// InterfaceConfNames returns the names of the settings each interface has
+	// for family.
+	InterfaceConfNames(family uint8) []string
+
+	// PingGroupRange returns net.ipv4.ping_group_range, as group IDs in the
+	// root user namespace.
+	PingGroupRange() (low, high uint32)
+
+	// SetPingGroupRange sets net.ipv4.ping_group_range.
+	SetPingGroupRange(low, high uint32)
+}
