+
+// openerNetworkNamespace returns the network namespace of the task in ctx, or
+// the root network namespace if ctx has no task. Linux resolves /proc/sys/net
+// entries in current's network namespace when they are looked up
+// (net/sysctl_net.c:net_ctl_header_lookup()), and an open file keeps referring
+// to that namespace.
+func openerNetworkNamespace(ctx context.Context) *inet.Namespace {
+	if t := kernel.TaskFromContext(ctx); t != nil {
+		return t.NetworkNamespace()
+	}
+	return kernel.KernelFromContext(ctx).RootNetworkNamespace()
+}
+
+// openerNetSysctlStack returns the stack of the opener's network namespace if
+// it keeps per-namespace sysctls.
+func openerNetSysctlStack(ctx context.Context) (*inet.Namespace, inet.Stack, inet.NetSysctlStack, bool) {
+	netns := openerNetworkNamespace(ctx)
+	if netns == nil {
+		return nil, nil, nil, false
+	}
+	stack := netns.Stack()
+	if stack == nil {
+		return nil, nil, nil, false
+	}
+	sysctls, ok := stack.(inet.NetSysctlStack)
+	return netns, stack, sysctls, ok
+}
+
+// interfaceIndex returns the index of the interface of stack named name.
+func interfaceIndex(stack inet.Stack, name string) (int32, bool) {
+	for idx, i := range stack.Interfaces() {
+		if i.Name == name {
+			return idx, true
+		}
+	}
+	return 0, false
+}
+
+// checkNetSysctlPermissions checks access to a /proc/sys/net file of network
+// namespace netns: as in Linux's net/sysctl_net.c:net_ctl_permissions(), a
+// caller with CAP_NET_ADMIN in the user namespace that owns it gets the
+// owner's access.
+func checkNetSysctlPermissions(ctx context.Context, netns *inet.Namespace, attrs *kernfs.InodeAttrs, creds *auth.Credentials, ats vfs.AccessTypes) error {
+	if netns != nil && creds.HasCapabilityIn(linux.CAP_NET_ADMIN, netns.UserNamespace()) {
+		// fs/proc/proc_sysctl.c:proc_sys_permission() never allows execute.
+		owner := vfs.AccessTypes(attrs.Mode().Permissions()>>6) & (vfs.MayRead | vfs.MayWrite | vfs.MayExec)
+		if !ats.MayExec() && ats&owner == ats {
+			return nil
+		}
+		return linuxerr.EACCES
+	}
+	return attrs.CheckPermissions(ctx, creds, ats)
+}
+
+// recheckNetSysctlPermissions checks access to a /proc/sys/net file again when
+// it is read or written, as Linux's fs/proc/proc_sysctl.c:
+// proc_sys_call_handler() does with sysctl_perm(): a file opened by a
+// process that may write it is not written by one that may not.
+func recheckNetSysctlPermissions(ctx context.Context, netns *inet.Namespace, attrs *kernfs.InodeAttrs, ats vfs.AccessTypes) error {
+	if err := checkNetSysctlPermissions(ctx, netns, attrs, auth.CredentialsFromContext(ctx), ats); err != nil {
+		return linuxerr.EPERM
+	}
+	return nil
+}
+
+// netConfDir is /proc/sys/net/ipv4/conf or /proc/sys/net/ipv6/conf: "all" and
+// "default", and a directory for each interface of the opener's network
+// namespace, as Linux registers one for each device in its namespace
+// (net/ipv4/devinet.c:devinet_sysctl_register(),
+// net/ipv6/addrconf.c:addrconf_sysctl_register()).
+//
+// +stateify savable
+type netConfDir struct {
+	lazySysDir
+
+	// family is linux.AF_INET or linux.AF_INET6. Immutable.
+	family uint8
+}
+
+var _ kernfs.Inode = (*netConfDir)(nil)
+
+func (fs *filesystem) newNetConfDir(ctx context.Context, creds *auth.Credentials, k *kernel.Kernel, path string, family uint8) kernfs.Inode {
+	d := &netConfDir{family: family}
+	d.lazySysDir.init(ctx, fs, creds, k, path)
+	return d
+}
+
+// Lookup implements kernfs.Inode.Lookup.
+func (d *netConfDir) Lookup(ctx context.Context, name string) (kernfs.Inode, error) {
+	inode, err := d.lazySysDir.Lookup(ctx, name)
+	if !linuxerr.Equals(linuxerr.ENOENT, err) {
+		return inode, err
+	}
+	netns, stack, sysctls, ok := openerNetSysctlStack(ctx)
+	if !ok {
+		return nil, linuxerr.ENOENT
+	}
+	if _, ok := interfaceIndex(stack, name); !ok {
+		return nil, linuxerr.ENOENT
+	}
+	return d.fs.newNetDevConfDir(ctx, d.creds, netns, d.family, name, sysctls.InterfaceConfNames(d.family)), nil
+}
+
+// IterDirents implements kernfs.Inode.IterDirents. It lists the interfaces of
+// the opener's network namespace after "all" and "default", by name.
+func (d *netConfDir) IterDirents(ctx context.Context, mnt *vfs.Mount, cb vfs.IterDirentsCallback, offset, relOffset int64) (int64, error) {
+	_, stack, _, ok := openerNetSysctlStack(ctx)
+	if !ok {
+		return offset, nil
+	}
+	var names []string
+	for _, i := range stack.Interfaces() {
+		names = append(names, i.Name)
+	}
+	slices.Sort(names)
+	for i := relOffset; i >= 0 && i < int64(len(names)); i++ {
+		dirent := vfs.Dirent{
+			Name:    names[i],
+			Type:    linux.DT_DIR,
+			Ino:     d.fs.NextIno(),
+			NextOff: offset + 1,
+		}
+		if err := cb.Handle(dirent); err != nil {
+			return offset, err
+		}
+		offset++
+	}
+	return offset, nil
+}
+
+// netDevConfDir is /proc/sys/net/ipv4/conf/<interface> or
+// /proc/sys/net/ipv6/conf/<interface>, of the interface of that name in the
+// network namespace of the task that looked it up. As in Linux, whose
+// proc_sys_lookup() finds a directory's entries in the directory's own sysctl
+// header, its files stay that namespace's when they are reached through it,
+// as through a file descriptor of it kept across setns(2).
+//
+// +stateify savable
+type netDevConfDir struct {
+	kernfs.StaticDirectory
+
+	// netns is the network namespace of the interface. Immutable.
+	netns *inet.Namespace
+
+	// name is the interface's name. Immutable.
+	name string
+}
+
+var _ kernfs.Inode = (*netDevConfDir)(nil)
+
+func (fs *filesystem) newNetDevConfDir(ctx context.Context, creds *auth.Credentials, netns *inet.Namespace, family uint8, name string, settings []string) kernfs.Inode {
+	children := make(map[string]kernfs.Inode, len(settings))
+	for _, setting := range settings {
+		f := &netDevConfFile{netns: netns, family: family, ifName: name, name: setting}
+		children[setting] = fs.newInode(ctx, creds, 0644, f)
+	}
+	d := &netDevConfDir{netns: netns, name: name}
+	d.StaticDirectory.Init(ctx, creds, linux.UNNAMED_MAJOR, fs.devMinor, fs.NextIno(), 0555, kernfs.GenericDirectoryFDOptions{
+		SeekEnd: kernfs.SeekEndZero,
+	})
+	d.InitRefs()
+	d.OrderedChildren.Init(kernfs.OrderedChildrenOptions{})
+	d.IncLinks(d.OrderedChildren.Populate(children))
+	return d
+}
+
+// Valid implements kernfs.Inode.Valid. A path looked up again finds the
+// directory of an interface valid while it is of the looker's network
+// namespace and that namespace has an interface of its name, as Linux's
+// proc_sys_revalidate() and proc_sys_compare() take a sysctl entry while its
+// header is registered and seen by current (net_ctl_is_seen()).
+func (d *netDevConfDir) Valid(ctx context.Context, _ *kernfs.Dentry, _ string) bool {
+	if openerNetworkNamespace(ctx) != d.netns {
+		return false
+	}
+	stack := d.netns.Stack()
+	if stack == nil {
+		return false
+	}
+	_, ok := interfaceIndex(stack, d.name)
+	return ok
+}
+
+// netDevConfFile is a setting in /proc/sys/net/ipv4/conf/<interface> or
+// /proc/sys/net/ipv6/conf/<interface>, of the interface of that name in netns.
+//
+// +stateify savable
+type netDevConfFile struct {
+	kernfs.DynamicBytesFile
+
+	// netns, family, ifName and name identify the setting. Immutable.
+	netns  *inet.Namespace
+	family uint8
+	ifName string
+	name   string
+}
+
+var _ dynamicInode = (*netDevConfFile)(nil)
+
+// Init implements dynamicInode.Init.
+func (f *netDevConfFile) Init(ctx context.Context, creds *auth.Credentials, devMajor, devMinor uint32, ino uint64, _ vfs.DynamicBytesSource, perm linux.FileMode) {
+	f.DynamicBytesFile.Init(ctx, creds, devMajor, devMinor, ino, nil, perm)
+	f.SetDataSourceProvider(f)
+}
+
+// CheckPermissions implements kernfs.Inode.CheckPermissions.
+func (f *netDevConfFile) CheckPermissions(ctx context.Context, creds *auth.Credentials, ats vfs.AccessTypes) error {
+	return checkNetSysctlPermissions(ctx, f.netns, &f.InodeAttrs, creds, ats)
+}
+
+// DataSource implements kernfs.DataSourceProvider.DataSource.
+func (f *netDevConfFile) DataSource(ctx context.Context) (vfs.DynamicBytesSource, error) {
+	stack := f.netns.Stack()
+	if stack == nil {
+		return nil, linuxerr.ENOENT
+	}
+	idx, ok := interfaceIndex(stack, f.ifName)
+	if !ok {
+		return nil, linuxerr.ENOENT
+	}
+	return &netDevConfData{file: f, idx: idx}, nil
+}
+
+// Generate implements vfs.DynamicBytesSource.Generate.
+func (*netDevConfFile) Generate(context.Context, *bytes.Buffer) error {
+	panic("unreachable: netDevConfFile has a DataSourceProvider")
+}
+
+// netDevConfData implements vfs.WritableDynamicBytesSource for a setting of
+// one interface. It holds the namespace rather than its stack because a
+// restore gives child namespaces new stacks.
+//
+// +stateify savable
+type netDevConfData struct {
+	// file is the setting. Immutable.
+	file *netDevConfFile
+	idx  int32
+}
+
+var _ vfs.WritableDynamicBytesSource = (*netDevConfData)(nil)
+
+func (d *netDevConfData) sysctls() (inet.NetSysctlStack, error) {
+	sysctls, ok := d.file.netns.Stack().(inet.NetSysctlStack)
+	if !ok {
+		return nil, linuxerr.ENOENT
+	}
+	return sysctls, nil
+}
+
+// Generate implements vfs.DynamicBytesSource.Generate.
+func (d *netDevConfData) Generate(ctx context.Context, buf *bytes.Buffer) error {
+	if err := recheckNetSysctlPermissions(ctx, d.file.netns, &d.file.InodeAttrs, vfs.MayRead); err != nil {
+		return err
+	}
+	sysctls, err := d.sysctls()
+	if err != nil {
+		return err
+	}
+	v, err := sysctls.InterfaceConf(d.idx, d.file.family, d.file.name)
+	if err != nil {
+		return err
+	}
+	_, err = fmt.Fprintf(buf, "%d\n", v)
+	return err
+}
+
+// Write implements vfs.WritableDynamicBytesSource.Write, as Linux's
+// proc_dointvec() does for these settings.
+func (d *netDevConfData) Write(ctx context.Context, _ *vfs.FileDescription, src usermem.IOSequence, offset int64) (int64, error) {
+	if offset != 0 {
+		// No need to handle partial writes thus far.
+		return 0, linuxerr.EINVAL
+	}
+	if err := recheckNetSysctlPermissions(ctx, d.file.netns, &d.file.InodeAttrs, vfs.MayWrite); err != nil {
+		return 0, err
+	}
+	sysctls, err := d.sysctls()
+	if err != nil {
+		return 0, err
+	}
+	buf := make([]int32, 1)
+	n, err := ParseInt32Vec(ctx, src, buf)
+	if err != nil || n == 0 {
+		return 0, err
+	}
+	if err := sysctls.SetInterfaceConf(d.idx, d.file.family, d.file.name, buf[0]); err != nil {
+		return 0, err
+	}
+	return n, nil
+}
+
+// netnsSysctl identifies a netnsSysctlFile.
+//
+// +stateify savable
+type netnsSysctl int
+
+const (
+	pingGroupRangeSysctl netnsSysctl = iota
+)
+
+// netnsSysctlFile is a /proc/sys/net file of the opener's network namespace.
+//
+// +stateify savable
+type netnsSysctlFile struct {
+	kernfs.DynamicBytesFile
+
+	sysctl netnsSysctl
+}
+
+var _ dynamicInode = (*netnsSysctlFile)(nil)
+
+// Init implements dynamicInode.Init.
+func (f *netnsSysctlFile) Init(ctx context.Context, creds *auth.Credentials, devMajor, devMinor uint32, ino uint64, _ vfs.DynamicBytesSource, perm linux.FileMode) {
+	f.DynamicBytesFile.Init(ctx, creds, devMajor, devMinor, ino, nil, perm)
+	f.SetDataSourceProvider(f)
+}
+
+// CheckPermissions implements kernfs.Inode.CheckPermissions.
+func (f *netnsSysctlFile) CheckPermissions(ctx context.Context, creds *auth.Credentials, ats vfs.AccessTypes) error {
+	return checkNetSysctlPermissions(ctx, openerNetworkNamespace(ctx), &f.InodeAttrs, creds, ats)
+}
+
+// DataSource implements kernfs.DataSourceProvider.DataSource.
+func (f *netnsSysctlFile) DataSource(ctx context.Context) (vfs.DynamicBytesSource, error) {
+	netns, _, _, ok := openerNetSysctlStack(ctx)
+	if !ok {
+		return nil, linuxerr.ENOENT
+	}
+	switch f.sysctl {
+	case pingGroupRangeSysctl:
+		return &pingGroupRange{file: f, netns: netns}, nil
+	default:
+		panic(fmt.Sprintf("unknown sysctl: %d", f.sysctl))
+	}
+}
+
+// Generate implements vfs.DynamicBytesSource.Generate.
+func (*netnsSysctlFile) Generate(context.Context, *bytes.Buffer) error {
+	panic("unreachable: netnsSysctlFile has a DataSourceProvider")
+}
+
+// pingGroupRange implements vfs.WritableDynamicBytesSource for
+// /proc/sys/net/ipv4/ping_group_range, as Linux's
+// net/ipv4/sysctl_net_ipv4.c:ipv4_ping_group_range() does. gVisor does not
+// check it when a ping socket is created.
+//
+// +stateify savable
+type pingGroupRange struct {
+	// file is ping_group_range. Immutable.
+	file *netnsSysctlFile
+
+	netns *inet.Namespace
+}
+
+var _ vfs.WritableDynamicBytesSource = (*pingGroupRange)(nil)
+
+// gidTMax is Linux's GID_T_MAX (include/net/ping.h), the largest group ID
+// that ping_group_range takes.
+const gidTMax = math.MaxUint32 - 1
+
+func (p *pingGroupRange) sysctls() (inet.NetSysctlStack, error) {
+	sysctls, ok := p.netns.Stack().(inet.NetSysctlStack)
+	if !ok {
+		return nil, linuxerr.ENOENT
+	}
+	return sysctls, nil
+}
+
+// Generate implements vfs.DynamicBytesSource.Generate. The groups are shown in
+// the reader's user namespace.
+func (p *pingGroupRange) Generate(ctx context.Context, buf *bytes.Buffer) error {
+	if err := recheckNetSysctlPermissions(ctx, p.netns, &p.file.InodeAttrs, vfs.MayRead); err != nil {
+		return err
+	}
+	sysctls, err := p.sysctls()
+	if err != nil {
+		return err
+	}
+	userns := auth.CredentialsFromContext(ctx).UserNamespace
+	low, high := sysctls.PingGroupRange()
+	_, err = fmt.Fprintf(buf, "%d\t%d\n", auth.KGID(low).In(userns).OrOverflow(), auth.KGID(high).In(userns).OrOverflow())
+	return err
+}
+
+// Write implements vfs.WritableDynamicBytesSource.Write. The groups are taken
+// in the writer's user namespace.
+func (p *pingGroupRange) Write(ctx context.Context, _ *vfs.FileDescription, src usermem.IOSequence, offset int64) (int64, error) {
+	if offset != 0 {
+		// No need to handle partial writes thus far.
+		return 0, linuxerr.EINVAL
+	}
+	if err := recheckNetSysctlPermissions(ctx, p.netns, &p.file.InodeAttrs, vfs.MayWrite); err != nil {
+		return 0, err
+	}
+	sysctls, err := p.sysctls()
+	if err != nil {
+		return 0, err
+	}
+	userns := auth.CredentialsFromContext(ctx).UserNamespace
+	low, high := sysctls.PingGroupRange()
+	urange := []uint64{uint64(auth.KGID(low).In(userns).OrOverflow()), uint64(auth.KGID(high).In(userns).OrOverflow())}
+	n, err := parseUint64Vec(ctx, src, urange, gidTMax)
+	if err != nil || n == 0 {
+		return 0, err
+	}
+	kLow := userns.MapToKGID(auth.GID(urange[0]))
+	kHigh := userns.MapToKGID(auth.GID(urange[1]))
+	if !kLow.Ok() || !kHigh.Ok() {
+		return 0, linuxerr.EINVAL
+	}
+	if urange[1] < urange[0] || kHigh < kLow {
+		// An empty range is stored as Linux's "1 0".
+		kLow, kHigh = 1, 0
+	}
+	sysctls.SetPingGroupRange(uint32(kLow), uint32(kHigh))
+	return n, nil
+}
+
+// parseUint64Vec parses whitespace-separated decimal values from src into
+// dsts, as Linux's proc_doulongvec_minmax() does with the range 0 to max: a
+// value that is negative, above max or not a number is EINVAL, and values not
+// given keep theirs.
+func parseUint64Vec(ctx context.Context, src usermem.IOSequence, dsts []uint64, max uint64) (int64, error) {
+	if src.NumBytes() == 0 {
+		return 0, nil
+	}
+	// Limit input size so as not to impact performance if input size is large.
+	src = src.TakeFirst(int(hostarch.PageSize) - 1)
+	buf := make([]byte, src.NumBytes())
+	n, err := src.CopyIn(ctx, buf)
+	if err != nil {
+		return 0, err
+	}
+	fields := strings.Fields(string(buf[:n]))
+	if len(fields) == 0 {
+		return 0, linuxerr.EINVAL
+	}
+	vals := slices.Clone(dsts)
+	for i := 0; i < len(fields) && i < len(vals); i++ {
+		v, err := strconv.ParseUint(fields[i], 10, 64)
+		if err != nil || v > max {
+			return 0, linuxerr.EINVAL
+		}
+		vals[i] = v
+	}
+	copy(dsts, vals)
+	return int64(n), nil
+}
