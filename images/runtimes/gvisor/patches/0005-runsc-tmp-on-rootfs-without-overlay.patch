+// TestMountTmp checks that an empty /tmp gets runsc's internal tmpfs unless the
+// root filesystem is writable and has no overlay.
+func TestMountTmp(t *testing.T) {
+	for _, tc := range []struct {
+		name     string
+		readonly bool
+		upper    specutils.GoferMountConfUpperType
+		want     string // The type of the filesystem at /tmp.
+	}{
+		{name: "overlay", upper: specutils.MemoryOverlay, want: tmpfs.Name},
+		{name: "no overlay", upper: specutils.NoOverlay, want: gofer.Name},
+		{name: "read-only root", readonly: true, upper: specutils.NoOverlay, want: tmpfs.Name},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			rootDir := t.TempDir()
+			if err := os.Mkdir(filepath.Join(rootDir, "tmp"), 0777); err != nil {
+				t.Fatalf("os.Mkdir: %v", err)
+			}
+			spec := testSpec()
+			spec.Root = &specs.Root{Path: rootDir, Readonly: tc.readonly}
+			spec.Mounts = []specs.Mount{{Destination: "/proc", Type: "tmpfs"}}
+			l, loaderCleanup, err := createLoader(testConfig(), spec)
+			if err != nil {
+				t.Fatalf("failed to create loader: %v", err)
+			}
+			defer l.Destroy()
+			defer loaderCleanup()
+
+			l.mu.Lock()
+			defer l.mu.Unlock()
+			l.root.goferMountConfs = []specutils.GoferMountConf{{Lower: specutils.Lisafs, Upper: tc.upper}}
+			mntr := l.newContainerMounter(&l.root)
+			ctx := l.k.SupervisorContext()
+			creds := auth.NewRootCredentials(l.root.procArgs.Credentials.UserNamespace)
+			mns, err := mntr.mountAll(ctx, creds, l.root.spec, l.root.conf, &l.root.procArgs)
+			if err != nil {
+				t.Fatalf("mountAll: %v", err)
+			}
+			root := mns.Root(ctx)
+			defer root.DecRef(ctx)
+			tmp, err := l.k.VFS().GetDentryAt(ctx, creds, &vfs.PathOperation{Root: root, Start: root, Path: fspath.Parse("/tmp")}, &vfs.GetDentryOptions{})
+			if err != nil {
+				t.Fatalf("GetDentryAt(/tmp): %v", err)
+			}
+			defer tmp.DecRef(ctx)
+			if got := tmp.Mount().Filesystem().FilesystemType().Name(); got != tc.want {
+				t.Errorf("/tmp is on %s, want %s", got, tc.want)
+			}
+		})
+	}
+}
+
 type createMountPointTestCase struct {
 	name string
 	path string
