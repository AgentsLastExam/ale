+
+// compatTCPUDPMatch implements the xt_tcp and xt_udp matches, which
+// iptables-nft before 1.8.8, such as Ubuntu 22.04's 1.8.7, uses for --sport,
+// --dport and --tcp-flags.
+// Ref: net/netfilter/xt_tcpudp.c
+type compatTCPUDPMatch struct {
+	// name is MatchTCP or MatchUDP.
+	name string
+	// revision is the match extension revision.
+	revision uint32
+	// infoData is the raw netlink attribute payload; saved for dump.
+	infoData []byte
+	// info is the match's xt_tcp; an xt_udp sets only its ports and
+	// InverseFlags, whose bits for the ports are the same.
+	info linux.XTTCP
+}
+
+// xtAlign is the size an xtables extension's info takes: XT_ALIGN() in
+// include/uapi/linux/netfilter/x_tables.h.
+func xtAlign(size int) int {
+	return (size + 7) &^ 7
+}
+
+// xtInfoFits reports whether an info of length n holds an extension's info of
+// size, as Linux takes it: at least size bytes (nft_match_select_ops()), and
+// the same once aligned (xt_check_match()).
+func xtInfoFits(n, size int) bool {
+	return n >= size && xtAlign(n) == xtAlign(size)
+}
+
+// parseTCPUDPMatch decodes a tcp or udp match's info.
+// Ref: net/netfilter/xt_tcpudp.c:tcp_mt_check(), udp_mt_check() and
+// net/netfilter/x_tables.c:xt_check_match()
+func parseTCPUDPMatch(name string, rev uint32, infoData []byte) (operation, *syserr.AnnotatedError) {
+	op := &compatTCPUDPMatch{name: name, revision: rev, infoData: infoData}
+	if name == MatchTCP {
+		if !xtInfoFits(len(infoData), linux.SizeOfXTTCP) {
+			return nil, syserr.NewAnnotatedError(syserr.ErrInvalidArgument, fmt.Sprintf("tcp info size %d, want %d", len(infoData), linux.SizeOfXTTCP))
+		}
+		op.info.UnmarshalBytes(infoData[:linux.SizeOfXTTCP])
+		if op.info.InverseFlags&^linux.XT_TCP_INV_MASK != 0 {
+			return nil, syserr.NewAnnotatedError(syserr.ErrInvalidArgument, fmt.Sprintf("tcp inverse flags %#x unknown", op.info.InverseFlags))
+		}
+		return op, nil
+	}
+	if !xtInfoFits(len(infoData), linux.SizeOfXTUDP) {
+		return nil, syserr.NewAnnotatedError(syserr.ErrInvalidArgument, fmt.Sprintf("udp info size %d, want %d", len(infoData), linux.SizeOfXTUDP))
+	}
+	var udp linux.XTUDP
+	udp.UnmarshalBytes(infoData[:linux.SizeOfXTUDP])
+	if udp.InverseFlags&^linux.XT_UDP_INV_MASK != 0 {
+		return nil, syserr.NewAnnotatedError(syserr.ErrInvalidArgument, fmt.Sprintf("udp inverse flags %#x unknown", udp.InverseFlags))
+	}
+	op.info = linux.XTTCP{
+		SourcePortStart:      udp.SourcePortStart,
+		SourcePortEnd:        udp.SourcePortEnd,
+		DestinationPortStart: udp.DestinationPortStart,
+		DestinationPortEnd:   udp.DestinationPortEnd,
+		InverseFlags:         udp.InverseFlags,
+	}
+	return op, nil
+}
+
+// portMatch reports whether port is within [start, end], inverted by invert.
+// Ref: net/netfilter/xt_tcpudp.c:port_match()
+func portMatch(start, end, port uint16, invert bool) bool {
+	return (port >= start && port <= end) != invert
+}
+
+// match reports whether pkt matches, and whether it must be dropped instead,
+// as Linux's matches set hotdrop for a header too short to read.
+// Ref: net/netfilter/xt_tcpudp.c:tcp_mt(), udp_mt()
+func (op *compatTCPUDPMatch) match(pkt *stack.PacketBuffer) (matched bool, drop bool) {
+	protocol, minimum := header.UDPProtocolNumber, header.UDPMinimumSize
+	if op.name == MatchTCP {
+		protocol, minimum = header.TCPProtocolNumber, header.TCPMinimumSize
+	}
+	// Linux relies on the rule's own protocol match before this one; a packet
+	// of another protocol never matches here.
+	switch pkt.NetworkProtocolNumber {
+	case header.IPv4ProtocolNumber:
+		net := header.IPv4(pkt.NetworkHeader().Slice())
+		if len(net) < header.IPv4MinimumSize || net.TransportProtocol() != protocol {
+			return false, false
+		}
+		// A fragment other than the first never matches; a TCP one at offset
+		// 8, which could overwrite the first one's flags, is dropped.
+		if offset := net.FragmentOffset(); offset != 0 {
+			return false, op.name == MatchTCP && offset == 8
+		}
+	case header.IPv6ProtocolNumber:
+		if pkt.TransportProtocolNumber != protocol {
+			return false, false
+		}
+	default:
+		return false, false
+	}
+	transport := pkt.TransportHeader().Slice()
+	if len(transport) < minimum {
+		return false, true
+	}
+	info := &op.info
+	var source, destination uint16
+	if op.name == MatchTCP {
+		source, destination = header.TCP(transport).SourcePort(), header.TCP(transport).DestinationPort()
+	} else {
+		source, destination = header.UDP(transport).SourcePort(), header.UDP(transport).DestinationPort()
+	}
+	if !portMatch(info.SourcePortStart, info.SourcePortEnd, source, info.InverseFlags&linux.XT_TCP_INV_SRCPT != 0) ||
+		!portMatch(info.DestinationPortStart, info.DestinationPortEnd, destination, info.InverseFlags&linux.XT_TCP_INV_DSTPT != 0) {
+		return false, false
+	}
+	if op.name == MatchUDP {
+		return true, false
+	}
+	tcp := header.TCP(transport)
+	if (uint8(tcp.Flags())&info.FlagMask == info.FlagCompare) == (info.InverseFlags&linux.XT_TCP_INV_FLAGS != 0) {
+		return false, false
+	}
+	if info.Option == 0 {
+		return true, false
+	}
+	offset := int(tcp.DataOffset())
+	if offset < header.TCPMinimumSize {
+		return false, true
+	}
+	if len(transport) < offset {
+		return false, true
+	}
+	return findTCPOption(info.Option, transport[header.TCPMinimumSize:offset], info.InverseFlags&linux.XT_TCP_INV_OPTION != 0), false
+}
+
+// findTCPOption reports whether options hold option, inverted by invert.
+// Ref: net/netfilter/xt_tcpudp.c:tcp_find_option()
+func findTCPOption(option uint8, options []byte, invert bool) bool {
+	for i := 0; i < len(options); {
+		if options[i] == option {
+			return !invert
+		}
+		if options[i] < 2 || i+1 >= len(options) || options[i+1] == 0 {
+			i++
+		} else {
+			i += int(options[i+1])
+		}
+	}
+	return invert
+}
+
+// evaluate implements operation.evaluate.
+// Ref: net/netfilter/nft_compat.c:nft_match_eval()
+func (op *compatTCPUDPMatch) evaluate(regs *registerSet, evalCtx opEvalCtx) {
+	matched, drop := op.match(evalCtx.pkt)
+	switch {
+	case drop:
+		regs.verdict = Verdict{Code: VC(linux.NF_DROP)}
+	case matched:
+		regs.verdict = Verdict{Code: VC(linux.NFT_CONTINUE)}
+	default:
+		regs.verdict = Verdict{Code: VC(linux.NFT_BREAK)}
+	}
+}
+
+// checkCompatibility implements operation.checkCompatibility.
+func (op *compatTCPUDPMatch) checkCompatibility(cCtx *opCompatCtx) *syserr.AnnotatedError {
+	return nil
+}
+
+// deepCopy implements operation.deepCopy.
+func (op *compatTCPUDPMatch) deepCopy() operation {
+	opCopy := *op
+	opCopy.infoData = append([]byte(nil), op.infoData...)
+	return &opCopy
+}
+
+// updateReferences implements operation.updateReferences.
+func (op *compatTCPUDPMatch) updateReferences(_ *Table, _ *Table, _ operation) {}
+
+// destroy implements operation.destroy.
+func (op *compatTCPUDPMatch) destroy() {}
+
+// GetExprName implements operation.GetExprName.
+func (op *compatTCPUDPMatch) GetExprName() string {
+	return OpTypeMatch.String()
+}
+
+// Dump implements operation.Dump.
+// Ref: net/netfilter/nft_compat.c:__nft_match_dump()
+func (op *compatTCPUDPMatch) Dump() ([]byte, *syserr.AnnotatedError) {
+	m := &nlmsg.Message{}
+	m.PutAttrString(linux.NFTA_MATCH_NAME, op.name)
+	m.PutAttr(linux.NFTA_MATCH_REV, nlmsg.PutU32(op.revision))
+	m.PutAttr(linux.NFTA_MATCH_INFO, primitive.AsByteSlice(op.infoData))
+	return m.Buffer(), nil
+}
