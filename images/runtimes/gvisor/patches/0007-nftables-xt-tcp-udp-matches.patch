+// Tests evaluating the compat tcp and udp matches, which iptables-nft 1.8.7
+// writes for --sport, --dport and --tcp-flags.
+func TestCompatTCPUDPMatchEvaluation(t *testing.T) {
+	src := tcpip.AddrFrom4([4]byte{10, 0, 0, 1})
+	dst := tcpip.AddrFrom4([4]byte{10, 0, 0, 2})
+	tcpPacket := func(srcPort, dstPort uint16, flags header.TCPFlags) *stack.PacketBuffer {
+		return makeIPv4TCPPacket(header.IPv4MinimumSize+header.TCPMinimumSize, &header.IPv4Fields{
+			TotalLength: header.IPv4MinimumSize + header.TCPMinimumSize,
+			TTL:         64,
+			Protocol:    uint8(header.TCPProtocolNumber),
+			SrcAddr:     src,
+			DstAddr:     dst,
+		}, &header.TCPFields{
+			SrcPort:    srcPort,
+			DstPort:    dstPort,
+			DataOffset: header.TCPMinimumSize,
+			Flags:      flags,
+		})
+	}
+	ports := func(sStart, sEnd, dStart, dEnd uint16, invert uint8) linux.XTTCP {
+		return linux.XTTCP{
+			SourcePortStart:      sStart,
+			SourcePortEnd:        sEnd,
+			DestinationPortStart: dStart,
+			DestinationPortEnd:   dEnd,
+			InverseFlags:         invert,
+		}
+	}
+	all := ports(0, 0xffff, 0, 0xffff, 0)
+	for _, tc := range []struct {
+		name string
+		op   *compatTCPUDPMatch
+		pkt  func() *stack.PacketBuffer
+		want uint32
+	}{
+		{
+			name: "udp destination port matches",
+			op:   &compatTCPUDPMatch{name: MatchUDP, info: ports(0, 0xffff, 53, 53, 0)},
+			pkt:  func() *stack.PacketBuffer { return makeUDPv4Packet(src, dst, 40000, 53) },
+			want: VC(linux.NFT_CONTINUE),
+		},
+		{
+			name: "udp destination port mismatches",
+			op:   &compatTCPUDPMatch{name: MatchUDP, info: ports(0, 0xffff, 53, 53, 0)},
+			pkt:  func() *stack.PacketBuffer { return makeUDPv4Packet(src, dst, 40000, 54) },
+			want: VC(linux.NFT_BREAK),
+		},
+		{
+			name: "udp inverted source port range",
+			op:   &compatTCPUDPMatch{name: MatchUDP, info: ports(1000, 2000, 0, 0xffff, linux.XT_UDP_INV_SRCPT)},
+			pkt:  func() *stack.PacketBuffer { return makeUDPv4Packet(src, dst, 1500, 53) },
+			want: VC(linux.NFT_BREAK),
+		},
+		{
+			name: "udp match never takes tcp",
+			op:   &compatTCPUDPMatch{name: MatchUDP, info: all},
+			pkt:  func() *stack.PacketBuffer { return tcpPacket(40000, 53, header.TCPFlagSyn) },
+			want: VC(linux.NFT_BREAK),
+		},
+		{
+			name: "tcp destination port in range",
+			op:   &compatTCPUDPMatch{name: MatchTCP, info: ports(0, 0xffff, 8000, 8080, 0)},
+			pkt:  func() *stack.PacketBuffer { return tcpPacket(40000, 8080, header.TCPFlagSyn) },
+			want: VC(linux.NFT_CONTINUE),
+		},
+		{
+			name: "tcp inverted destination port",
+			op:   &compatTCPUDPMatch{name: MatchTCP, info: ports(0, 0xffff, 80, 80, linux.XT_TCP_INV_DSTPT)},
+			pkt:  func() *stack.PacketBuffer { return tcpPacket(40000, 80, header.TCPFlagSyn) },
+			want: VC(linux.NFT_BREAK),
+		},
+		{
+			name: "tcp syn flags match",
+			op: &compatTCPUDPMatch{name: MatchTCP, info: linux.XTTCP{
+				SourcePortEnd: 0xffff, DestinationPortEnd: 0xffff,
+				FlagMask:    uint8(header.TCPFlagSyn | header.TCPFlagAck | header.TCPFlagRst | header.TCPFlagFin),
+				FlagCompare: uint8(header.TCPFlagSyn),
+			}},
+			pkt:  func() *stack.PacketBuffer { return tcpPacket(40000, 80, header.TCPFlagSyn) },
+			want: VC(linux.NFT_CONTINUE),
+		},
+		{
+			name: "tcp syn flags mismatch an ack",
+			op: &compatTCPUDPMatch{name: MatchTCP, info: linux.XTTCP{
+				SourcePortEnd: 0xffff, DestinationPortEnd: 0xffff,
+				FlagMask:    uint8(header.TCPFlagSyn | header.TCPFlagAck | header.TCPFlagRst | header.TCPFlagFin),
+				FlagCompare: uint8(header.TCPFlagSyn),
+			}},
+			pkt:  func() *stack.PacketBuffer { return tcpPacket(40000, 80, header.TCPFlagAck) },
+			want: VC(linux.NFT_BREAK),
+		},
+		{
+			name: "tcp option absent",
+			op:   &compatTCPUDPMatch{name: MatchTCP, info: linux.XTTCP{SourcePortEnd: 0xffff, DestinationPortEnd: 0xffff, Option: 2}},
+			pkt:  func() *stack.PacketBuffer { return tcpPacket(40000, 80, header.TCPFlagSyn) },
+			want: VC(linux.NFT_BREAK),
+		},
+		{
+			name: "tcp header too short is dropped",
+			op:   &compatTCPUDPMatch{name: MatchTCP, info: all},
+			pkt: func() *stack.PacketBuffer {
+				return makeIPv4Packet(header.IPv4MinimumSize, &header.IPv4Fields{
+					TotalLength: header.IPv4MinimumSize,
+					TTL:         64,
+					Protocol:    uint8(header.TCPProtocolNumber),
+					SrcAddr:     src,
+					DstAddr:     dst,
+				})
+			},
+			want: VC(linux.NF_DROP),
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			pkt := tc.pkt()
+			defer pkt.DecRef()
+			regs := &registerSet{verdict: Verdict{Code: VC(linux.NFT_CONTINUE)}}
+			tc.op.evaluate(regs, opEvalCtx{pkt: pkt})
+			if regs.verdict.Code != tc.want {
+				t.Errorf("evaluate verdict = %d, want %d", regs.verdict.Code, tc.want)
+			}
+		})
+	}
+}
+
+// Tests parsing the compat tcp and udp matches' info.
+func TestCompatTCPUDPMatchParse(t *testing.T) {
+	tcp := linux.XTTCP{DestinationPortStart: 53, DestinationPortEnd: 53, InverseFlags: linux.XT_TCP_INV_SRCPT}
+	tcpInfo := make([]byte, linux.SizeOfXTTCP)
+	tcp.MarshalBytes(tcpInfo)
+	udp := linux.XTUDP{DestinationPortStart: 53, DestinationPortEnd: 53}
+	udpInfo := make([]byte, linux.SizeOfXTUDP)
+	udp.MarshalBytes(udpInfo)
+	for _, tc := range []struct {
+		name    string
+		match   string
+		info    []byte
+		wantErr bool
+	}{
+		{name: "tcp as iptables sends it", match: MatchTCP, info: append(append([]byte(nil), tcpInfo...), 0, 0, 0, 0)},
+		{name: "tcp unaligned", match: MatchTCP, info: tcpInfo},
+		{name: "tcp too short", match: MatchTCP, info: tcpInfo[:8], wantErr: true},
+		{name: "tcp too long", match: MatchTCP, info: make([]byte, 24), wantErr: true},
+		{name: "tcp unknown inverse flag", match: MatchTCP, info: func() []byte {
+			b := append([]byte(nil), tcpInfo...)
+			b[linux.SizeOfXTTCP-1] = 0x10
+			return b
+		}(), wantErr: true},
+		{name: "udp as iptables sends it", match: MatchUDP, info: append(append([]byte(nil), udpInfo...), 0, 0, 0, 0, 0, 0)},
+		{name: "udp unknown inverse flag", match: MatchUDP, info: func() []byte {
+			b := append([]byte(nil), udpInfo...)
+			b[8] = 0x04
+			return b
+		}(), wantErr: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			op, err := parseTCPUDPMatch(tc.match, 0, tc.info)
+			if (err != nil) != tc.wantErr {
+				t.Fatalf("parseTCPUDPMatch() error = %v, want error %t", err, tc.wantErr)
+			}
+			if err != nil {
+				return
+			}
+			got := op.(*compatTCPUDPMatch).info
+			if got.DestinationPortStart != 53 || got.DestinationPortEnd != 53 {
+				t.Errorf("parsed destination ports %d-%d, want 53-53", got.DestinationPortStart, got.DestinationPortEnd)
+			}
+		})
+	}
+}
