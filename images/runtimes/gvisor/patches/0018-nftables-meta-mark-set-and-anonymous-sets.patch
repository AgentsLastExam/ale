+// newSetTestTable returns an NFTables with one inet table for set tests.
+func newSetTestTable(tabName string) (*NFTables, *Table) {
+	nf := &NFTables{}
+	nf.filters[stack.Inet] = &addressFamilyFilter{
+		family: stack.Inet,
+		tables: make(map[string]*Table),
+	}
+	tab := &Table{
+		name:       tabName,
+		sets:       make(map[string]*nftSet),
+		setHandles: make(map[uint64]*nftSet),
+		afFilter:   nf.filters[stack.Inet],
+	}
+	nf.filters[stack.Inet].tables[tabName] = tab
+	return nf, tab
+}
+
+func be32(v uint32) nlmsg.BytesView {
+	return nlmsg.BytesView(binary.BigEndian.AppendUint32(nil, v))
+}
+
+// TestNewSetOfKeys tests sets without data, which netavark's anonymous sets,
+// such as "meta l4proto { udp, tcp }", are.
+func TestNewSetOfKeys(t *testing.T) {
+	for _, tc := range []struct {
+		name  string
+		flags uint16
+		want  *syserr.Error
+	}{
+		{name: "named", flags: 0},
+		{name: "anonymous constant", flags: linux.NFT_SET_ANONYMOUS | linux.NFT_SET_CONSTANT},
+		{name: "concatenation", flags: linux.NFT_SET_CONCAT, want: syserr.ErrInvalidArgument},
+		{name: "intervals", flags: linux.NFT_SET_INTERVAL, want: syserr.ErrNotSupported},
+		{name: "timeouts", flags: linux.NFT_SET_TIMEOUT, want: syserr.ErrNotSupported},
+		{name: "updated by rules", flags: linux.NFT_SET_EVAL, want: syserr.ErrNotSupported},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			nf, tab := newSetTestTable("t")
+			attrs := map[uint16]nlmsg.BytesView{
+				linux.NFTA_SET_TABLE:   nlmsg.BytesView("t"),
+				linux.NFTA_SET_NAME:    nlmsg.BytesView("s"),
+				linux.NFTA_SET_ID:      be32(1),
+				linux.NFTA_SET_KEY_LEN: be32(4),
+				linux.NFTA_SET_FLAGS:   be32(uint32(tc.flags)),
+			}
+			err := nf.NewSet(attrs, stack.Inet, linux.NLM_F_CREATE, &nlmsg.MessageSet{PortID: 100})
+			if tc.want != nil {
+				if err == nil || err.GetError() != tc.want {
+					t.Fatalf("NewSet = %v, want %v", err, tc.want)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("NewSet: %v", err)
+			}
+			s, ok := tab.sets["s"]
+			if !ok {
+				t.Fatalf("set s not created")
+			}
+			key := []byte{17, 0, 0, 0}
+			if _, err := s.backend.Add(&nftSetElem{startKey: key}, 0); err != nil {
+				t.Fatalf("Add: %v", err)
+			}
+			if got := s.backend.Find(key); got != 0 {
+				t.Errorf("Find(key) = %d, want 0", got)
+			}
+			if got := s.backend.Find([]byte{6, 0, 0, 0}); got != -1 {
+				t.Errorf("Find(other key) = %d, want -1", got)
+			}
+		})
+	}
+}
