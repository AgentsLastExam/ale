+
+// getSet returns the set of t named name or, if there is none, the set created
+// in the current batch with the transaction ID in attrs[idAttr], as Linux's
+// net/netfilter/nf_tables_api.c:nft_set_lookup_global() does.
+func (t *Table) getSet(name string, attrs map[uint16]nlmsg.BytesView, idAttr uint16) (*nftSet, bool) {
+	if s, ok := t.sets[name]; ok {
+		return s, true
+	}
+	id, ok := AttrNetToHost[uint32](idAttr, attrs)
+	if !ok {
+		return nil, false
+	}
+	s, ok := t.setIDs[id]
+	return s, ok
 }
 
+// allocSetName returns the name of a new set of t asked for as name. A name
+// with one %d, as nft gives an anonymous set, takes the lowest number that no
+// set of t has, as Linux's net/netfilter/nf_tables_api.c:
+// nf_tables_set_alloc_name() does.
+func (t *Table) allocSetName(name string) (string, *syserr.AnnotatedError) {
+	i := strings.IndexByte(name, '%')
+	if i < 0 {
+		return name, nil
+	}
+	if !strings.HasPrefix(name[i:], "%d") || strings.ContainsRune(name[i+2:], '%') || len(name) >= nftSetMaxAnonLen {
+		return "", syserr.NewAnnotatedError(syserr.ErrInvalidArgument, fmt.Sprintf("invalid set name %q", name))
+	}
+	prefix, suffix := name[:i], name[i+2:]
+	inUse := make(map[int]bool)
+	for existing := range t.sets {
+		if len(existing) <= len(prefix)+len(suffix) || !strings.HasPrefix(existing, prefix) || !strings.HasSuffix(existing, suffix) {
+			continue
+		}
+		if n, err := strconv.Atoi(existing[len(prefix) : len(existing)-len(suffix)]); err == nil && n >= 0 {
+			inUse[n] = true
+		}
+	}
+	n := 0
+	for inUse[n] {
+		n++
+	}
+	return fmt.Sprintf("%s%d%s", prefix, n, suffix), nil
+}
+
+// nftSetMaxAnonLen is Linux's NFT_SET_MAX_ANONLEN, the size of the buffer an
+// anonymous set's name is formatted in.
+const nftSetMaxAnonLen = 16
+
 // GetChains returns a map of all chains for the table.
 func (t *Table) GetChains() map[string]*Chain {
 	return t.chains
