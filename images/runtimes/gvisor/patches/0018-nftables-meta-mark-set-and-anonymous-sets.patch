diff --git a/pkg/tcpip/nftables/nftables.go b/pkg/tcpip/nftables/nftables.go
index d19d601..3365e13 100644
--- a/pkg/tcpip/nftables/nftables.go
+++ b/pkg/tcpip/nftables/nftables.go
@@ -18,6 +18,8 @@ import (
 	"fmt"
 	"math"
 	"slices"
