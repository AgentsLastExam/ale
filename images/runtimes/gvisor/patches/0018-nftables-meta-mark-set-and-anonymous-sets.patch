+// TestAnonymousSets tests the names, the transaction IDs and the lifetime of
+// anonymous sets, as nft creates them: named "__set%d", referred to by ID in
+// the batch that creates them, and bound to one rule.
+func TestAnonymousSets(t *testing.T) {
+	nf, tab := newSetTestTable("t")
+	newSet := func(name string, id uint32) *syserr.AnnotatedError {
+		return nf.NewSet(map[uint16]nlmsg.BytesView{
+			linux.NFTA_SET_TABLE:   nlmsg.BytesView("t"),
+			linux.NFTA_SET_NAME:    nlmsg.BytesView(name),
+			linux.NFTA_SET_ID:      be32(id),
+			linux.NFTA_SET_KEY_LEN: be32(4),
+			linux.NFTA_SET_FLAGS:   be32(uint32(linux.NFT_SET_ANONYMOUS | linux.NFT_SET_CONSTANT)),
+		}, stack.Inet, linux.NLM_F_CREATE, &nlmsg.MessageSet{PortID: 100})
+	}
+	byID := func(id uint32) map[uint16]nlmsg.BytesView {
+		return map[uint16]nlmsg.BytesView{linux.NFTA_LOOKUP_SET_ID: be32(id)}
+	}
+
+	// Two anonymous sets in one batch get the lowest free numbers.
+	for _, id := range []uint32{7, 8} {
+		if err := newSet("__set%d", id); err != nil {
+			t.Fatalf("NewSet(__set%%d, %d): %v", id, err)
+		}
+	}
+	for id, want := range map[uint32]string{7: "__set0", 8: "__set1"} {
+		s, ok := tab.getSet("__set%d", byID(id), linux.NFTA_LOOKUP_SET_ID)
+		if !ok || s.name != want {
+			t.Fatalf("set of ID %d = %v, %v; want %s", id, s, ok, want)
+		}
+	}
+	if _, ok := tab.getSet("__set%d", byID(9), linux.NFTA_LOOKUP_SET_ID); ok {
+		t.Errorf("found a set of unknown ID 9")
+	}
+	if s, ok := tab.getSet("__set1", nil, linux.NFTA_LOOKUP_SET_ID); !ok || s.name != "__set1" {
+		t.Errorf("getSet(__set1) = %v, %v; want __set1", s, ok)
+	}
+
+	// Bind __set1 to a rule's lookup; the batch ends.
+	bound := tab.sets["__set1"]
+	lookup := &lookupOp{set: bound}
+	bound.bindings = append(bound.bindings, lookup)
+	nf.PruneUnused()
+	if _, ok := tab.sets["__set0"]; ok {
+		t.Errorf("unbound anonymous set __set0 kept at the end of the batch")
+	}
+	if _, ok := tab.sets["__set1"]; !ok {
+		t.Fatalf("bound anonymous set __set1 removed at the end of the batch")
+	}
+	if _, ok := tab.getSet("__set%d", byID(8), linux.NFTA_LOOKUP_SET_ID); ok {
+		t.Errorf("transaction ID 8 still names a set after its batch")
+	}
+
+	// A later batch reuses the free number; the rule's deletion removes its
+	// set.
+	if err := newSet("__set%d", 7); err != nil {
+		t.Fatalf("NewSet: %v", err)
+	}
+	if s, ok := tab.getSet("__set%d", byID(7), linux.NFTA_LOOKUP_SET_ID); !ok || s.name != "__set0" {
+		t.Fatalf("set of ID 7 = %v, %v; want __set0", s, ok)
+	}
+	tab.sets["__set0"].bindings = append(tab.sets["__set0"].bindings, &lookupOp{set: tab.sets["__set0"]})
+	lookup.destroy()
+	nf.PruneUnused()
+	if _, ok := tab.sets["__set1"]; ok {
+		t.Errorf("anonymous set __set1 kept after the rule bound to it was deleted")
+	}
+	if _, ok := tab.sets["__set0"]; !ok {
+		t.Errorf("bound anonymous set __set0 removed")
+	}
+
+	for _, name := range []string{"__set%s", "__set%d%d", "a%d%%", "__longer_name_%d"} {
+		if err := newSet(name, 1); err == nil || err.GetError() != syserr.ErrInvalidArgument {
+			t.Errorf("NewSet(%q) = %v, want EINVAL", name, err)
+		}
+	}
+}
