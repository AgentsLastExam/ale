+// TestEvaluateMetaSetMark tests meta mark set, as
+// net/netfilter/nft_meta.c:nft_meta_set_eval() sets a packet's mark.
+func TestEvaluateMetaSetMark(t *testing.T) {
+	nf := newNFTablesStd()
+	tab, err := nf.AddTable(arbitraryFamily, "test", false)
+	if err != nil {
+		t.Fatalf("unexpected error for AddTable: %v", err)
+	}
+	bc, err := nf.AddChainToTable(tab, "base_chain", arbitraryInfoPolicyAccept, "test chain", false, 0, nil, linux.NF_ACCEPT)
+	if err != nil {
+		t.Fatalf("unexpected error for AddChain: %v", err)
+	}
+	mark := make([]byte, 4)
+	binary.NativeEndian.PutUint32(mark, 0x2000)
+	rule := &Rule{}
+	rule.addOperation(mustCreateImmediate(t, linux.NFT_REG32_01, mark, Verdict{}))
+	rule.addOperation(mustCreateMetaSet(t, linux.NFT_META_MARK, linux.NFT_REG32_01))
+	if err := bc.RegisterRule(rule, -1); err != nil {
+		t.Fatalf("unexpected error for RegisterRule: %v", err)
+	}
+	pkt := makeIPv4Packet(header.IPv4MinimumSize, arbitraryIPv4Fields())
+	defer pkt.DecRef()
+	pkt.Mark = 0x1
+	if _, err := nf.EvaluateHook(getAddrFamilyOrDefault(pkt, arbitraryFamily), arbitraryHook, pkt, nil /* route */); err != nil {
+		t.Fatalf("unexpected error for EvaluateHook: %v", err)
+	}
+	if pkt.Mark != 0x2000 {
+		t.Errorf("mark = %#x, want 0x2000", pkt.Mark)
+	}
+}
