 	"gvisor.dev/gvisor/pkg/abi/linux"
 	"gvisor.dev/gvisor/pkg/atomicbitops"
@@ -1035,8 +1037,67 @@ func (t *Table) pruneUnused() {
 	}
 	// Clear temporary transaction chain IDs.
 	t.ClearChainIDs()
+	// As Linux, an anonymous set lives as long as the rule bound to it: it
+	// is removed with that rule (net/netfilter/nf_tables_api.c:
+	// nf_tables_deactivate_set()), or at the end of the batch that created it
+	// if no rule was bound to it.
+	for _, s := range t.sets {
