+// routeFilter holds the filters of an RTM_GETROUTE dump request.
+type routeFilter struct {
+	set      bool
+	cloned   bool
+	table    uint32
+	protocol uint8
+	typ      uint8
+	oif      int32
+}
+
+// routeDumpFilter returns the filters of an RTM_GETROUTE dump request from a
+// socket with NETLINK_GET_STRICT_CHK, as Linux's ip_valid_fib_dump_req() takes
+// them for inet_dump_fib() and inet6_dump_fib(): RTM_F_CLONED, the table, the
+// protocol and the type of the header, and the table (RTA_TABLE) and output
+// interface (RTA_OIF) attributes.
+func routeDumpFilter(s *netlink.Socket, stack inet.Stack, msg *nlmsg.Message) (routeFilter, *syserr.Error) {
+	var f routeFilter
+	if !s.StrictCheck() {
+		return f, nil
+	}
+	var rtm linux.RouteMessage
+	attrs, ok := msg.GetData(&rtm)
+	if !ok {
+		return f, nil
+	}
+	f.cloned = rtm.Flags&linux.RTM_F_CLONED != 0
+	f.table, f.protocol, f.typ = uint32(rtm.Table), rtm.Protocol, rtm.Type
+	for !attrs.Empty() {
+		hdr, value, rest, ok := attrs.ParseFirst()
+		if !ok {
+			break
+		}
+		attrs = rest
+		v := nlmsg.BytesView(value)
+		switch hdr.Type {
+		case linux.RTA_TABLE:
+			if table, ok := v.Uint32(); ok {
+				f.table = table
+			}
+		case linux.RTA_OIF:
+			if oif, ok := v.Uint32(); ok {
+				if _, ok := stack.Interfaces()[int32(oif)]; !ok {
+					return f, syserr.ErrNoDevice
+				}
+				f.oif = int32(oif)
+			}
+		}
+	}
+	f.set = f.cloned || f.table != 0 || f.protocol != 0 || f.typ != 0 || f.oif != 0
+	return f, nil
+}
+
+// filtered returns whether a route dump with filter f leaves out rt, as
+// Linux's fib dump functions (fn_trie_dump_leaf(), fib6_dump_node()) do.
+// Netstack has no route cache, so a dump of cloned routes is empty.
+func (f *routeFilter) filtered(rt inet.Route) bool {
+	switch {
+	case f.cloned:
+		return true
+	case f.table != 0 && uint32(rt.Table) != f.table:
+		return true
+	case f.protocol != 0 && rt.Protocol != f.protocol:
+		return true
+	case f.typ != 0 && rt.Type != f.typ:
+		return true
+	case f.oif != 0 && rt.OutputInterface != f.oif:
+		return true
+	}
+	return false
+}
