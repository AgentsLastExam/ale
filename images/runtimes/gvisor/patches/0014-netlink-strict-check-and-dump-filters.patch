+// NETLINK_GET_STRICT_CHK is a flag of the socket, as Linux's
+// netlink_setsockopt() and netlink_getsockopt() keep it.
+TEST(NetlinkRouteTest, GetStrictCheck) {
+  FileDescriptor fd =
+      ASSERT_NO_ERRNO_AND_VALUE(NetlinkBoundSocket(NETLINK_ROUTE));
+  int val = -1;
+  socklen_t len = sizeof(val);
+  ASSERT_THAT(getsockopt(fd.get(), SOL_NETLINK, NETLINK_GET_STRICT_CHK, &val,
+                         &len),
+              SyscallSucceeds());
+  EXPECT_EQ(len, sizeof(val));
+  EXPECT_EQ(val, 0);
+
+  val = 1;
+  ASSERT_THAT(setsockopt(fd.get(), SOL_NETLINK, NETLINK_GET_STRICT_CHK, &val,
+                         sizeof(val)),
+              SyscallSucceeds());
+  val = -1;
+  ASSERT_THAT(getsockopt(fd.get(), SOL_NETLINK, NETLINK_GET_STRICT_CHK, &val,
+                         &len),
+              SyscallSucceeds());
+  EXPECT_EQ(val, 1);
+
+  // A value shorter than an int is taken as 0.
+  char c = 1;
+  ASSERT_THAT(
+      setsockopt(fd.get(), SOL_NETLINK, NETLINK_GET_STRICT_CHK, &c, sizeof(c)),
+      SyscallSucceeds());
+  ASSERT_THAT(getsockopt(fd.get(), SOL_NETLINK, NETLINK_GET_STRICT_CHK, &val,
+                         &len),
+              SyscallSucceeds());
+  EXPECT_EQ(val, 0);
+
+  len = sizeof(c);
+  EXPECT_THAT(
+      getsockopt(fd.get(), SOL_NETLINK, NETLINK_GET_STRICT_CHK, &c, &len),
+      SyscallFailsWithErrno(EINVAL));
+}
