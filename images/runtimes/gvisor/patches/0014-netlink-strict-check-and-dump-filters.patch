+      ASSERT_NO_ERRNO_AND_VALUE(NetlinkBoundSocket(NETLINK_ROUTE));
+  VethRequest veth = GetVethRequest(kSeq, "fltv1", "fltv2");
+  ASSERT_NO_ERRNO(
+      NetlinkRequestAckOrError(fd, kSeq, &veth, veth.hdr.nlmsg_len));
+  BridgeRequest bridge = GetBridgeRequest(kSeq, "fltbr");
+  ASSERT_NO_ERRNO(
+      NetlinkRequestAckOrError(fd, kSeq, &bridge, bridge.hdr.nlmsg_len));
+  auto links = ASSERT_NO_ERRNO_AND_VALUE(DumpLinkAttrs(fd));
+  const int br = links["fltbr"].index;
+
+  struct {
+    struct nlmsghdr hdr;
+    struct ifinfomsg ifm;
+    char buf[64];
+  } req = {};
+  auto request = [&] {
+    req = {};
+    req.hdr.nlmsg_len = NLMSG_LENGTH(sizeof(struct ifinfomsg));
+    req.hdr.nlmsg_type = RTM_GETLINK;
+    req.hdr.nlmsg_flags = NLM_F_REQUEST | NLM_F_DUMP;
+    req.hdr.nlmsg_seq = kSeq;
+    req.ifm.ifi_family = AF_UNSPEC;
+  };
+  auto names = [](const std::map<std::string, LinkAttrs>& links) {
+    std::vector<std::string> names;
+    for (const auto& [name, attrs] : links) {
+      names.push_back(name);
+      EXPECT_NE(attrs.nlmsg_flags & NLM_F_DUMP_FILTERED, 0) << name;
+    }
+    return names;
+  };
+
+  // No port yet.
+  request();
+  uint32_t master = br;
+  addattr(&req.hdr, sizeof(req), IFLA_MASTER, &master, sizeof(master));
+  EXPECT_THAT(names(ASSERT_NO_ERRNO_AND_VALUE(
+                  DumpLinkAttrs(fd, &req, req.hdr.nlmsg_len))),
+              ::testing::IsEmpty());
+
+  ASSERT_NO_ERRNO(SetLinkMaster(fd, links["fltv1"].index, br));
+  EXPECT_THAT(names(ASSERT_NO_ERRNO_AND_VALUE(
+                  DumpLinkAttrs(fd, &req, req.hdr.nlmsg_len))),
+              ::testing::ElementsAre("fltv1"));
+  uint16_t done_flags = NLM_F_DUMP_FILTERED;
+  ASSERT_NO_ERRNO(NetlinkRequestResponse(
+      fd, &req, req.hdr.nlmsg_len,
+      [&](const struct nlmsghdr* hdr) {
+        if (hdr->nlmsg_type == NLMSG_DONE) {
+          done_flags = hdr->nlmsg_flags;
+        }
+      },
+      false));
+  EXPECT_EQ(done_flags & NLM_F_DUMP_FILTERED, 0);
+
+  for (const auto& [kind, want] :
+       std::vector<std::pair<std::string, std::vector<std::string>>>{
+           {"bridge", {"fltbr"}}, {"veth", {"fltv1", "fltv2"}}}) {
+    request();
+    struct rtattr* linkinfo = NLMSG_TAIL(&req.hdr);
+    addattr(&req.hdr, sizeof(req), IFLA_LINKINFO, nullptr, 0);
+    addattr(&req.hdr, sizeof(req), IFLA_INFO_KIND, kind.data(), kind.size());
+    linkinfo->rta_len = (uint64_t)NLMSG_TAIL(&req.hdr) - (uint64_t)linkinfo;
+    EXPECT_THAT(names(ASSERT_NO_ERRNO_AND_VALUE(
+                    DumpLinkAttrs(fd, &req, req.hdr.nlmsg_len))),
+                ::testing::ElementsAreArray(want))
+        << kind;
+  }
+}
+
+// With NETLINK_GET_STRICT_CHK, an address dump takes the interface
+// (ifa_index) the addresses must be of, as Linux's inet_dump_ifaddr() and
+// inet6_dump_addr() do, and marks its messages and NLMSG_DONE with
+// NLM_F_DUMP_FILTERED.
+TEST(NetlinkRouteTest, GetAddrDumpFilteredByIndexWithStrictCheck) {
+  SKIP_IF(!ASSERT_NO_ERRNO_AND_VALUE(HaveCapability(CAP_NET_ADMIN)));
+  SKIP_IF(!ASSERT_NO_ERRNO_AND_VALUE(HaveCapability(CAP_SYS_ADMIN)));
+  SKIP_IF(IsRunningWithHostinet());
+  Cleanup restore = ASSERT_NO_ERRNO_AND_VALUE(EnterNewNetns());
+
+  FileDescriptor fd =
+      ASSERT_NO_ERRNO_AND_VALUE(NetlinkBoundSocket(NETLINK_ROUTE));
+  const Link lo = ASSERT_NO_ERRNO_AND_VALUE(LoopbackLink());
+  ASSERT_NO_ERRNO(LinkChangeFlags(lo.index, IFF_UP, IFF_UP));
+  VethRequest veth = GetVethRequest(kSeq, "addrv1", "addrv2");
+  ASSERT_NO_ERRNO(
+      NetlinkRequestAckOrError(fd, kSeq, &veth, veth.hdr.nlmsg_len));
+  const int v1 = ASSERT_NO_ERRNO_AND_VALUE(DumpLinkAttrs(fd))["addrv1"].index;
+  struct in_addr addr;
+  ASSERT_EQ(inet_pton(AF_INET, "192.0.2.1", &addr), 1);
+  ASSERT_NO_ERRNO(LinkAddLocalAddr(fd, v1, AF_INET, 24, &addr, sizeof(addr)));
+
+  // The flags of the last dump's messages: whether each and any had
+  // NLM_F_DUMP_FILTERED, and those of NLMSG_DONE.
+  bool all_filtered = false;
+  bool any_filtered = false;
+  uint16_t done_flags = 0;
+  auto dump = [&](int index) -> PosixErrorOr<std::vector<int>> {
+    struct {
+      struct nlmsghdr hdr;
+      struct ifaddrmsg ifa;
+    } req = {};
+    all_filtered = true;
+    any_filtered = false;
+    done_flags = 0;
+    req.hdr.nlmsg_len = sizeof(req);
+    req.hdr.nlmsg_type = RTM_GETADDR;
+    req.hdr.nlmsg_flags = NLM_F_REQUEST | NLM_F_DUMP;
+    req.hdr.nlmsg_seq = kSeq;
+    req.ifa.ifa_family = AF_INET;
+    req.ifa.ifa_index = index;
+    std::vector<int> indexes;
+    int done_errno = 0;
+    RETURN_IF_ERRNO(NetlinkRequestResponse(
+        fd, &req, sizeof(req),
+        [&](const struct nlmsghdr* hdr) {
+          if (hdr->nlmsg_type == RTM_NEWADDR) {
+            indexes.push_back(
+                reinterpret_cast<const struct ifaddrmsg*>(NLMSG_DATA(hdr))
+                    ->ifa_index);
+            bool filtered = hdr->nlmsg_flags & NLM_F_DUMP_FILTERED;
+            all_filtered = all_filtered && filtered;
+            any_filtered = any_filtered || filtered;
+          }
+          if (hdr->nlmsg_type == NLMSG_DONE) {
+            done_errno = *reinterpret_cast<const int*>(NLMSG_DATA(hdr));
+            done_flags = hdr->nlmsg_flags;
+          }
+        },
+        false));
+    // A dump that fails ends with the error in NLMSG_DONE.
+    if (done_errno != 0) {
+      return PosixError(-done_errno);
+    }
+    return indexes;
+  };
+
+  // Without strict checking, ifa_index is ignored.
+  EXPECT_THAT(ASSERT_NO_ERRNO_AND_VALUE(dump(lo.index)),
+              ::testing::UnorderedElementsAre(lo.index, v1));
+  EXPECT_FALSE(any_filtered);
+  EXPECT_EQ(done_flags & NLM_F_DUMP_FILTERED, 0);
+
+  int on = 1;
+  ASSERT_THAT(setsockopt(fd.get(), SOL_NETLINK, NETLINK_GET_STRICT_CHK, &on,
+                         sizeof(on)),
+              SyscallSucceeds());
+  EXPECT_THAT(ASSERT_NO_ERRNO_AND_VALUE(dump(lo.index)),
+              ::testing::ElementsAre(lo.index));
+  EXPECT_TRUE(all_filtered);
+  EXPECT_NE(done_flags & NLM_F_DUMP_FILTERED, 0);
+  EXPECT_THAT(ASSERT_NO_ERRNO_AND_VALUE(dump(v1)), ::testing::ElementsAre(v1));
+  EXPECT_THAT(ASSERT_NO_ERRNO_AND_VALUE(dump(0)),
+              ::testing::UnorderedElementsAre(lo.index, v1));
+  EXPECT_FALSE(any_filtered);
+  EXPECT_EQ(done_flags & NLM_F_DUMP_FILTERED, 0);
+  EXPECT_THAT(dump(v1 + 100), PosixErrorIs(ENODEV, ::testing::_));
+}
+
+// With NETLINK_GET_STRICT_CHK, a route dump takes the output interface
+// (RTA_OIF) the routes must have, as Linux's ip_valid_fib_dump_req() does. As
+// Linux then dumps no route exceptions, every route has NLM_F_DUMP_FILTERED,
+// and NLMSG_DONE has it when the request has a filter.
+TEST(NetlinkRouteTest, GetRouteDumpFilteredByOifWithStrictCheck) {
+  SKIP_IF(!ASSERT_NO_ERRNO_AND_VALUE(HaveCapability(CAP_NET_ADMIN)));
+  SKIP_IF(!ASSERT_NO_ERRNO_AND_VALUE(HaveCapability(CAP_SYS_ADMIN)));
+  SKIP_IF(IsRunningWithHostinet());
+  Cleanup restore = ASSERT_NO_ERRNO_AND_VALUE(EnterNewNetns());
+
+  FileDescriptor fd =
+      ASSERT_NO_ERRNO_AND_VALUE(NetlinkBoundSocket(NETLINK_ROUTE));
+  const Link lo = ASSERT_NO_ERRNO_AND_VALUE(LoopbackLink());
+  ASSERT_NO_ERRNO(LinkChangeFlags(lo.index, IFF_UP, IFF_UP));
+  VethRequest veth = GetVethRequest(kSeq, "rtv1", "rtv2");
+  ASSERT_NO_ERRNO(
+      NetlinkRequestAckOrError(fd, kSeq, &veth, veth.hdr.nlmsg_len));
+  const int v1 = ASSERT_NO_ERRNO_AND_VALUE(DumpLinkAttrs(fd))["rtv1"].index;
+  ASSERT_NO_ERRNO(LinkChangeFlags(v1, IFF_UP, IFF_UP));
+  struct in_addr addr;
+  ASSERT_EQ(inet_pton(AF_INET, "192.0.2.1", &addr), 1);
+  ASSERT_NO_ERRNO(LinkAddLocalAddr(fd, v1, AF_INET, 24, &addr, sizeof(addr)));
+
+  bool all_filtered = false;
+  uint16_t done_flags = 0;
+  auto dump = [&](int oif) -> PosixErrorOr<std::vector<int>> {
+    struct {
+      struct nlmsghdr hdr;
+      struct rtmsg rtm;
+      char buf[16];
+    } req = {};
+    all_filtered = true;
+    done_flags = 0;
+    req.hdr.nlmsg_len = NLMSG_LENGTH(sizeof(struct rtmsg));
+    req.hdr.nlmsg_type = RTM_GETROUTE;
+    req.hdr.nlmsg_flags = NLM_F_REQUEST | NLM_F_DUMP;
+    req.hdr.nlmsg_seq = kSeq;
+    req.rtm.rtm_family = AF_INET;
+    if (oif != 0) {
+      uint32_t o = oif;
+      addattr(&req.hdr, sizeof(req), RTA_OIF, &o, sizeof(o));
+    }
+    std::vector<int> oifs;
+    int done_errno = 0;
+    RETURN_IF_ERRNO(NetlinkRequestResponse(
+        fd, &req, req.hdr.nlmsg_len,
+        [&](const struct nlmsghdr* hdr) {
+          if (hdr->nlmsg_type == NLMSG_DONE) {
+            done_errno = *reinterpret_cast<const int*>(NLMSG_DATA(hdr));
+            done_flags = hdr->nlmsg_flags;
+          }
+          if (hdr->nlmsg_type != RTM_NEWROUTE) {
+            return;
+          }
+          all_filtered =
+              all_filtered && (hdr->nlmsg_flags & NLM_F_DUMP_FILTERED);
+          const struct rtmsg* rtm =
+              reinterpret_cast<const struct rtmsg*>(NLMSG_DATA(hdr));
+          int len = RTM_PAYLOAD(hdr);
+          int route_oif = 0;
+          for (const struct rtattr* rta = RTM_RTA(rtm); RTA_OK(rta, len);
+               rta = RTA_NEXT(rta, len)) {
+            if (rta->rta_type == RTA_OIF) {
+              route_oif = *reinterpret_cast<const uint32_t*>(RTA_DATA(rta));
+            }
+          }
+          oifs.push_back(route_oif);
+        },
+        false));
+    // A dump that fails ends with the error in NLMSG_DONE.
+    if (done_errno != 0) {
+      return PosixError(-done_errno);
+    }
+    return oifs;
+  };
+
+  int on = 1;
+  ASSERT_THAT(setsockopt(fd.get(), SOL_NETLINK, NETLINK_GET_STRICT_CHK, &on,
+                         sizeof(on)),
+              SyscallSucceeds());
+  EXPECT_THAT(ASSERT_NO_ERRNO_AND_VALUE(dump(0)), ::testing::Contains(v1));
+  EXPECT_THAT(ASSERT_NO_ERRNO_AND_VALUE(dump(0)), ::testing::Contains(lo.index));
+  EXPECT_TRUE(all_filtered);
+  EXPECT_EQ(done_flags & NLM_F_DUMP_FILTERED, 0);
+  auto oifs = ASSERT_NO_ERRNO_AND_VALUE(dump(v1));
+  EXPECT_THAT(oifs, ::testing::Not(::testing::IsEmpty()));
+  EXPECT_THAT(oifs, ::testing::Each(v1));
+  EXPECT_TRUE(all_filtered);
+  EXPECT_NE(done_flags & NLM_F_DUMP_FILTERED, 0);
+  EXPECT_THAT(dump(v1 + 100), PosixErrorIs(ENODEV, ::testing::_));
+}
