+// linkDumpFilter returns the filters of an RTM_GETLINK dump request, as Linux's
+// rtnl_dump_ifinfo reads them: the index of the master that the dumped links
+// must have (IFLA_MASTER; -1 for none, 0 for any) and the kind they must be
+// (IFLA_INFO_KIND in IFLA_LINKINFO), which filters only for a kind of link that
+// can be created. A request shorter than an ifinfomsg, the rtgenmsg of
+// iproute2 before 3.9 and of glibc, has no filters.
+func linkDumpFilter(msg *nlmsg.Message) (master int32, kind string, filtered bool) {
+	var ifi linux.InterfaceInfoMessage
+	attrs, ok := msg.GetData(&ifi)
+	if !ok {
+		return 0, "", false
+	}
+	for !attrs.Empty() {
+		hdr, value, rest, ok := attrs.ParseFirst()
+		if !ok {
+			break
+		}
+		attrs = rest
+		switch hdr.Type &^ linux.NLA_F_NESTED {
+		case linux.IFLA_MASTER:
+			v := nlmsg.BytesView(value)
+			if m, ok := v.Uint32(); ok {
+				master = int32(m)
+			}
+		case linux.IFLA_LINKINFO:
+			info := nlmsg.AttrsView(value)
+			for !info.Empty() {
+				ihdr, ivalue, irest, ok := info.ParseFirst()
+				if !ok {
+					break
+				}
+				info = irest
+				if ihdr.Type == linux.IFLA_INFO_KIND {
+					v := nlmsg.BytesView(ivalue)
+					switch k := v.String(); k {
+					case "bridge", "veth":
+						kind = k
+					}
+				}
+			}
+		}
+	}
+	return master, kind, master != 0 || kind != ""
+}
+
+// linkDumpFiltered returns whether a link dump with the given filters leaves
+// out interface i, as Linux's link_dump_filtered does.
+func linkDumpFiltered(i inet.Interface, master int32, kind string) bool {
+	switch {
+	case master == -1 && i.Master != 0:
+		return true
+	case master > 0 && i.Master != uint32(master):
+		return true
+	}
+	return kind != "" && i.Kind != kind
+}
