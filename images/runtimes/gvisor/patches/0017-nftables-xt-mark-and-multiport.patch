+// TestCompatMarkMatchEvaluation tests the mark match, as
+// net/netfilter/xt_mark.c:mark_mt() compares a packet's mark.
+func TestCompatMarkMatchEvaluation(t *testing.T) {
+	info := func(mark, mask uint32, invert bool) []byte {
+		b := make([]byte, sizeOfXTMarkMtInfo1)
+		binary.NativeEndian.PutUint32(b[0:], mark)
+		binary.NativeEndian.PutUint32(b[4:], mask)
+		if invert {
+			b[8] = 1
+		}
+		return b
+	}
+	for _, tc := range []struct {
+		name string
+		info []byte
+		mark uint32
+		want uint32
+	}{
+		{name: "masked bit set", info: info(0x2000, 0x2000, false), mark: 0x2001, want: VC(linux.NFT_CONTINUE)},
+		{name: "masked bit clear", info: info(0x2000, 0x2000, false), mark: 0x1, want: VC(linux.NFT_BREAK)},
+		{name: "inverted, masked bit set", info: info(0x2000, 0x2000, true), mark: 0x2001, want: VC(linux.NFT_BREAK)},
+		{name: "inverted, masked bit clear", info: info(0x2000, 0x2000, true), mark: 0x1, want: VC(linux.NFT_CONTINUE)},
+		{name: "whole mark", info: info(0x5, 0xffffffff, false), mark: 0x5, want: VC(linux.NFT_CONTINUE)},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			op, err := parseMarkMatch(markMatchRevision, tc.info)
+			if err != nil {
+				t.Fatalf("parseMarkMatch: %v", err)
+			}
+			pkt := makeUDPv4Packet(tcpip.AddrFrom4([4]byte{10, 0, 0, 1}), tcpip.AddrFrom4([4]byte{10, 0, 0, 2}), 1000, 53)
+			defer pkt.DecRef()
+			pkt.Mark = tc.mark
+			regs := newRegisterSet()
+			op.evaluate(&regs, opEvalCtx{pkt: pkt})
+			if got := regs.verdict.Code; got != tc.want {
+				t.Errorf("verdict = %v, want %v", got, tc.want)
+			}
+		})
+	}
+}
