+// This file implements the "multiport" XTables compatibility match.
+// Ref: net/netfilter/xt_multiport.c
+
+package nftables
+
+import (
+	"encoding/binary"
+	"fmt"
+
+	"gvisor.dev/gvisor/pkg/abi/linux"
+	"gvisor.dev/gvisor/pkg/marshal/primitive"
+	"gvisor.dev/gvisor/pkg/sentry/socket/netlink/nlmsg"
+	"gvisor.dev/gvisor/pkg/syserr"
+	"gvisor.dev/gvisor/pkg/tcpip"
+	"gvisor.dev/gvisor/pkg/tcpip/header"
+	"gvisor.dev/gvisor/pkg/tcpip/stack"
+)
+
+const (
+	// multiportRevision is the only revision of the multiport match that
+	// Linux registers (multiport_mt_reg), for IPv4 and IPv6.
+	multiportRevision = 1
+
+	// xtMultiPorts is XT_MULTI_PORTS, the most ports a match holds.
+	xtMultiPorts = 15
+
+	// sizeOfXTMultiportV1 is the size of struct xt_multiport_v1: __u8 flags,
+	// count; __u16 ports[15]; __u8 pflags[15], invert.
+	sizeOfXTMultiportV1 = 48
+
+	// The flags of struct xt_multiport_v1.
+	xtMultiportSource      = 0
+	xtMultiportDestination = 1
+	xtMultiportEither      = 2
+)
+
+// lookupMultiportRevision validates a revision of the multiport match and
+// returns the best revision.
+func lookupMultiportRevision(rev uint32, family stack.AddressFamily) (uint32, *syserr.AnnotatedError) {
+	if family != stack.IP && family != stack.IP6 {
+		return 0, syserr.NewAnnotatedError(syserr.ErrNoSuchFile, fmt.Sprintf("multiport match not supported for family %v", family))
+	}
+	return lookupMarkRevision(MatchMultiport, rev, multiportRevision)
+}
+
+// compatMultiportMatch implements the xtables multiport match.
+type compatMultiportMatch struct {
+	// infoData is the raw netlink attribute payload; saved for dump.
+	infoData []byte
+	// flags, ports, pflags and invert are the match's xt_multiport_v1, with
+	// ports cut to its count.
+	flags  uint8
+	ports  []uint16
+	pflags []uint8
+	invert bool
+}
+
+// parseMultiportMatch decodes a multiport match's info.
+// Ref: net/netfilter/xt_multiport.c:multiport_mt_check(),
+// net/netfilter/nft_compat.c:nft_match_init()
+func parseMultiportMatch(tab *Table, rev uint32, infoData []byte) (*compatMultiportMatch, *syserr.AnnotatedError) {
+	if family := tab.GetAddressFamily(); family != stack.IP && family != stack.IP6 {
+		return nil, syserr.NewAnnotatedError(syserr.ErrNoSuchFile, fmt.Sprintf("multiport match not supported for address family: %v", family))
+	}
+	if rev != multiportRevision {
+		return nil, syserr.NewAnnotatedError(syserr.ErrNoSuchFile, fmt.Sprintf("multiport revision %d not supported", rev))
+	}
+	if !xtInfoFits(len(infoData), sizeOfXTMultiportV1) {
+		return nil, syserr.NewAnnotatedError(syserr.ErrInvalidArgument, fmt.Sprintf("multiport info size %d, want %d", len(infoData), sizeOfXTMultiportV1))
+	}
+	flags, count := infoData[0], int(infoData[1])
+	if flags != xtMultiportSource && flags != xtMultiportDestination && flags != xtMultiportEither {
+		return nil, syserr.NewAnnotatedError(syserr.ErrInvalidArgument, fmt.Sprintf("multiport flags %d unknown", flags))
+	}
+	if count > xtMultiPorts {
+		return nil, syserr.NewAnnotatedError(syserr.ErrInvalidArgument, fmt.Sprintf("multiport count %d above %d", count, xtMultiPorts))
+	}
+	op := &compatMultiportMatch{
+		infoData: infoData,
+		flags:    flags,
+		ports:    make([]uint16, count),
+		pflags:   make([]uint8, count),
+		invert:   infoData[2+2*xtMultiPorts+xtMultiPorts] != 0,
+	}
+	for i := range count {
+		op.ports[i] = binary.NativeEndian.Uint16(infoData[2+2*i:])
+		op.pflags[i] = infoData[2+2*xtMultiPorts+i]
+	}
+	if !op.validRanges() {
+		return nil, syserr.NewAnnotatedError(syserr.ErrInvalidArgument, "multiport range invalid")
+	}
+	return op, nil
+}
+
+// validRanges reports whether each port flagged as the start of a range is
+// followed by its end: a port not so flagged and not below it.
+// Ref: net/netfilter/xt_multiport.c:multiport_valid_ranges()
+func (op *compatMultiportMatch) validRanges() bool {
+	for i := 0; i < len(op.ports); i++ {
+		if op.pflags[i] == 0 {
+			continue
+		}
+		i++
+		if i >= len(op.ports) || op.pflags[i] != 0 || op.ports[i-1] > op.ports[i] {
+			return false
+		}
+	}
+	return true
+}
+
+// matchPorts reports whether the ports of a packet match.
+// Ref: net/netfilter/xt_multiport.c:ports_match_v1()
+func (op *compatMultiportMatch) matchPorts(src, dst uint16) bool {
+	for i := 0; i < len(op.ports); i++ {
+		start, end := op.ports[i], op.ports[i]
+		if op.pflags[i] != 0 {
+			// A range: this port and the next, as validRanges ensures.
+			i++
+			end = op.ports[i]
+		}
+		switch op.flags {
+		case xtMultiportSource:
+			if src >= start && src <= end {
+				return !op.invert
+			}
+		case xtMultiportDestination:
+			if dst >= start && dst <= end {
+				return !op.invert
+			}
+		case xtMultiportEither:
+			if (src >= start && src <= end) || (dst >= start && dst <= end) {
+				return !op.invert
+			}
+		}
+	}
+	return op.invert
+}
+
+// evaluate implements operation.evaluate.
+// Ref: net/netfilter/xt_multiport.c:multiport_mt(),
+// net/netfilter/nft_compat.c:nft_match_eval()
+func (op *compatMultiportMatch) evaluate(regs *registerSet, evalCtx opEvalCtx) {
+	pkt := evalCtx.pkt
+	// Linux requires the rule to match TCP, UDP, UDP-Lite, SCTP or DCCP
+	// first; of these, netstack has TCP and UDP. A packet of another protocol
+	// never matches here, nor a fragment other than the first.
+	switch pkt.NetworkProtocolNumber {
+	case header.IPv4ProtocolNumber:
+		net := header.IPv4(pkt.NetworkHeader().Slice())
+		if len(net) < header.IPv4MinimumSize || !isTCPOrUDP(net.TransportProtocol()) || net.FragmentOffset() != 0 {
+			regs.verdict = Verdict{Code: VC(linux.NFT_BREAK)}
+			return
+		}
+	case header.IPv6ProtocolNumber:
+		if !isTCPOrUDP(pkt.TransportProtocolNumber) {
+			regs.verdict = Verdict{Code: VC(linux.NFT_BREAK)}
+			return
+		}
+	default:
+		regs.verdict = Verdict{Code: VC(linux.NFT_BREAK)}
+		return
+	}
+	transport, ok := transportHeader(pkt, 4)
+	if !ok {
+		// Linux's hotdrop for a header too short to hold the ports.
+		regs.verdict = Verdict{Code: VC(linux.NF_DROP)}
+		return
+	}
+	if op.matchPorts(binary.BigEndian.Uint16(transport[0:2]), binary.BigEndian.Uint16(transport[2:4])) {
+		regs.verdict = Verdict{Code: VC(linux.NFT_CONTINUE)}
+		return
+	}
+	regs.verdict = Verdict{Code: VC(linux.NFT_BREAK)}
+}
+
+func isTCPOrUDP(protocol tcpip.TransportProtocolNumber) bool {
+	return protocol == header.TCPProtocolNumber || protocol == header.UDPProtocolNumber
+}
+
+// checkCompatibility implements operation.checkCompatibility.
+func (op *compatMultiportMatch) checkCompatibility(*opCompatCtx) *syserr.AnnotatedError {
+	return nil
+}
+
+// deepCopy implements operation.deepCopy.
+func (op *compatMultiportMatch) deepCopy() operation {
+	opCopy := *op
+	opCopy.infoData = append([]byte(nil), op.infoData...)
+	opCopy.ports = append([]uint16(nil), op.ports...)
+	opCopy.pflags = append([]uint8(nil), op.pflags...)
+	return &opCopy
+}
+
+// updateReferences implements operation.updateReferences.
+func (op *compatMultiportMatch) updateReferences(*Table, *Table, operation) {}
+
+// destroy implements operation.destroy.
+func (op *compatMultiportMatch) destroy() {}
+
+// GetExprName implements operation.GetExprName.
+func (op *compatMultiportMatch) GetExprName() string {
+	return OpTypeMatch.String()
+}
+
+// Dump implements operation.Dump.
+// Ref: net/netfilter/nft_compat.c:__nft_match_dump()
+func (op *compatMultiportMatch) Dump() ([]byte, *syserr.AnnotatedError) {
+	m := &nlmsg.Message{}
+	m.PutAttrString(linux.NFTA_MATCH_NAME, MatchMultiport)
+	m.PutAttr(linux.NFTA_MATCH_REV, nlmsg.PutU32(multiportRevision))
+	m.PutAttr(linux.NFTA_MATCH_INFO, primitive.AsByteSlice(op.infoData))
+	return m.Buffer(), nil
+}
+
+var _ operation = (*compatMultiportMatch)(nil)
