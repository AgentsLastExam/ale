+// TestCompatMarkTargetEvaluation tests the MARK target, as
+// net/netfilter/xt_mark.c:mark_tg() sets a packet's mark.
+func TestCompatMarkTargetEvaluation(t *testing.T) {
+	info := func(mark, mask uint32) []byte {
+		b := make([]byte, sizeOfXTMarkTgInfo2)
+		binary.NativeEndian.PutUint32(b[0:], mark)
+		binary.NativeEndian.PutUint32(b[4:], mask)
+		return b
+	}
+	for _, tc := range []struct {
+		name       string
+		mark, mask uint32
+		before     uint32
+		want       uint32
+	}{
+		// iptables -j MARK --set-xmark 0x2000/0x2000, as the CNI portmap
+		// plugin and netavark write.
+		{name: "set-xmark sets the bit", mark: 0x2000, mask: 0x2000, before: 0x1, want: 0x2001},
+		{name: "set-xmark keeps the bit", mark: 0x2000, mask: 0x2000, before: 0x2001, want: 0x2001},
+		// --set-mark 0x5 is --set-xmark 0x5/0xffffffff.
+		{name: "set-mark", mark: 0x5, mask: 0xffffffff, before: 0x2001, want: 0x5},
+		// --or-mark 0x10 is --set-xmark 0x10/0x10.
+		{name: "or-mark", mark: 0x10, mask: 0x10, before: 0x3, want: 0x13},
+		// --and-mark 0x1 is --set-xmark 0x0/0xfffffffe.
+		{name: "and-mark", mark: 0, mask: 0xfffffffe, before: 0x3, want: 0x1},
+		// --xor-mark 0x3 is --set-xmark 0x3/0x0.
+		{name: "xor-mark", mark: 0x3, mask: 0, before: 0x1, want: 0x2},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			op, err := parseMarkTarget(markTargetRevision, info(tc.mark, tc.mask))
+			if err != nil {
+				t.Fatalf("parseMarkTarget: %v", err)
+			}
+			pkt := makeUDPv4Packet(tcpip.AddrFrom4([4]byte{10, 0, 0, 1}), tcpip.AddrFrom4([4]byte{10, 0, 0, 2}), 1000, 53)
+			defer pkt.DecRef()
+			pkt.Mark = tc.before
+			regs := newRegisterSet()
+			op.evaluate(&regs, opEvalCtx{pkt: pkt})
+			if got := regs.verdict.Code; got != VC(linux.NFT_CONTINUE) {
+				t.Errorf("verdict = %v, want NFT_CONTINUE", got)
+			}
+			if pkt.Mark != tc.want {
+				t.Errorf("mark = %#x, want %#x", pkt.Mark, tc.want)
+			}
+		})
+	}
+}
