+// This file implements the "MARK" XTables compatibility target and the "mark"
+// XTables compatibility match.
+// Ref: net/netfilter/xt_mark.c
+
+package nftables
+
+import (
+	"encoding/binary"
+	"fmt"
+
+	"gvisor.dev/gvisor/pkg/abi/linux"
+	"gvisor.dev/gvisor/pkg/marshal/primitive"
+	"gvisor.dev/gvisor/pkg/sentry/socket/netlink/nlmsg"
+	"gvisor.dev/gvisor/pkg/syserr"
+)
+
+const (
+	// markTargetRevision is the only revision of the MARK target that Linux
+	// registers (mark_tg_reg).
+	markTargetRevision = 2
+	// markMatchRevision is the only revision of the mark match that Linux
+	// registers (mark_mt_reg).
+	markMatchRevision = 1
+
+	// sizeOfXTMarkTgInfo2 is the size of struct xt_mark_tginfo2: __u32 mark,
+	// mask.
+	sizeOfXTMarkTgInfo2 = 8
+	// sizeOfXTMarkMtInfo1 is the size of struct xt_mark_mtinfo1: __u32 mark,
+	// mask; __u8 invert, padded to the struct's alignment.
+	sizeOfXTMarkMtInfo1 = 12
+)
+
+// lookupMarkRevision validates a revision of the MARK target or the mark match,
+// which Linux registers for NFPROTO_UNSPEC, so for every family, and returns
+// the best revision. As Linux's xt_find_revision, a revision it does not have
+// is EPROTONOSUPPORT.
+func lookupMarkRevision(name string, rev, have uint32) (uint32, *syserr.AnnotatedError) {
+	if rev != have {
+		return 0, syserr.NewAnnotatedError(syserr.ErrProtocolNotSupported, fmt.Sprintf("%s revision %d not supported", name, rev))
+	}
+	return have, nil
+}
+
+// compatMarkTarget implements the xtables MARK target.
+type compatMarkTarget struct {
+	// infoData is the raw netlink attribute payload; saved for dump.
+	infoData []byte
+	// mark and mask are the target's xt_mark_tginfo2.
+	mark, mask uint32
+}
+
+// parseMarkTarget decodes a MARK target's info.
+// Ref: net/netfilter/nft_compat.c:nft_target_init(),
+// net/netfilter/x_tables.c:xt_check_target()
+func parseMarkTarget(rev uint32, infoData []byte) (*compatMarkTarget, *syserr.AnnotatedError) {
+	if rev != markTargetRevision {
+		return nil, syserr.NewAnnotatedError(syserr.ErrNoSuchFile, fmt.Sprintf("MARK revision %d not supported", rev))
+	}
+	if !xtInfoFits(len(infoData), sizeOfXTMarkTgInfo2) {
+		return nil, syserr.NewAnnotatedError(syserr.ErrInvalidArgument, fmt.Sprintf("MARK info size %d, want %d", len(infoData), sizeOfXTMarkTgInfo2))
+	}
+	return &compatMarkTarget{
+		infoData: infoData,
+		mark:     binary.NativeEndian.Uint32(infoData[0:4]),
+		mask:     binary.NativeEndian.Uint32(infoData[4:8]),
+	}, nil
+}
+
+// evaluate implements operation.evaluate.
+// Ref: net/netfilter/xt_mark.c:mark_tg()
+func (op *compatMarkTarget) evaluate(regs *registerSet, evalCtx opEvalCtx) {
+	pkt := evalCtx.pkt
+	pkt.Mark = (pkt.Mark &^ op.mask) ^ op.mark
+	// XT_CONTINUE (net/netfilter/nft_compat.c:nft_target_eval_xt()).
+	regs.verdict = Verdict{Code: VC(linux.NFT_CONTINUE)}
+}
+
+// checkCompatibility implements operation.checkCompatibility. MARK is valid in
+// every table and hook.
+func (op *compatMarkTarget) checkCompatibility(*opCompatCtx) *syserr.AnnotatedError {
+	return nil
+}
+
+// deepCopy implements operation.deepCopy.
+func (op *compatMarkTarget) deepCopy() operation {
+	opCopy := *op
+	opCopy.infoData = append([]byte(nil), op.infoData...)
+	return &opCopy
+}
+
+// updateReferences implements operation.updateReferences.
+func (op *compatMarkTarget) updateReferences(*Table, *Table, operation) {}
+
+// destroy implements operation.destroy.
+func (op *compatMarkTarget) destroy() {}
+
+// GetExprName implements operation.GetExprName.
+func (op *compatMarkTarget) GetExprName() string {
+	return OpTypeTarget.String()
+}
+
+// Dump implements operation.Dump.
+// Ref: net/netfilter/nft_compat.c:nft_target_dump()
+func (op *compatMarkTarget) Dump() ([]byte, *syserr.AnnotatedError) {
+	m := &nlmsg.Message{}
+	m.PutAttrString(linux.NFTA_TARGET_NAME, TargetMARK)
+	m.PutAttr(linux.NFTA_TARGET_REV, nlmsg.PutU32(markTargetRevision))
+	m.PutAttr(linux.NFTA_TARGET_INFO, primitive.AsByteSlice(op.infoData))
+	return m.Buffer(), nil
+}
+
+// compatMarkMatch implements the xtables mark match.
+type compatMarkMatch struct {
+	// infoData is the raw netlink attribute payload; saved for dump.
+	infoData []byte
+	// mark, mask and invert are the match's xt_mark_mtinfo1.
+	mark, mask uint32
+	invert     bool
+}
+
+// parseMarkMatch decodes a mark match's info.
+// Ref: net/netfilter/nft_compat.c:nft_match_init(),
+// net/netfilter/x_tables.c:xt_check_match()
+func parseMarkMatch(rev uint32, infoData []byte) (*compatMarkMatch, *syserr.AnnotatedError) {
+	if rev != markMatchRevision {
+		return nil, syserr.NewAnnotatedError(syserr.ErrNoSuchFile, fmt.Sprintf("mark revision %d not supported", rev))
+	}
+	if !xtInfoFits(len(infoData), sizeOfXTMarkMtInfo1) {
+		return nil, syserr.NewAnnotatedError(syserr.ErrInvalidArgument, fmt.Sprintf("mark info size %d, want %d", len(infoData), sizeOfXTMarkMtInfo1))
+	}
+	return &compatMarkMatch{
+		infoData: infoData,
+		mark:     binary.NativeEndian.Uint32(infoData[0:4]),
+		mask:     binary.NativeEndian.Uint32(infoData[4:8]),
+		invert:   infoData[8] != 0,
+	}, nil
+}
+
+// evaluate implements operation.evaluate.
+// Ref: net/netfilter/xt_mark.c:mark_mt(), net/netfilter/nft_compat.c:nft_match_eval()
+func (op *compatMarkMatch) evaluate(regs *registerSet, evalCtx opEvalCtx) {
+	if (evalCtx.pkt.Mark&op.mask == op.mark) != op.invert {
+		regs.verdict = Verdict{Code: VC(linux.NFT_CONTINUE)}
+		return
+	}
+	regs.verdict = Verdict{Code: VC(linux.NFT_BREAK)}
+}
+
+// checkCompatibility implements operation.checkCompatibility. mark is valid in
+// every table and hook.
+func (op *compatMarkMatch) checkCompatibility(*opCompatCtx) *syserr.AnnotatedError {
+	return nil
+}
+
+// deepCopy implements operation.deepCopy.
+func (op *compatMarkMatch) deepCopy() operation {
+	opCopy := *op
+	opCopy.infoData = append([]byte(nil), op.infoData...)
+	return &opCopy
+}
+
+// updateReferences implements operation.updateReferences.
+func (op *compatMarkMatch) updateReferences(*Table, *Table, operation) {}
+
+// destroy implements operation.destroy.
+func (op *compatMarkMatch) destroy() {}
+
+// GetExprName implements operation.GetExprName.
+func (op *compatMarkMatch) GetExprName() string {
+	return OpTypeMatch.String()
+}
+
+// Dump implements operation.Dump.
+// Ref: net/netfilter/nft_compat.c:__nft_match_dump()
+func (op *compatMarkMatch) Dump() ([]byte, *syserr.AnnotatedError) {
+	m := &nlmsg.Message{}
+	m.PutAttrString(linux.NFTA_MATCH_NAME, MatchMark)
+	m.PutAttr(linux.NFTA_MATCH_REV, nlmsg.PutU32(markMatchRevision))
+	m.PutAttr(linux.NFTA_MATCH_INFO, primitive.AsByteSlice(op.infoData))
+	return m.Buffer(), nil
+}
+
+var (
+	_ operation = (*compatMarkTarget)(nil)
+	_ operation = (*compatMarkMatch)(nil)
+)
