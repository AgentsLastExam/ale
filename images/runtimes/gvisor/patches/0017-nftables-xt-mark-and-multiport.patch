+// TestCompatMultiportMatch tests the multiport match, as
+// net/netfilter/xt_multiport.c checks and evaluates it.
+func TestCompatMultiportMatch(t *testing.T) {
+	src := tcpip.AddrFrom4([4]byte{10, 0, 0, 1})
+	dst := tcpip.AddrFrom4([4]byte{10, 0, 0, 2})
+	// info builds an xt_multiport_v1; a port given as [2]uint16 is a range.
+	info := func(flags uint8, invert bool, ports ...any) []byte {
+		b := make([]byte, sizeOfXTMultiportV1)
+		b[0] = flags
+		n := 0
+		for _, p := range ports {
+			switch p := p.(type) {
+			case int:
+				binary.NativeEndian.PutUint16(b[2+2*n:], uint16(p))
+				n++
+			case [2]uint16:
+				binary.NativeEndian.PutUint16(b[2+2*n:], p[0])
+				b[2+2*xtMultiPorts+n] = 1
+				n++
+				binary.NativeEndian.PutUint16(b[2+2*n:], p[1])
+				n++
+			}
+		}
+		b[1] = uint8(n)
+		if invert {
+			b[2+3*xtMultiPorts] = 1
+		}
+		return b
+	}
+	tcpPacket := func(srcPort, dstPort uint16) func() *stack.PacketBuffer {
+		return func() *stack.PacketBuffer {
+			return makeIPv4TCPPacket(header.IPv4MinimumSize+header.TCPMinimumSize, &header.IPv4Fields{
+				TotalLength: header.IPv4MinimumSize + header.TCPMinimumSize,
+				TTL:         64,
+				Protocol:    uint8(header.TCPProtocolNumber),
+				SrcAddr:     src,
+				DstAddr:     dst,
+			}, &header.TCPFields{SrcPort: srcPort, DstPort: dstPort, DataOffset: header.TCPMinimumSize, Flags: header.TCPFlagSyn})
+		}
+	}
+	udpPacket := func(srcPort, dstPort uint16) func() *stack.PacketBuffer {
+		return func() *stack.PacketBuffer { return makeUDPv4Packet(src, dst, srcPort, dstPort) }
+	}
+	for _, tc := range []struct {
+		name string
+		info []byte
+		pkt  func() *stack.PacketBuffer
+		want uint32
+	}{
+		// iptables -p tcp -m multiport --destination-ports 18080, as the CNI
+		// portmap plugin writes.
+		{name: "destination port", info: info(xtMultiportDestination, false, 18080), pkt: tcpPacket(40000, 18080), want: VC(linux.NFT_CONTINUE)},
+		{name: "destination port mismatch", info: info(xtMultiportDestination, false, 18080), pkt: tcpPacket(18080, 80), want: VC(linux.NFT_BREAK)},
+		{name: "one of several", info: info(xtMultiportDestination, false, 80, 443, 8080), pkt: tcpPacket(40000, 443), want: VC(linux.NFT_CONTINUE)},
+		{name: "source port", info: info(xtMultiportSource, false, 53), pkt: udpPacket(53, 40000), want: VC(linux.NFT_CONTINUE)},
+		{name: "source port mismatch", info: info(xtMultiportSource, false, 53), pkt: udpPacket(40000, 53), want: VC(linux.NFT_BREAK)},
+		{name: "either port", info: info(xtMultiportEither, false, 53), pkt: udpPacket(40000, 53), want: VC(linux.NFT_CONTINUE)},
+		{name: "range", info: info(xtMultiportDestination, false, [2]uint16{1000, 2000}), pkt: tcpPacket(40000, 1500), want: VC(linux.NFT_CONTINUE)},
+		{name: "range end", info: info(xtMultiportDestination, false, [2]uint16{1000, 2000}), pkt: tcpPacket(40000, 2000), want: VC(linux.NFT_CONTINUE)},
+		{name: "outside range", info: info(xtMultiportDestination, false, [2]uint16{1000, 2000}), pkt: tcpPacket(40000, 2001), want: VC(linux.NFT_BREAK)},
+		{name: "port after a range", info: info(xtMultiportDestination, false, [2]uint16{1000, 2000}, 22), pkt: tcpPacket(40000, 22), want: VC(linux.NFT_CONTINUE)},
+		{name: "inverted", info: info(xtMultiportDestination, true, 80), pkt: tcpPacket(40000, 80), want: VC(linux.NFT_BREAK)},
+		{name: "inverted mismatch", info: info(xtMultiportDestination, true, 80), pkt: tcpPacket(40000, 81), want: VC(linux.NFT_CONTINUE)},
+		// Linux reads the ports of a first fragment where its transport
+		// header begins, and never matches a later one.
+		{name: "first fragment", info: info(xtMultiportDestination, false, 80), pkt: func() *stack.PacketBuffer { return makeUDPv4Fragment(src, dst, 40000, 80, 0) }, want: VC(linux.NFT_CONTINUE)},
+		{name: "first fragment mismatch", info: info(xtMultiportDestination, false, 99), pkt: func() *stack.PacketBuffer { return makeUDPv4Fragment(src, dst, 40000, 80, 0) }, want: VC(linux.NFT_BREAK)},
+		{name: "later fragment", info: info(xtMultiportDestination, false, 80), pkt: func() *stack.PacketBuffer { return makeUDPv4Fragment(src, dst, 40000, 80, 8) }, want: VC(linux.NFT_BREAK)},
+		{name: "another protocol", info: info(xtMultiportDestination, true, 80), pkt: func() *stack.PacketBuffer {
+			return makeIPv4Packet(header.IPv4MinimumSize, &header.IPv4Fields{TotalLength: header.IPv4MinimumSize, TTL: 64, Protocol: uint8(header.ICMPv4ProtocolNumber), SrcAddr: src, DstAddr: dst})
+		}, want: VC(linux.NFT_BREAK)},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			tab := &Table{afFilter: &addressFamilyFilter{family: stack.IP}}
+			op, err := parseMultiportMatch(tab, multiportRevision, tc.info)
+			if err != nil {
+				t.Fatalf("parseMultiportMatch: %v", err)
+			}
+			pkt := tc.pkt()
+			defer pkt.DecRef()
+			regs := newRegisterSet()
+			op.evaluate(&regs, opEvalCtx{pkt: pkt})
+			if got := regs.verdict.Code; got != tc.want {
+				t.Errorf("verdict = %v, want %v", got, tc.want)
+			}
+		})
+	}
+
+	ipTable := &Table{afFilter: &addressFamilyFilter{family: stack.IP}}
+	bad := info(xtMultiportDestination, false, 80)
+	for _, tc := range []struct {
+		name string
+		tab  *Table
+		info []byte
+	}{
+		{name: "unknown flags", tab: ipTable, info: func() []byte { b := slices.Clone(bad); b[0] = 3; return b }()},
+		{name: "too many ports", tab: ipTable, info: func() []byte { b := slices.Clone(bad); b[1] = xtMultiPorts + 1; return b }()},
+		{name: "short info", tab: ipTable, info: bad[:sizeOfXTMultiportV1-1]},
+		{name: "long info", tab: ipTable, info: append(slices.Clone(bad), make([]byte, 8)...)},
+		// Ranges that Linux's multiport_valid_ranges() refuses.
+		{name: "unterminated range", tab: ipTable, info: func() []byte { b := slices.Clone(bad); b[2+2*xtMultiPorts] = 1; return b }()},
+		{name: "reversed range", tab: ipTable, info: info(xtMultiportDestination, false, [2]uint16{2000, 1000})},
+		{name: "range end flagged", tab: ipTable, info: func() []byte {
+			b := info(xtMultiportDestination, false, [2]uint16{1000, 2000}, 22)
+			b[2+2*xtMultiPorts+1] = 1
+			return b
+		}()},
+	} {
+		if _, err := parseMultiportMatch(tc.tab, multiportRevision, tc.info); err == nil || err.GetError() != syserr.ErrInvalidArgument {
+			t.Errorf("parseMultiportMatch with %s = %v, want EINVAL", tc.name, err)
+		}
+	}
+	if _, err := parseMultiportMatch(&Table{afFilter: &addressFamilyFilter{family: stack.Arp}}, multiportRevision, bad); err == nil {
+		t.Errorf("parseMultiportMatch in an arp table succeeded, want an error")
+	}
+	if _, err := lookupMultiportRevision(0, stack.IP); err == nil || err.GetError() != syserr.ErrProtocolNotSupported {
+		t.Errorf("lookupMultiportRevision(0) = %v, want EPROTONOSUPPORT", err)
+	}
+}
