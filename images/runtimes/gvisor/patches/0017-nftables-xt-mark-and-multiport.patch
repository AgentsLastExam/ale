+func TestCompatMarkParse(t *testing.T) {
+	if rev, err := lookupCompatTargetRevision(TargetMARK, markTargetRevision, stack.IP); err != nil || rev != markTargetRevision {
+		t.Errorf("lookupCompatTargetRevision(MARK, 2) = %d, %v; want 2, nil", rev, err)
+	}
+	for _, rev := range []uint32{0, 1, 3} {
+		if _, err := lookupCompatTargetRevision(TargetMARK, rev, stack.IP6); err == nil || err.GetError() != syserr.ErrProtocolNotSupported {
+			t.Errorf("lookupCompatTargetRevision(MARK, %d) = %v, want EPROTONOSUPPORT", rev, err)
+		}
+	}
+	if rev, err := lookupCompatMatchRevision(MatchMark, markMatchRevision, stack.Inet); err != nil || rev != markMatchRevision {
+		t.Errorf("lookupCompatMatchRevision(mark, 1) = %d, %v; want 1, nil", rev, err)
+	}
+	if _, err := lookupCompatMatchRevision(MatchMark, 0, stack.IP); err == nil || err.GetError() != syserr.ErrProtocolNotSupported {
+		t.Errorf("lookupCompatMatchRevision(mark, 0) = %v, want EPROTONOSUPPORT", err)
+	}
+	for _, size := range []int{0, 4, 7, 16} {
+		if _, err := parseMarkTarget(markTargetRevision, make([]byte, size)); err == nil || err.GetError() != syserr.ErrInvalidArgument {
+			t.Errorf("parseMarkTarget with %d bytes of info = %v, want EINVAL", size, err)
+		}
+	}
+	if _, err := parseMarkTarget(markTargetRevision, make([]byte, sizeOfXTMarkTgInfo2)); err != nil {
+		t.Errorf("parseMarkTarget with %d bytes of info: %v", sizeOfXTMarkTgInfo2, err)
+	}
+	// An xt_mark_mtinfo1 is 12 bytes; Linux takes it padded to 16.
+	for _, size := range []int{sizeOfXTMarkMtInfo1, 16} {
+		if _, err := parseMarkMatch(markMatchRevision, make([]byte, size)); err != nil {
+			t.Errorf("parseMarkMatch with %d bytes of info: %v", size, err)
+		}
+	}
+	for _, size := range []int{8, 11, 24} {
+		if _, err := parseMarkMatch(markMatchRevision, make([]byte, size)); err == nil || err.GetError() != syserr.ErrInvalidArgument {
+			t.Errorf("parseMarkMatch with %d bytes of info = %v, want EINVAL", size, err)
+		}
+	}
+}
