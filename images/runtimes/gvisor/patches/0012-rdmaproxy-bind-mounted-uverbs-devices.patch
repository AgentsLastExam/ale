@@ -15,10 +15,13 @@
 package specutils
 
 import (
+	"os"
 	"path"
 	"strings"
 
 	specs "github.com/opencontainers/runtime-spec/specs-go"
+	"golang.org/x/sys/unix"
+	"gvisor.dev/gvisor/pkg/log"
 	"gvisor.dev/gvisor/pkg/rdma"
 	"gvisor.dev/gvisor/runsc/config"
 )
@@ -61,3 +64,40 @@ func specHasUverbsDevice(spec *specs.Spec) bool {
 	}
 	return false
 }
+
+// uverbsMountsToDevices moves each mount of a host character device at a
+// /dev/infiniband/uverbs* destination from the spec's mounts to its devices,
+// the only RDMA devices rdmaproxy proxies. A runtime that cannot create device
+// nodes, such as rootless Podman, bind-mounts the host device for --device
+// instead of listing it. Each device takes the mount's destination as its path
+// and the host device's major and minor numbers, as a runtime that lists it
+// would, and gets mode 0666 and root as its owner, as runsc spec gives TPU
+// devices.
+func uverbsMountsToDevices(spec *specs.Spec) {
+	mounts := spec.Mounts[:0]
+	for _, m := range spec.Mounts {
+		var st unix.Stat_t
+		if !strings.HasPrefix(m.Destination, "/dev/infiniband/uverbs") ||
+			unix.Stat(m.Source, &st) != nil || st.Mode&unix.S_IFMT != unix.S_IFCHR {
+			mounts = append(mounts, m)
+			continue
+		}
+		if spec.Linux == nil {
+			spec.Linux = &specs.Linux{}
+		}
+		mode := os.FileMode(0666)
+		var uid, gid uint32
+		dev := specs.LinuxDevice{
+			Path:     m.Destination,
+			Type:     "c",
+			Major:    int64(unix.Major(uint64(st.Rdev))),
+			Minor:    int64(unix.Minor(uint64(st.Rdev))),
+			FileMode: &mode,
+			UID:      &uid,
+			GID:      &gid,
+		}
+		log.Infof("Listing RDMA device %q (%d:%d), bind-mounted from %q, as a device", dev.Path, dev.Major, dev.Minor, m.Source)
+		spec.Linux.Devices = append(spec.Linux.Devices, dev)
+	}
+	spec.Mounts = mounts
+}
diff --git a/runsc/specutils/rdma_test.go b/runsc/specutils/rdma_test.go
