+
+package specutils
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"reflect"
+	"testing"
+
+	specs "github.com/opencontainers/runtime-spec/specs-go"
+	"gvisor.dev/gvisor/runsc/config"
+)
+
+// uverbsDevice is the device that uverbsMountsToDevices lists for a mount of
+// /dev/null, character device 1:3, at path.
+func uverbsDevice(path string) specs.LinuxDevice {
+	mode := os.FileMode(0666)
+	var uid, gid uint32
+	return specs.LinuxDevice{Path: path, Type: "c", Major: 1, Minor: 3, FileMode: &mode, UID: &uid, GID: &gid}
+}
+
+func bindMount(src, dst string) specs.Mount {
+	return specs.Mount{Destination: dst, Source: src, Type: "bind", Options: []string{"bind", "nosuid", "noexec"}}
+}
+
+// TestUverbsMountsToDevices checks that only mounts of a character device at a
+// uverbs destination become devices, in order and after the spec's own.
+func TestUverbsMountsToDevices(t *testing.T) {
+	dir := t.TempDir()
+	file := filepath.Join(dir, "uverbs1")
+	if err := os.WriteFile(file, nil, 0666); err != nil {
+		t.Fatal(err)
+	}
+	gpu := specs.LinuxDevice{Path: "/dev/nvidia0", Type: "c", Major: 195, Minor: 0}
+	for _, tc := range []struct {
+		name        string
+		mounts      []specs.Mount
+		devices     []specs.LinuxDevice
+		wantMounts  []specs.Mount
+		wantDevices []specs.LinuxDevice
+	}{
+		{
+			name:        "char-devices",
+			mounts:      []specs.Mount{bindMount("/dev/null", "/dev/infiniband/uverbs0"), bindMount(dir, "/data"), bindMount("/dev/null", "/dev/infiniband/uverbs7")},
+			devices:     []specs.LinuxDevice{gpu},
+			wantMounts:  []specs.Mount{bindMount(dir, "/data")},
+			wantDevices: []specs.LinuxDevice{gpu, uverbsDevice("/dev/infiniband/uverbs0"), uverbsDevice("/dev/infiniband/uverbs7")},
+		},
+		{
+			name:        "other-destination",
+			mounts:      []specs.Mount{bindMount("/dev/null", "/dev/infiniband/rdma_cm"), bindMount("/dev/null", "/dev/null")},
+			wantMounts:  []specs.Mount{bindMount("/dev/null", "/dev/infiniband/rdma_cm"), bindMount("/dev/null", "/dev/null")},
+			wantDevices: nil,
+		},
+		{
+			name:        "not-a-char-device",
+			mounts:      []specs.Mount{bindMount(file, "/dev/infiniband/uverbs1"), bindMount(dir, "/dev/infiniband/uverbs2"), bindMount(filepath.Join(dir, "missing"), "/dev/infiniband/uverbs3")},
+			wantMounts:  []specs.Mount{bindMount(file, "/dev/infiniband/uverbs1"), bindMount(dir, "/dev/infiniband/uverbs2"), bindMount(filepath.Join(dir, "missing"), "/dev/infiniband/uverbs3")},
+			wantDevices: nil,
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			spec := &specs.Spec{Mounts: tc.mounts, Linux: &specs.Linux{Devices: tc.devices}}
+			uverbsMountsToDevices(spec)
+			if !reflect.DeepEqual(spec.Mounts, tc.wantMounts) {
+				t.Errorf("mounts got %+v, want %+v", spec.Mounts, tc.wantMounts)
+			}
+			if !reflect.DeepEqual(spec.Linux.Devices, tc.wantDevices) {
+				t.Errorf("devices got %+v, want %+v", spec.Linux.Devices, tc.wantDevices)
+			}
+		})
+	}
+}
+
+// TestReadSpecUverbsMounts checks that ReadSpec lists a bind-mounted uverbs
+// device as a device, so that RDMA is enabled, with --rdmaproxy only.
+func TestReadSpecUverbsMounts(t *testing.T) {
+	bundle := t.TempDir()
+	data, err := json.Marshal(&specs.Spec{
+		Version: "1.0.0",
+		Process: &specs.Process{Args: []string{"/bin/true"}},
+		Root:    &specs.Root{Path: "rootfs"},
+		Mounts:  []specs.Mount{bindMount("/dev/null", "/dev/infiniband/uverbs0")},
+		Linux:   &specs.Linux{},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(bundle, "config.json"), data, 0644); err != nil {
+		t.Fatal(err)
+	}
+	for _, rdmaProxy := range []bool{false, true} {
+		conf := &config.Config{RDMAProxy: rdmaProxy}
+		spec, err := ReadSpec(bundle, SpecOpts{Conf: conf})
+		if err != nil {
+			t.Fatalf("ReadSpec with --rdmaproxy=%t: %v", rdmaProxy, err)
+		}
+		wantMounts := []specs.Mount{bindMount("/dev/null", "/dev/infiniband/uverbs0")}
+		var wantDevices []specs.LinuxDevice
+		if rdmaProxy {
+			wantMounts = nil
+			wantDevices = []specs.LinuxDevice{uverbsDevice("/dev/infiniband/uverbs0")}
+		}
+		if len(spec.Mounts)+len(wantMounts) > 0 && !reflect.DeepEqual(spec.Mounts, wantMounts) || !reflect.DeepEqual(spec.Linux.Devices, wantDevices) {
+			t.Errorf("ReadSpec with --rdmaproxy=%t: mounts %+v and devices %+v, want %+v and %+v", rdmaProxy, spec.Mounts, spec.Linux.Devices, wantMounts, wantDevices)
+		}
+		if got := RDMAEnabled(spec, conf); got != rdmaProxy {
+			t.Errorf("RDMAEnabled() with --rdmaproxy=%t got %t", rdmaProxy, got)
+		}
+	}
+}
