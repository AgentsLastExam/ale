+// path, e.g. spec.Root.Path, mount.Source. With --rdmaproxy, it lists RDMA
+// devices that the spec bind-mounts as devices (uverbsMountsToDevices).
 func ReadSpec(bundleDir string, opts SpecOpts) (*specs.Spec, error) {
 	specFile, err := os.Open(filepath.Join(bundleDir, "config.json"))
 	if err != nil {
 		return nil, fmt.Errorf("error opening spec file %q: %v", filepath.Join(bundleDir, "config.json"), err)
 	}
 	defer specFile.Close()
-	return ReadSpecFromFile(bundleDir, specFile, opts)
+	spec, err := ReadSpecFromFile(bundleDir, specFile, opts)
+	if err != nil {
+		return nil, err
+	}
+	// Here, where runsc create, run and restore read the bundle's spec, and
+	// not in ReadSpecFromFile: the gofer, the sandbox and later commands get
+	// the spec read here, so they all see the devices in place of the mounts.
+	if opts.Conf.RDMAProxy {
+		uverbsMountsToDevices(spec)
+	}
+	return spec, nil
 }
 
