+// Preserve the input fields; only the driver's status is an output.
+func uvmIoctlInApplicationMM[Params any, PtrParams hasStatusPtr[Params]](ui *uvmIoctlState, as platform.HostMMIO, params PtrParams) (uintptr, error) {
