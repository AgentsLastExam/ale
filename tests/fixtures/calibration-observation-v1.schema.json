{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Orbit Calibration Observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "engine", "tasks"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "commit"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "minLength": 1}
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/task"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "rewards": {
      "type": ["object", "null"],
      "additionalProperties": {"type": "number"}
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "episode_id",
        "status",
        "rewards",
        "lock_path",
        "lock_digest",
        "result_path"
      ],
      "properties": {
        "episode_id": {"type": "string", "minLength": 1},
        "status": {
          "enum": [
            "completed",
            "agent_error",
            "env_error",
            "task_error",
            "timeout",
            "budget_exceeded",
            "memory_exhausted",
            "storage_exhausted",
            "cancelled",
            "refused"
          ]
        },
        "rewards": {"$ref": "#/$defs/rewards"},
        "lock_path": {"type": ["string", "null"], "minLength": 1},
        "lock_digest": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "result_path": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "lock_path": {"type": "string", "minLength": 1},
                "lock_digest": {"$ref": "#/$defs/sha256"}
              }
            },
            {
              "properties": {
                "lock_path": {"type": "null"},
                "lock_digest": {"type": "null"}
              }
            }
          ]
        },
        {
          "if": {
            "properties": {"status": {"const": "completed"}},
            "required": ["status"]
          },
          "then": {
            "properties": {
              "rewards": {"type": "object", "minProperties": 1},
              "lock_path": {"type": "string", "minLength": 1},
              "lock_digest": {"$ref": "#/$defs/sha256"}
            }
          },
          "else": {"properties": {"rewards": {"type": "null"}}}
        }
      ]
    },
    "notice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1}
      }
    },
    "expectation": {
      "oneOf": [
        {"type": "number"},
        {
          "type": "array",
          "prefixItems": [{"type": "number"}, {"type": "number"}],
          "minItems": 2,
          "maxItems": 2
        }
      ]
    },
    "expect": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/expectation"}
    },
    "observed": {
      "type": "object",
      "additionalProperties": {"type": ["number", "null"]}
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expect", "observed", "failures", "passed"],
      "properties": {
        "expect": {"$ref": "#/$defs/expect"},
        "observed": {"$ref": "#/$defs/observed"},
        "failures": {"type": "array", "items": {"$ref": "#/$defs/notice"}},
        "passed": {"type": "boolean"}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "expect", "attempt", "observed", "failures", "validation", "passed"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "expect": {"$ref": "#/$defs/expect"},
        "attempt": {"$ref": "#/$defs/attempt"},
        "observed": {"$ref": "#/$defs/observed"},
        "failures": {"type": "array", "items": {"$ref": "#/$defs/notice"}},
        "validation": {
          "oneOf": [
            {"$ref": "#/$defs/check"},
            {"type": "null"}
          ]
        },
        "passed": {"type": "boolean"}
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "spec_hash", "cases", "passed"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "spec_hash": {"$ref": "#/$defs/sha256"},
        "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}},
        "passed": {"type": "boolean"}
      }
    }
  }
}
