; Structural decoupling, enforced mechanically (Constitution II).
; Run with: uv run lint-imports

[importlinter]
root_packages =
    ale.core
    ale.fleet
    ale.run
    ale_verify
include_external_packages = True

[importlinter:contract:core-independent]
name = ale.core never depends on the orchestrator or the Fleet
type = forbidden
source_modules =
    ale.core
forbidden_modules =
    ale.fleet
    ale.run
    ale_verify

[importlinter:contract:verify-independent]
name = ale_verify is independent of engine packages
type = forbidden
source_modules =
    ale_verify
forbidden_modules =
    ale.core
    ale.fleet
    ale.run

[importlinter:contract:gateway-provider-decoupling]
name = the gateway knows nothing about providers (its only interface is a URL + token)
type = forbidden
source_modules =
    ale.run.gateway
forbidden_modules =
    ale.run.providers
    ale.run.protocol

[importlinter:contract:guestd-stdlib-only]
name = the guest service imports neither engine code nor third-party packages
type = forbidden
source_modules =
    ale.run.guestd
forbidden_modules =
    ale.core
    ale.run.gateway
    ale.run.providers
    aiohttp
    pydantic
    typer
    yaml

[importlinter:contract:firecracker-init-stdlib-only]
name = the microVM init runs in the guest and imports neither engine code nor third-party packages
type = forbidden
source_modules =
    ale.run.providers.firecracker_init
forbidden_modules =
    ale.core
    ale.run.gateway
    ale.run.guestd
    ale.run.providers.firecracker
    aiohttp
    pydantic
    typer
    yaml

[importlinter:contract:harness-provider-decoupling]
name = harnesses talk to sandboxes through the contract, not through a provider
type = forbidden
source_modules =
    ale.run.harnesses
forbidden_modules =
    ale.run.providers

[importlinter:contract:run-fleet-independent]
name = the engine reaches the Fleet only as a Provider and never imports ale.fleet
type = forbidden
source_modules =
    ale.run
forbidden_modules =
    ale.fleet

[importlinter:contract:fleet-control-plane-decoupling]
name = the Fleet control plane places data and never imports a Provider
type = forbidden
source_modules =
    ale.fleet.control
    ale.fleet.page
    ale.fleet.placement
    ale.fleet.server
    ale.fleet.status
    ale.fleet.store
forbidden_modules =
    ale.run.providers
