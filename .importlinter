; Structural decoupling, enforced mechanically (Constitution II).
; Run with: uv run lint-imports

[importlinter]
root_packages =
    orbit.core
    orbit.fleet
    orbit.run
    orbit_verify
include_external_packages = True

[importlinter:contract:core-independent]
name = orbit.core never depends on the orchestrator or the Fleet
type = forbidden
source_modules =
    orbit.core
forbidden_modules =
    orbit.fleet
    orbit.run
    orbit_verify

[importlinter:contract:verify-independent]
name = orbit_verify is independent of engine packages
type = forbidden
source_modules =
    orbit_verify
forbidden_modules =
    orbit.core
    orbit.fleet
    orbit.run

[importlinter:contract:gateway-provider-decoupling]
name = the gateway knows nothing about providers (its only interface is a URL + token)
type = forbidden
source_modules =
    orbit.run.gateway
forbidden_modules =
    orbit.run.providers
    orbit.run.protocol

[importlinter:contract:guestd-stdlib-only]
name = the guest service imports neither engine code nor third-party packages
type = forbidden
source_modules =
    orbit.run.guestd
forbidden_modules =
    orbit.core
    orbit.run.gateway
    orbit.run.providers
    aiohttp
    pydantic
    typer
    yaml

[importlinter:contract:firecracker-init-stdlib-only]
name = the microVM init runs in the guest and imports neither engine code nor third-party packages
type = forbidden
source_modules =
    orbit.run.providers.firecracker.guest_init
forbidden_modules =
    orbit.core
    orbit.run.gateway
    orbit.run.guestd
    orbit.run.providers.firecracker.provider
    aiohttp
    pydantic
    typer
    yaml

[importlinter:contract:in-sandbox-scripts-stdlib-only]
name = the container feature probe and the iptables writer run in the guest and import neither engine code nor third-party packages
type = forbidden
source_modules =
    orbit.run.capprobe
    orbit.run.iptables
forbidden_modules =
    orbit.core
    orbit.run.gateway
    orbit.run.guestd
    orbit.run.providers
    aiohttp
    pydantic
    typer
    yaml

[importlinter:contract:harness-provider-decoupling]
name = harnesses talk to sandboxes through the contract, not through a provider
type = forbidden
source_modules =
    orbit.run.harnesses
forbidden_modules =
    orbit.run.providers

[importlinter:contract:run-fleet-independent]
name = the engine reaches the Fleet only as a Provider and never imports orbit.fleet
type = forbidden
source_modules =
    orbit.run
forbidden_modules =
    orbit.fleet

[importlinter:contract:fleet-control-plane-decoupling]
name = the Fleet control plane places data and never imports a Provider
type = forbidden
source_modules =
    orbit.fleet.control
    orbit.fleet.page
    orbit.fleet.placement
    orbit.fleet.server
    orbit.fleet.status
    orbit.fleet.store
forbidden_modules =
    orbit.run.providers
